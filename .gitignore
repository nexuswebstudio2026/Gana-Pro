# Root-level .gitignore
# The actual Astro project lives in the teal-shell/ subdirectory.
# These patterns prevent stray build artifacts from being committed
# at the repository root if a command is accidentally run from here.

node_modules/
dist/
.astro/
.vercel/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
.env*
.DS_Store
.idea/
