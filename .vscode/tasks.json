{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Astro development server",
			"type": "shell",
			"command": "node_modules\\.bin\\astro.cmd",
			"args": [
				"dev",
				"--background"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Read local Astro logs",
			"type": "shell",
			"command": "node_modules\\.bin\\astro.cmd",
			"args": [
				"dev",
				"logs"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check local Astro response",
			"type": "shell",
			"command": "curl.exe",
			"args": [
				"-I",
				"http://localhost:4321/register"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}