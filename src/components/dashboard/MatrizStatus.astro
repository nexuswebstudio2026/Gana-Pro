---
/**
 * La matriz del miembro: nivel superior, usuario conectado y nivel inferior.
 *
 * Los tres niveles llegan ya calculados desde `matrix.ts`: este componente solo
 * dibuja, y las reglas (quién está arriba, qué puestos cuentan) viven en la
 * librería, donde se prueban.
 */
import { NODE_TONE, type MatrixPerson } from '../../lib/matrix';
import { levelName } from '../../lib/users';
import type { MatrixView } from '../../lib/matrix';

interface Props {
	/** Los tres niveles de la matriz, ya resueltos en el servidor. */
	view: MatrixView;
	/** `true` si no se pudo leer la hoja: se avisa en vez de mostrar ceros. */
	loadFailed?: boolean;
	leaderUsername?: string;
	selectedPath?: { id: string; name: string }[];
	viewerName?: string;
	matrixRecipients?: { username: string; label: string }[];
	matrixChoiceEnabled?: boolean;
	matrixRecipientLevel?: number;
}

const { view, loadFailed = false, leaderUsername = '', selectedPath = [], viewerName = 'usuario', matrixRecipients = [], matrixChoiceEnabled = false, matrixRecipientLevel = 2 } = Astro.props;

const { upline, self, downline, progress } = view;
const nextLevel = Math.min(5, progress.level + 1);

const initials = (person: MatrixPerson) =>
	(person.name ? person.name.charAt(0).toUpperCase() : '○');

/** "Nivel 2 · Plata": el número y el nombre de piedra del nivel declarado. */
const levelLabel = (person: MatrixPerson) => {
	if (!person.level) return 'Nivel sin definir';
	const name = levelName(person.level);
	return name ? `${person.level} · ${name}` : `Nivel ${person.level}`;
};
---

<section class="matrix luxury-card" aria-label="Estado de mi matriz">
	<header class="matrix-head">
		<div>
			<span class="matrix-eyebrow">Matriz 5x1</span>
			<h2 class="font-cinzel">Mi red de referidos</h2>
			<p class="matrix-lead">
				Cada puesto cuenta cuando su recarga inicial queda verificada.
			</p>
		</div>
		<div class="matrix-level">
			<span class="matrix-level-num">{progress.level}</span>
			<span class="matrix-level-cap">Nivel actual</span>
		</div>
	</header>
	{selectedPath.length > 0 && (
		<nav class="matrix-breadcrumb" aria-label="Ruta de la red">
			<a href="/dashboard/mi-red">Mi red de {viewerName}</a>
			{selectedPath.slice(1).map((person) => (
				<>
					<span aria-hidden="true">/</span>
					<a href={`/dashboard/mi-red?usuario=${encodeURIComponent(person.id)}`}>{person.name}</a>
				</>
			))}
		</nav>
	)}

	{loadFailed ? (
		<p class="matrix-alert" role="alert">
			No se pudo consultar la información de tu matriz en este momento.
		</p>
	) : (
		<>
			<div class="matrix-progress">
				<div
					class="matrix-bar"
					role="progressbar"
					aria-valuenow={progress.percent}
					aria-valuemin={0}
					aria-valuemax={100}
					aria-label="Progreso de ascenso"
				>
					<span class="matrix-bar-fill" style={`width:${progress.percent}%`}></span>
				</div>
				<div class="matrix-progress-text">
					<strong>{progress.active} de 5</strong> puestos activos
					<span class="matrix-dot" aria-hidden="true">·</span>
					<span>{progress.percent}% completado</span>
					{progress.complete ? (
						<span class="matrix-tag matrix-tag-done">¡Ascenso alcanzado!</span>
					) : (
						<span class="matrix-tag">
							Te faltan {progress.remaining} para el Nivel {nextLevel}
						</span>
					)}
				</div>
			</div>

			<div class="matrix-tree">
				<!-- Nivel superior: la persona que trajo al usuario. -->
				<div class="matrix-tier">
					<span class="matrix-tier-cap">Nivel superior</span>
					{matrixChoiceEnabled ? (
						<div class="matrix-person is-vacant">
							<span class="matrix-person-avatar" aria-hidden="true">◇</span>
							<div class="matrix-person-copy">
								<strong>Elige tu nivel superior</strong>
								<span>Selecciona a quién enviarás tu aporte de matriz.</span>
							</div>
						</div>
					) : upline ? (
						<div class="matrix-person">
							<span class="matrix-person-avatar" aria-hidden="true">
								{initials(upline)}
							</span>
							<div class="matrix-person-copy">
								<strong>{upline.name}</strong>
								<span>{levelLabel(upline)}</span>
								<span class="matrix-person-role">Te trajo a la plataforma</span>
								<a class="matrix-action" href={`/dashboard/billetera?destino=${encodeURIComponent(leaderUsername || upline.name || 'lider')}#enviar-dinero`}>Enviar dinero al líder</a>
							</div>
						</div>
					) : (
						<div class="matrix-person is-vacant">
							<span class="matrix-person-avatar" aria-hidden="true">◇</span>
							<div class="matrix-person-copy">
								<strong>Sin nivel superior</strong>
								<span>Eres la raíz de GANA PRO</span>
							</div>
						</div>
					)}
					{matrixChoiceEnabled && matrixRecipients.length > 0 && (
						<div class="matrix-choice">
							<strong>Elige a quién aportar</strong>
							<p>Selecciona un usuario de nivel {matrixRecipientLevel}. Al aprobarse el comprobante, quedarás en su línea inferior.</p>
							<label>
								<span class="sr-only">Usuario de nivel {matrixRecipientLevel}</span>
								<select data-matrix-leader aria-label={`Elige un usuario de nivel ${matrixRecipientLevel}`}>
									<option value="">Selecciona un usuario</option>
									{matrixRecipients.map((recipient) => <option value={recipient.username}>{recipient.label}</option>)}
								</select>
							</label>
							<button type="button" class="matrix-action" data-matrix-continue>Enviar aporte de $15.000</button>
						</div>
					)}
					{matrixChoiceEnabled && matrixRecipients.length === 0 && <p class="matrix-choice-empty">No hay puestos disponibles de nivel {matrixRecipientLevel} en este momento. Vuelve a consultar más tarde.</p>}
				</div>

				<span class="matrix-link" aria-hidden="true"></span>

				<!-- Nivel central: el usuario conectado. -->
				<div class="matrix-tier">
					<span class="matrix-tier-cap">Usuario conectado</span>
					<div class="matrix-person is-self">
						<span class="matrix-person-avatar" aria-hidden="true">
							{initials(self)}
						</span>
						<div class="matrix-person-copy">
							<strong>{self.name ?? 'Tú'}</strong>
							<span>{levelLabel(self)}</span>
							<span class="matrix-person-role">Tú · raíz de tu rama</span>
						</div>
					</div>
				</div>

				<span class="matrix-link" aria-hidden="true"></span>

				<!-- Nivel inferior: los cinco puestos del equipo directo. -->
				<div class="matrix-tier">
					<span class="matrix-tier-cap">Nivel inferior · tu equipo directo</span>
					<ol class="matrix-grid">
						{downline.map((node) => (
							<li class:list={['matrix-node', `is-${NODE_TONE[node.state]}`]}>
								<span class="matrix-node-pos">Puesto {node.position}</span>
								<span class="matrix-node-avatar" aria-hidden="true">
									{node.name ? node.name.charAt(0).toUpperCase() : '○'}
								</span>
								<strong class="matrix-node-name">{node.name ?? 'Libre'}</strong>
								<span class="matrix-node-state">{node.state}</span>
								{node.id && <a class="matrix-action matrix-open-branch" href={`/dashboard/mi-red?usuario=${encodeURIComponent(node.id)}`} aria-label={`Ver la red de ${node.name}`}>Ver sus 5 usuarios ↓</a>}
								{node.name && <button type="button" class="matrix-action matrix-request" data-member={node.name}>Solicitar dinero</button>}
								{node.name && node.topupStatus && node.topupStatus !== 'Aprobado' && (
									<span class="matrix-node-note">
										Recarga {node.topupStatus.toLowerCase()}
									</span>
								)}
							</li>
						))}
					</ol>
				</div>
			</div>

			<ul class="matrix-legend">
				<li><span class="legend-dot is-free" aria-hidden="true"></span>Libre</li>
<style>
	.matrix { padding: 28px; }

	.matrix-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 22px;
	}

	.matrix-eyebrow {
		display: block;
		margin-bottom: 6px;
		color: var(--gold-primary);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.matrix-head h2 { margin: 0 0 6px; font-size: 1.25rem; }
	.matrix-lead { margin: 0; color: var(--text-secondary); font-size: 13.5px; }

	.matrix-level {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-width: 74px;
		padding: 10px 14px;
		border: 1px solid var(--gold-border);
		border-radius: 14px;
		background: rgba(212, 175, 55, 0.08);
	}

	.matrix-level-num {
		font-family: 'Cinzel', serif;
		font-size: 1.8rem;
		font-weight: 800;
		line-height: 1;
		color: var(--gold-primary);
	}

	.matrix-level-cap {
		margin-top: 4px;
		font-size: 10.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.matrix-alert {
		margin: 0;
		padding: 16px;
		border: 1px solid rgba(239, 68, 68, 0.4);
		border-radius: 12px;
		background: rgba(239, 68, 68, 0.08);
		color: #fca5a5;
		font-size: 13.5px;
	}

	.matrix-progress { margin-bottom: 26px; }

	.matrix-bar {
		height: 10px;
		border-radius: 9999px;
		background: rgba(212, 175, 55, 0.12);
		overflow: hidden;
	}

	.matrix-bar-fill {
		display: block;
		height: 100%;
		border-radius: 9999px;
		background: linear-gradient(90deg, #d4af37, #f3e5ab);
		box-shadow: 0 0 14px rgba(212, 175, 55, 0.45);
		transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.matrix-progress-text {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
		font-size: 13px;
		color: var(--text-secondary);
	}

	.matrix-progress-text strong { color: var(--text-primary); }
	.matrix-dot { color: var(--gold-primary); }

	.matrix-tag {
		padding: 3px 10px;
		border: 1px solid var(--gold-border);
		border-radius: 9999px;
		background: rgba(212, 175, 55, 0.1);
		color: var(--gold-primary);
		font-size: 11.5px;
		font-weight: 600;
	}

	.matrix-tag-done {
		border-color: rgba(16, 185, 129, 0.45);
		background: rgba(16, 185, 129, 0.12);
		color: #10b981;
	}

	/* Los tres niveles de la matriz: superior, conectado e inferior */
	.matrix-tree {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 18px;
	}

	.matrix-tier {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
	}

	.matrix-tier-cap {
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gold-primary);
	}

	/* Tarjeta de una persona: la del nivel superior y la del usuario conectado */
	.matrix-person {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 18px;
		border: 1px solid var(--gold-border);
		border-radius: 16px;
		background: var(--bg-primary);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
	}

	.matrix-person.is-self {
		min-width: 240px;
		justify-content: center;
		border-color: var(--gold-primary);
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), var(--bg-primary));
	}

	.matrix-person.is-vacant {
		border-style: dashed;
		background: transparent;
		opacity: 0.75;
	}

	.matrix-person-avatar {
		width: 40px;
		height: 40px;
		flex: 0 0 40px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: rgba(212, 175, 55, 0.18);
		color: var(--gold-primary);
		font-size: 15px;
		font-weight: 700;
	}

	.matrix-person.is-self .matrix-person-avatar {
		background: var(--gold-primary);
		color: #101827;
	}

	.matrix-person-copy {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.matrix-person-copy strong {
		color: var(--text-primary);
		font-size: 13.5px;
		overflow-wrap: anywhere;
	}

	.matrix-person-copy span { color: var(--text-secondary); font-size: 11.5px; overflow-wrap: anywhere; }

	.matrix-person-role { color: var(--gold-primary) !important; font-weight: 600; }
	.matrix-action { display:inline-flex; align-items:center; justify-content:center; margin-top:6px; padding:6px 10px; border:1px solid var(--gold-border); border-radius:999px; background:rgba(212,175,55,.1); color:var(--gold-primary); font-size:10.5px; font-weight:700; text-decoration:none; cursor:pointer; font-family:inherit; }
	.matrix-action:hover { background:rgba(212,175,55,.22); }
	.matrix-breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:9px; margin:-8px 0 22px; color:var(--text-secondary); font-size:12px; }
	.matrix-breadcrumb a { color:var(--gold-primary); text-decoration:none; }
	.matrix-breadcrumb a:hover { text-decoration:underline; }
	.matrix-choice { width:min(100%, 460px); padding:16px; border:1px solid var(--gold-border); border-radius:14px; background:rgba(212,175,55,.06); }
	.matrix-choice strong { color:var(--text-primary); font-size:13px; }
	.matrix-choice p { margin:6px 0 10px; color:var(--text-secondary); font-size:12px; line-height:1.5; }
	.matrix-choice label { display:block; }
	.matrix-choice select { width:100%; min-height:42px; padding:9px 11px; border:1px solid var(--gold-border); border-radius:9px; background:var(--bg-primary); color:var(--text-primary); font:inherit; }
	.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
	.matrix-open-branch { margin-top:8px; }

	/* Conector vertical entre niveles */
	.matrix-link {
		width: 2px;
		height: 22px;
		background: var(--gold-border);
	}

	.matrix-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		width: 100%;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 14px;
	}

	.matrix-node {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		padding: 18px 12px;
		border: 1px solid var(--gold-border);
		border-radius: 16px;
		text-align: center;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.matrix-node:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
	}

	.matrix-node.is-free {
		border-style: dashed;
		background: transparent;
	}

	.matrix-node.is-pending {
		border-color: rgba(234, 179, 8, 0.45);
		background: rgba(234, 179, 8, 0.07);
	}

	.matrix-node.is-active {
		border-color: rgba(16, 185, 129, 0.45);
		background: rgba(16, 185, 129, 0.08);
	}

	.matrix-node-pos {
		font-size: 10.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.matrix-node-avatar {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-weight: 700;
		font-size: 15px;
		background: linear-gradient(135deg, #d4af37, #996515);
		color: #fff;
	}

	.matrix-node.is-free .matrix-node-avatar {
		background: transparent;
		border: 1px dashed var(--gold-border);
		color: var(--gold-primary);
	}

	.matrix-node.is-pending .matrix-node-avatar {
		background: linear-gradient(135deg, #eab308, #a16207);
	}

	.matrix-node.is-active .matrix-node-avatar {
		background: linear-gradient(135deg, #10b981, #047857);
	}

	.matrix-node-name {
		font-size: 13.5px;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.matrix-node.is-free .matrix-node-name { color: var(--text-secondary); }

	.matrix-node-state {
		font-size: 11.5px;
		line-height: 1.35;
		color: var(--text-secondary);
	}

	.matrix-node.is-active .matrix-node-state { color: #10b981; font-weight: 600; }
	.matrix-node.is-pending .matrix-node-state { color: #eab308; font-weight: 600; }

	.matrix-node-note { font-size: 10.5px; color: var(--text-secondary); opacity: 0.8; }

	.matrix-legend {
		list-style: none;
		margin: 0;
		padding: 14px 0 0;
		border-top: 1px solid var(--gold-border);
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		font-size: 12px;
		color: var(--text-secondary);
	}

	.matrix-legend li { display: flex; align-items: center; gap: 7px; }

	.legend-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1px solid var(--gold-border);
	}

	.legend-dot.is-free { border-style: dashed; }
	.legend-dot.is-pending { background: #eab308; border-color: #eab308; }
	.legend-dot.is-active { background: #10b981; border-color: #10b981; }

	@media (max-width: 520px) {
		.matrix { padding: 20px 16px; }
		.matrix-head { flex-direction: column; gap: 14px; }
		.matrix-grid { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; }
		.matrix-node { padding: 14px 8px; }
		.matrix-progress-text { font-size: 12px; }
		.matrix-person { width: 100%; padding: 12px; }
		.matrix-person.is-self { min-width: 0; }
	}
</style>

				<li>
					<span class="legend-dot is-pending" aria-hidden="true"></span>
					Registrado (Sin Recarga)
				</li>
				<li>
					<span class="legend-dot is-active" aria-hidden="true"></span>
					Activo (Recarga Verificada)
				</li>
			</ul>
		</>
	)}
</section>

<script>
	document.querySelector<HTMLButtonElement>('[data-matrix-continue]')?.addEventListener('click', () => {
		const select = document.querySelector<HTMLSelectElement>('[data-matrix-leader]');
		const target = select?.value;
		if (!target) { select?.focus(); return; }
		window.location.href = `/dashboard/billetera?aporteMatriz=${encodeURIComponent(target)}#comprobantes`;
	});

	document.querySelectorAll<HTMLButtonElement>('.matrix-request').forEach((button) => {
		button.addEventListener('click', () => {
			const member = button.dataset.member || 'tu usuario';
			const raw = window.prompt(`¿Cuánto dinero deseas solicitarle a ${member}?`);
			if (raw === null) return;
			const amount = Number(raw.replace(/\./g, '').replace(',', '.'));
			if (!(amount > 0)) { window.alert('Ingresa un monto válido.'); return; }
			button.disabled = true;
			fetch('/api/member-money-requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'request', to: member, amount }) })
				.then(async (response) => { const data = await response.json() as { ok: boolean; message: string }; window.alert(data.message); })
				.catch(() => window.alert('No se pudo enviar la solicitud. Inténtalo de nuevo.'))
				.finally(() => { button.disabled = false; });
		});
	});
</script>
