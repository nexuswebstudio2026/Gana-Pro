<dialog class="location-consent" aria-labelledby="location-consent-title" aria-describedby="location-consent-copy">
	<div class="location-consent-card">
		<span class="location-consent-icon" aria-hidden="true">⌖</span>
		<h2 id="location-consent-title">Comparte tu ubicación</h2>
		<p id="location-consent-copy">Al entrar al panel, puedes registrar tu ubicación actual en la hoja «Ubicacion» de Google Sheets. El navegador te pedirá permiso.</p>
		<p class="location-consent-status" aria-live="polite"></p>
		<div class="location-consent-actions">
			<button type="button" class="location-consent-skip">Ahora no</button>
			<button type="button" class="location-consent-share">Compartir ubicación</button>
		</div>
	</div>
</dialog>

<style>
	.location-consent{width:min(440px,calc(100% - 32px));padding:0;border:1px solid var(--gold-border);border-radius:20px;background:#111827;color:var(--text-primary);box-shadow:0 24px 80px #0009}
	.location-consent::backdrop{background:#020712bb;backdrop-filter:blur(4px)}
	.location-consent-card{padding:28px}
	.location-consent-icon{display:grid;place-items:center;width:46px;height:46px;border:1px solid var(--gold-border);border-radius:14px;background:#d4af3718;color:var(--gold-primary);font-size:27px}
	.location-consent h2{margin:18px 0 8px;font-family:'Cinzel',serif;font-size:1.25rem}
	.location-consent p{margin:0;color:var(--text-secondary);font-size:13.5px;line-height:1.6}
	.location-consent .location-consent-status{min-height:20px;margin-top:12px;color:#fca5a5;font-size:12px}
	.location-consent-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}
	.location-consent-actions button{min-height:40px;padding:9px 14px;border:1px solid var(--gold-border);border-radius:10px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
	.location-consent-skip{background:transparent;color:var(--text-secondary)}
	.location-consent-share{background:var(--gold-primary);color:#111827}
	.location-consent-actions button:disabled{opacity:.6;cursor:wait}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('.location-consent');
	const share = dialog?.querySelector<HTMLButtonElement>('.location-consent-share');
	const skip = dialog?.querySelector<HTMLButtonElement>('.location-consent-skip');
	const status = dialog?.querySelector<HTMLElement>('.location-consent-status');
	const close = () => {
		dialog?.close();
		const url = new URL(window.location.href);
		url.searchParams.delete('solicitarUbicacion');
		window.history.replaceState({}, '', url);
	};
	dialog?.showModal();
	skip?.addEventListener('click', close);
	share?.addEventListener('click', () => {
		if (!navigator.geolocation) {
			if (status) status.textContent = 'Este navegador no permite obtener la ubicación.';
			return;
		}
		share.disabled = true;
		share.textContent = 'Obteniendo ubicación…';
		navigator.geolocation.getCurrentPosition(async (position) => {
			try {
				const response = await fetch('/api/location', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						lat: position.coords.latitude,
						lng: position.coords.longitude,
						accuracy: position.coords.accuracy,
						source: 'login',
					}),
				});
				if (!response.ok) throw new Error('No se pudo guardar la ubicación en Google Sheets.');
				close();
			} catch (error) {
				if (status) status.textContent = error instanceof Error ? error.message : 'No se pudo guardar la ubicación.';
				share.disabled = false;
				share.textContent = 'Intentar de nuevo';
			}
		}, (error) => {
			const messages: Record<number, string> = {
				1: 'No se concedió el permiso. Puedes habilitarlo en la configuración del navegador.',
				2: 'El dispositivo no pudo determinar tu ubicación. Inténtalo de nuevo.',
				3: 'La solicitud tardó demasiado. Inténtalo de nuevo.',
			};
			if (status) status.textContent = messages[error.code] || 'No se pudo obtener la ubicación.';
			share.disabled = false;
			share.textContent = 'Intentar de nuevo';
		}, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
	});
</script>
