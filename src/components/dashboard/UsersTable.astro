---
import { DOCUMENT_STATUS } from '../../lib/testimonials';
import {
	PROFILE_FIELDS,
	PROFILE_FIELD_LABELS,
	PROFILE_FIELD_LIMITS,
	displayValue,
	filledProfileCount,
	isProfileEmpty,
	whatsappLink,
} from '../../lib/account-profile';
import type { UserRowView } from '../../lib/dashboard-sections';

interface Props {
	users: UserRowView[];
	review: string;
	reviewMessage: string;
	loadFailed: boolean;
	/** Mensaje del CRUD de datos de contacto. */
	contact: string;
	contactMessage: string;
}

const { users, review, reviewMessage, loadFailed, contact, contactMessage } = Astro.props;

/** Vista de contacto de un usuario, lista para pintar. */
function contactView(user: UserRowView['user']) {
	const profile = {
		address: String(user.address ?? '').trim(),
		neighborhood: String(user.neighborhood ?? '').trim(),
		city: String(user.city ?? '').trim(),
		phone: String(user.phone ?? '').trim(),
		whatsapp: String(user.whatsapp ?? '').trim(),
	};
	return {
		profile,
		empty: isProfileEmpty(profile),
		filled: filledProfileCount(profile),
		waUrl: whatsappLink(profile.whatsapp),
	};
}
---

<section class="org-panel luxury-card" aria-label="Usuarios registrados">
	<div class="org-panel-heading">
		<div>
			<h2>Directorio de usuarios</h2>
			<p>Consulta las cuentas registradas en la plataforma.</p>
		</div>
		<span class="org-total">{users.length} usuarios registrados</span>
	</div>

	{review === 'ok' && <p class="doc-alert ok" role="status">{reviewMessage || 'Documento actualizado.'}</p>}
	{review === 'error' && (
		<p class="doc-alert ko" role="alert">{reviewMessage || 'No se pudo actualizar el documento.'}</p>
	)}
	{contact === 'ok' && (
		<p class="doc-alert ok" role="status">{contactMessage || 'Datos de contacto actualizados.'}</p>
	)}
	{contact === 'error' && (
		<p class="doc-alert ko" role="alert">
			{contactMessage || 'No se pudo completar la operación de contacto.'}
		</p>
	)}

	{loadFailed ? (
		<p class="org-empty" role="alert">
			No se pudo cargar la lista de usuarios desde la hoja de cálculo.
		</p>
	) : users.length === 0 ? (
		<p class="org-empty">Aún no hay usuarios registrados.</p>
	) : (
		<div class="users-table-wrap">
			<table class="users-table">
				<thead>
					<tr>
						<th scope="col">Usuario</th>
						<th scope="col">Correo</th>
						<th scope="col">Contacto y residencia</th>
						<th scope="col">Documento de Identidad</th>
						<th scope="col">Estado / Acciones</th>
					</tr>
				</thead>
				<tbody>
					{users.map(({ user: u, nit, documentPdf, approvedDocumentLink, hasDocument, isApproved }) => {
						const contact = contactView(u);
						return (
							<tr>
								<td><strong>{u.username}</strong></td>
								<td>{u.email}</td>
								<td>
									<div class="contact-cell">
										{contact.empty ? (
											<span class="muted">Sin registrar</span>
										) : (
											<>
												<span class="doc-line">
													<span class="doc-kind">Dirección</span>
													<span class="muted">{contact.profile.address}</span>
												</span>
												<span class="doc-line">
													<span class="doc-kind">Barrio / Ciudad</span>
													<span class="muted">
														{displayValue(contact.profile.neighborhood) || '—'} ·{' '}
														{displayValue(contact.profile.city) || '—'}
													</span>
												</span>
												<span class="doc-line">
													<span class="doc-kind">Teléfono</span>
													<span class="muted">{displayValue(contact.profile.phone) || '—'}</span>
												</span>
												<span class="doc-line">
													<span class="doc-kind">WhatsApp</span>
													{contact.waUrl ? (
														<a
															class="doc-link"
															href={contact.waUrl}
															target="_blank"
															rel="noopener noreferrer"
														>
															{contact.profile.whatsapp}
														</a>
													) : (
														<span class="muted">—</span>
													)}
												</span>
											</>
										)}

										{/* CREATE / UPDATE: alta o edición de los datos de contacto */}
										<form method="POST" action="/api/admin/account" class="doc-admin-form">
											<input type="hidden" name="username" value={u.username} />
											<input type="hidden" name="action" value="save" />
											<span class="doc-admin-title">
												{contact.empty ? 'Registrar contacto' : 'Editar contacto'}
											</span>
											{PROFILE_FIELDS.map((field) => (
												<input
													type={field === 'phone' || field === 'whatsapp' ? 'tel' : 'text'}
													name={field}
													value={contact.profile[field]}
													maxlength={PROFILE_FIELD_LIMITS[field]}
													placeholder={PROFILE_FIELD_LABELS[field]}
													aria-label={`${PROFILE_FIELD_LABELS[field]} de ${u.username}`}
												/>
											))}
											<button type="submit" class="btn-save">
												{contact.empty ? 'Registrar' : 'Guardar'}
											</button>
										</form>

										{/* DELETE: solo si hay algo que borrar */}
										{!contact.empty && (
											<form
												method="POST"
												action="/api/admin/account"
												class="contact-delete-form"
												data-confirm={`¿Eliminar los datos de contacto de ${u.username}? Esta acción no se puede deshacer.`}
											>
												<input type="hidden" name="username" value={u.username} />
												<input type="hidden" name="action" value="delete" />
												<button type="submit" class="btn-delete-contact">Eliminar contacto</button>
											</form>
										)}
									</div>
								</td>
								<td>
								<div class="doc-cell">
									<span class="doc-line">
										<span class="doc-kind">NIT</span>
										{nit ? (
											<code class="doc-ref">{nit}</code>
										) : (
											<span class="muted">Sin registrar</span>
										)}
									</span>
									<span class="doc-line">
										<span class="doc-kind">RUT emitido por la DIAN</span>
										{approvedDocumentLink ? (
											<a
												href={approvedDocumentLink}
												target="_blank"
												rel="noopener noreferrer"
												class="doc-link rut-link"
											>
												{documentPdf ? 'Ver documento aprobado (PDF)' : 'Ver documento aprobado'}
											</a>
										) : (
											<span class="muted">
												{hasDocument ? 'Documento pendiente de aprobación' : 'Sin subir'}
											</span>
										)}
									</span>
								</div>
							</td>
							<td class="actions">
								{isApproved ? (
									<span class="status-pill ok" aria-label={`Estado del documento de ${u.username}`}>
										Aprobado
									</span>
								) : (
									<>
										<span class="status-pill wait" aria-label={`Estado del documento de ${u.username}`}>
											No aprobado
										</span>
										{hasDocument && (
											<>
												<form method="POST" action="/api/admin/documents">
													<input type="hidden" name="username" value={u.username} />
													<input type="hidden" name="status" value={DOCUMENT_STATUS.aprobado} />
													<button type="submit" class="btn-approve">Aprobar</button>
												</form>
												<form method="POST" action="/api/admin/documents">
													<input type="hidden" name="username" value={u.username} />
													<input type="hidden" name="status" value={DOCUMENT_STATUS.rechazado} />
													<button type="submit" class="btn-reject">Rechazar</button>
												</form>
											</>
										)}
										<form
											method="POST"
											action="/api/admin/documents"
											enctype="multipart/form-data"
											class="doc-admin-form"
										>
											<input type="hidden" name="username" value={u.username} />
											<span class="doc-admin-title">Documento de Identidad</span>
											<input
												type="text"
												name="nit"
												class="nit-input"
												placeholder="NIT (solo números, 6 a 20 dígitos)"
												value={nit}
												pattern="[0-9]{6,20}"
												title="Solo números, entre 6 y 20 dígitos"
											/>
											<input
												type="file"
												name="rut"
												class="rut-input"
												accept="image/jpeg,image/png,image/webp,application/pdf"
											/>
											<button type="submit" class="btn-save">Guardar documento</button>
											<p class="doc-hint">JPG, PNG, WEBP o PDF de hasta 5 MB.</p>
										</form>
									</>
								)}
							</td>
						</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	)}
</section>

<script>
	// Confirmación antes de borrar los datos de contacto de un usuario.
	document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
		form.addEventListener('submit', (event) => {
			if (!window.confirm(form.dataset.confirm || '¿Confirmas la operación?')) {
				event.preventDefault();
			}
		});
	});
</script>

<style>
	.org-panel { padding: 28px; }
	.org-panel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
	.org-panel-heading h2 { margin: 0 0 8px; font-size: 1.25rem; }
	.org-panel-heading p { margin: 0; color: var(--text-secondary); font-size: 14px; line-height: 1.6; }
	.org-total { flex: none; padding: 8px 12px; border: 1px solid var(--gold-border); border-radius: 9999px; background: rgba(212, 175, 55, 0.1); color: var(--gold-primary); font-size: 12px; font-weight: 700; }
	/* CRUD de datos de contacto */
	.contact-cell { display: flex; flex-direction: column; gap: 8px; min-width: 230px; }
	.contact-cell .doc-admin-form input { margin-top: 0; }
	.contact-delete-form { margin: 0; }
	.btn-delete-contact { padding: 7px 12px; border: 1px solid rgba(239, 68, 68, 0.45); border-radius: 8px; background: rgba(239, 68, 68, 0.1); color: #f87171; font-size: 12px; font-weight: 700; cursor: pointer; }
	.btn-delete-contact:hover { background: rgba(239, 68, 68, 0.2); border-color: #ef4444; }
	@media (max-width: 768px) {
		.org-panel { padding: 20px 14px; }
		.org-panel-heading { flex-direction: column; }
		.org-total { align-self: flex-start; }
	}
</style>
