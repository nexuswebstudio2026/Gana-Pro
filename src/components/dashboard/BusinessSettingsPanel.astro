---
import type { BusinessSettings } from '../../lib/business-settings';

interface Props {
	settings: BusinessSettings | null;
	result: string;
	message: string;
	loadFailed: boolean;
}

const { settings, result, message, loadFailed } = Astro.props;
---

<section
	class="org-panel luxury-card business-settings"
	id="rut-empresarial"
	aria-labelledby="business-rut-title"
>
	<div class="org-panel-heading">
		<div>
			<h2 id="business-rut-title">Configurar y subir RUT empresarial</h2>
			<p>Guarda el NIT y el RUT oficial de Gana Pro para la configuración del negocio.</p>
		</div>
	</div>

	{result === 'ok' && (
		<p class="doc-alert ok" role="status">
			{message || 'NIT y RUT empresarial guardados correctamente.'}
		</p>
	)}
	{result === 'error' && (
		<p class="doc-alert ko" role="alert">
			{message || 'No se pudo guardar la configuración.'}
		</p>
	)}

	{loadFailed ? (
		<p class="org-empty" role="alert">
			No se pudo cargar la configuración del negocio. Verifica el acceso a Google Sheets.
		</p>
	) : (
		<>
			{settings?.rutLink ? (
				<div class="business-current doc-cell" aria-label="RUT empresarial guardado">
					<span class="doc-line">
						<span class="doc-kind">NIT empresarial</span>
						<strong>{settings.nit}</strong>
					</span>
					<span class="doc-line">
						<span class="doc-kind">RUT empresarial</span>
						<a
							href={settings.rutLink}
							target="_blank"
							rel="noopener noreferrer"
							class="doc-link rut-link"
						>
							Ver RUT empresarial · {settings.rutFileName}
						</a>
					</span>
					{settings.updatedAt && (
						<small class="muted">Última actualización: {settings.updatedAt}</small>
					)}
				</div>
			) : (
				<p class="business-empty muted">Todavía no se ha configurado el RUT del negocio.</p>
			)}
			<form
				method="POST"
				action="/api/admin/business-config"
				enctype="multipart/form-data"
				class="doc-admin-form business-form"
			>
				<label for="business-nit" class="doc-admin-title">NIT del negocio</label>
				<input
					type="text"
					id="business-nit"
					name="nit"
					value={settings?.nit || ''}
					placeholder="NIT (solo números, 6 a 20 dígitos)"
					pattern="[0-9]{6,20}"
					title="Solo números, entre 6 y 20 dígitos"
					class="nit-input"
				/>
				<label for="business-rut" class="doc-admin-title">RUT empresarial (DIAN)</label>
				<input
					type="file"
					id="business-rut"
					name="rut"
					accept="image/jpeg,image/png,image/webp,application/pdf"
					class="rut-input"
					required={!settings?.rutLink}
				/>
				<button type="submit" class="btn-save">
					{settings?.rutLink ? 'Actualizar NIT y RUT' : 'Guardar NIT y RUT'}
				</button>
			</form>
		</>
	)}
</section>

<style>
	.org-panel { padding: 28px; }
	.org-panel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
	.org-panel-heading h2 { margin: 0 0 8px; font-size: 1.25rem; }
	.org-panel-heading p { margin: 0; color: var(--text-secondary); font-size: 14px; line-height: 1.6; }
	.business-settings { display: flex; flex-direction: column; gap: 18px; }
	.business-settings .org-panel-heading { margin-bottom: 0; }
	.business-current { padding: 14px; border: 1px solid var(--gold-border); border-radius: 10px; background: rgba(212, 175, 55, 0.05); }
	.business-current strong { color: var(--text-primary); font-size: 13px; }
	.business-empty { margin: 0; }
	.business-form { max-width: 560px; }
	@media (max-width: 768px) {
		.org-panel { padding: 20px 14px; }
		.org-panel-heading { flex-direction: column; }
	}
</style>
