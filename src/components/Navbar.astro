---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import BalanceChip from './BalanceChip.astro';
import MobileBottomBar from './MobileBottomBar.astro';
import { validateSession } from '../lib/session';
import { getUserBalance, getSheetUserLevel, getUserWallet, getAdminWallet } from '../lib/users';

interface Props {
	title?: string;
}

// Se valida la sesión (no solo la cookie) para mostrar el nombre del usuario
// y evitar mostrar el portal con un token caducado o manipulado.
const token = Astro.cookies.get('auth_session')?.value;
const session = validateSession(token);
const username = session?.username?.trim() ?? '';
const initial = username ? username.charAt(0).toUpperCase() : '';

// Saldo acumulado leído de Google Sheets. Solo se devuelve si el usuario
// conectado aparece en la hoja: si no está registrado allí, no se inventa
// ninguna cifra. Un fallo de Sheets tampoco rompe la navegación.
let balance: string | null = null;
let userLevel: string | null = null;
let walletType: string | null = null;
let walletNumber: string | null = null;
let adminWalletType: string | null = null;
let adminWalletNumber: string | null = null;
if (username) {
	try {
		balance = await getUserBalance(session!.username, session!.email);
		userLevel = await getSheetUserLevel(session!.username, session!.email);
		const wallet = await getUserWallet(session!.username, session!.email);
		if (wallet) { walletType = wallet.walletType || null; walletNumber = wallet.walletNumber || null; }
		// Billetera del admin: es a la que se transfiere para recargar.
		const adminWallet = await getAdminWallet();
		if (adminWallet) { adminWalletType = adminWallet.walletType || null; adminWalletNumber = adminWallet.walletNumber || null; }
	} catch (e) {
		console.error('No se pudo mostrar el saldo en la barra:', e);
	}
}

// Enlaces del menú. "Valoración" lleva a la sección de testimonios y
// valoraciones de la portada, de ahí el ancla al final de la ruta.
const navLinks = [
	{ href: '/', label: 'Gana Dinero', icon: 'money' as const },
	{ href: '/valoraciones', label: 'Valoración', icon: 'rating' as const },
	{ href: '/sobre-nosotros', label: 'Sobre Nosotros', icon: 'about' as const },
];

// Marca como actual el enlace cuya página (o ancla) se está viendo. Antes el
// atributo iba fijo en "Inicio", así que el resaltado dorado ya no correspondía
// con la sección abierta.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
	const [path, hash] = href.split('#');
	const target = path.replace(/\/+$/, '') || '/';
	if (currentPath !== target) return false;
	return !hash || Astro.url.hash === `#${hash}`;
};
---

<header class="navbar">
	<div class="nav-container">
		<a href="/" class="brand">
			<div class="logo-shield">
				<Logo size={28} />
			</div>
			<div class="brand-text">
				<span class="brand-title font-cinzel">GANA <span class="gold-gradient-text">PRO</span></span>
				<span class="brand-tag">INGRESOS ESTRUCTURADOS</span>
			</div>
		</a>

		<nav class="nav-links" id="primary-nav" aria-label="Navegación principal">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class="nav-link"
					aria-current={isCurrent(link.href) ? 'page' : undefined}
				>
					{link.label}
				</a>
			))}
		</nav>

		<div class="nav-actions">
			<ThemeToggle />
			<BalanceChip balance={balance} level={userLevel} walletType={walletType} walletNumber={walletNumber} adminWalletType={adminWalletType} adminWalletNumber={adminWalletNumber} />
			{username ? (
				<a
					href="/dashboard"
					class="gold-button btn-sm user-button"
					title={`Mi Portal — ${username}`}
					aria-label={`Mi Portal — ${username}`}
				>
					<span class="user-avatar" aria-hidden="true">{initial}</span>
					<span class="user-name">{username}</span>
				</a>
			) : (
				<a href="/login" class="gold-button btn-sm">Acceso</a>
			)}
		</div>

	</div>
</header>
<div class="navbar-spacer" aria-hidden="true"></div>
<MobileBottomBar links={navLinks} />

<style>
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		width: 100%;
		min-height: 76px;
		background: var(--bg-header);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--gold-border);
		box-shadow: var(--header-shadow);
		transition: all 0.3s ease;
	}

	.nav-container {
		width: 100%;
		min-height: 76px;
		margin: 0;
		padding: 16px clamp(16px, 2vw, 36px);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.navbar-spacer {
		flex: 0 0 76px;
		height: 76px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 14px;
		text-decoration: none;
	}

	.logo-shield {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.2) 0%, rgba(10, 25, 49, 0.6) 100%);
		border: 1px solid var(--gold-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gold-primary);
		box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.brand:hover .logo-shield {
		transform: scale(1.05) rotate(4deg);
		box-shadow: 0 0 25px rgba(212, 175, 55, 0.5);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
	}

	.brand-title {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: var(--text-primary);
		line-height: 1.1;
	}

	.brand-tag {
		font-size: 0.65rem;
		letter-spacing: 0.25em;
		color: var(--gold-primary);
		font-weight: 700;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.nav-link {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		position: relative;
		transition: color 0.25s ease;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		bottom: -6px;
		left: 0;
		width: 0%;
		height: 2px;
		background: var(--gold-primary);
		transition: width 0.3s ease;
	}

	.nav-link:hover {
		color: var(--gold-primary);
	}

	.nav-link:hover::after {
		width: 100%;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.btn-sm {
		padding: 10px 22px;
		font-size: 0.85rem;
	}

	/* ============ BOTÓN CON EL NOMBRE DEL USUARIO ============ */
	.user-button {
		/* El nombre se muestra tal cual se registró, sin MAYÚSCULAS forçadas */
		text-transform: none;
		letter-spacing: 0.02em;
		gap: 8px;
		max-width: 230px;
	}

	.user-avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 26px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: rgba(3, 7, 18, 0.22);
		border: 1px solid rgba(255, 235, 150, 0.6);
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0;
	}

	/* Los nombres largos se recortan en lugar de romper el navbar */
	.user-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
	}

	/* ============ TABLET Y MÓVIL ============ */
	@media (max-width: 900px) {
		.navbar,
		.nav-container {
			min-height: 68px;
		}

		.nav-container {
			padding: 12px 18px;
			gap: 12px;
		}

		.nav-links { display: none; }

		.navbar-spacer {
			flex-basis: 68px;
			height: 68px;
		}

		.nav-actions {
			margin-left: auto;
			gap: 12px;
		}

	}

	/* ============ MÓVILES PEQUEÑOS ============ */
	@media (max-width: 480px) {
		.navbar,
		.nav-container {
			min-height: 58px;
		}

		.nav-container {
			padding: 10px 14px;
			gap: 8px;
		}

		.navbar-spacer {
			flex-basis: 58px;
			height: 58px;
		}

		/* La marca compite por espacio con los botones: reducir */
		.logo-shield {
			width: 38px;
			height: 38px;
			border-radius: 10px;
		}

		.brand {
			gap: 10px;
		}

		.brand-title {
			font-size: 1.05rem;
			letter-spacing: 0.08em;
		}

		.brand-tag {
			display: none;
		}

		.nav-actions {
			gap: 8px;
		}

		.user-button {
			max-width: 160px;
			gap: 6px;
		}

		.user-avatar {
			flex-basis: 22px;
			width: 22px;
			height: 22px;
			font-size: 0.7rem;
		}

		.nav-actions :global(.theme-toggle-btn) {
			width: 40px;
			height: 40px;
		}

		.btn-sm {
			padding: 9px 16px;
			font-size: 0.78rem;
		}

	}

	/* ============ PANTALLAS MUY PEQUEÑAS (320px) ============ */
	@media (max-width: 360px) {
		/* El botón dorado y el logo no caben: priorizamos el CTA */
		.brand-title {
			font-size: 0.95rem;
		}

		.logo-shield {
			width: 34px;
			height: 34px;
		}

		.user-button {
			max-width: 120px;
			padding: 8px 12px;
		}

		.btn-sm {
			padding: 8px 12px;
			font-size: 0.72rem;
		}
	}
</style>
