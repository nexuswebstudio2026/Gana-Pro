---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	title?: string;
}

const token = Astro.cookies.get('auth_session')?.value;
const isLoggedIn = Boolean(token);
---

<header class="navbar">
	<div class="nav-container">
		<a href="/" class="brand">
			<div class="logo-shield">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
					<path d="m9 12 2 2 4-4" stroke-width="2.2"></path>
				</svg>
			</div>
			<div class="brand-text">
				<span class="brand-title font-cinzel">GANA <span class="gold-gradient-text">PRO</span></span>
				<span class="brand-tag">ELITE & LUXURY</span>
			</div>
		</a>

		<nav class="nav-links" id="primary-nav" aria-label="Navegación principal">
			<a href="/" class="nav-link" aria-current="page">Inicio</a>
			<a href="/gana-dinero" class="nav-link">Gana Dinero</a>
			<a href="/sobre-nosotros" class="nav-link">Sobre Nosotros</a>
			<a href="/contacto" class="nav-link">Contacto</a>
		</nav>

		<div class="nav-actions">
			<ThemeToggle />
			{isLoggedIn ? (
				<a href="/dashboard" class="gold-button btn-sm">Mi Portal</a>
			) : (
				<a href="/login" class="gold-button btn-sm">Acceso</a>
			)}
		</div>

		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-controls="primary-nav"
			aria-expanded="false"
			aria-label="Abrir menú de navegación"
		>
			<span class="nav-toggle-bar" aria-hidden="true"></span>
			<span class="nav-toggle-bar" aria-hidden="true"></span>
			<span class="nav-toggle-bar" aria-hidden="true"></span>
		</button>
	</div>
	<div class="nav-backdrop" data-nav-backdrop hidden></div>
</header>

<script>
	const navToggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
	const navPanel = document.getElementById('primary-nav');
	const navBackdrop = document.querySelector<HTMLElement>('[data-nav-backdrop]');

	const setMenu = (open: boolean) => {
		navToggle?.classList.toggle('is-open', open);
		navPanel?.classList.toggle('is-open', open);
		navToggle?.setAttribute('aria-expanded', String(open));
		navToggle?.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
		if (navBackdrop) navBackdrop.hidden = !open;
		document.documentElement.classList.toggle('nav-open', open);
	};

	navToggle?.addEventListener('click', () => {
		setMenu(!navPanel?.classList.contains('is-open'));
	});
	navBackdrop?.addEventListener('click', () => setMenu(false));
	navPanel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenu(false);
	});
	// Al volver a escritorio, asegurar que el panel quede cerrado
	window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
		if (event.matches) setMenu(false);
	});
</script>

<style>
	.navbar {
		position: sticky;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: var(--bg-header);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid var(--gold-border);
		box-shadow: var(--header-shadow);
		transition: all 0.3s ease;
	}

	.nav-container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 16px 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 14px;
		text-decoration: none;
	}

	.logo-shield {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.2) 0%, rgba(10, 25, 49, 0.6) 100%);
		border: 1px solid var(--gold-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gold-primary);
		box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.brand:hover .logo-shield {
		transform: scale(1.05) rotate(4deg);
		box-shadow: 0 0 25px rgba(212, 175, 55, 0.5);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
	}

	.brand-title {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: var(--text-primary);
		line-height: 1.1;
	}

	.brand-tag {
		font-size: 0.65rem;
		letter-spacing: 0.25em;
		color: var(--gold-primary);
		font-weight: 700;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.nav-link {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		position: relative;
		transition: color 0.25s ease;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		bottom: -6px;
		left: 0;
		width: 0%;
		height: 2px;
		background: var(--gold-primary);
		transition: width 0.3s ease;
	}

	.nav-link:hover {
		color: var(--gold-primary);
	}

	.nav-link:hover::after {
		width: 100%;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.nav-toggle,
	.nav-backdrop {
		display: none;
	}

	.btn-sm {
		padding: 10px 22px;
		font-size: 0.85rem;
	}

	/* ============ TABLET Y MÓVIL ============ */
	@media (max-width: 900px) {
		.nav-container {
			padding: 12px 18px;
			gap: 12px;
		}

		/* El panel de navegación se convierte en un desplegable */
		.nav-links {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 8px 18px 18px;
			background: var(--bg-header);
			backdrop-filter: blur(20px);
			-webkit-backdrop-filter: blur(20px);
			border-bottom: 1px solid var(--gold-border);
			box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
			/* Oculto por defecto; se despliega con .is-open */
			opacity: 0;
			visibility: hidden;
			transform: translateY(-8px);
			transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
		}

		.nav-links.is-open {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.nav-link {
			padding: 14px 4px;
			font-size: 1rem;
			font-weight: 600;
			border-bottom: 1px solid rgba(212, 175, 55, 0.12);
		}

		/* En móvil la subrayado inferior estorba: usar indicator a la izquierda */
		.nav-link::after {
			display: none;
		}

		.nav-link[aria-current='page'] {
			color: var(--gold-primary);
		}

		.nav-link[aria-current='page']::before {
			content: '';
			position: absolute;
			left: -10px;
			top: 50%;
			transform: translateY(-50%);
			width: 3px;
			height: 20px;
			border-radius: 3px;
			background: var(--gold-primary);
		}

		.nav-actions {
			margin-left: auto;
			gap: 12px;
		}

		/* Botón hamburguesa */
		.nav-toggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 5px;
			width: 44px;
			height: 44px;
			flex: 0 0 44px;
			padding: 0;
			background: rgba(212, 175, 55, 0.1);
			border: 1px solid var(--gold-border);
			border-radius: 12px;
			cursor: pointer;
			transition: background 0.25s ease, border-color 0.25s ease;
		}

		.nav-toggle:hover,
		.nav-toggle.is-open {
			background: rgba(212, 175, 55, 0.22);
			border-color: var(--gold-primary);
		}

		.nav-toggle-bar {
			display: block;
			width: 20px;
			height: 2px;
			border-radius: 2px;
			background: var(--gold-primary);
			transition: transform 0.28s ease, opacity 0.2s ease;
		}

		/* Animación a "X" */
		.nav-toggle.is-open .nav-toggle-bar:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		.nav-toggle.is-open .nav-toggle-bar:nth-child(2) {
			opacity: 0;
		}
		.nav-toggle.is-open .nav-toggle-bar:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}

		.nav-backdrop {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 90;
			background: rgba(2, 7, 18, 0.55);
			opacity: 0;
			transition: opacity 0.25s ease;
		}

		.nav-backdrop[hidden] {
			display: none;
		}

		/* Evita scroll del fondo mientras el menú está abierto */
		:global(html.nav-open) {
			overflow: hidden;
		}
	}

	/* ============ MÓVILES PEQUEÑOS ============ */
	@media (max-width: 480px) {
		.nav-container {
			padding: 10px 14px;
			gap: 8px;
		}

		/* La marca compite por espacio con los botones: reducir */
		.logo-shield {
			width: 38px;
			height: 38px;
			border-radius: 10px;
		}

		.brand {
			gap: 10px;
		}

		.brand-title {
			font-size: 1.05rem;
			letter-spacing: 0.08em;
		}

		.brand-tag {
			display: none;
		}

		.nav-actions {
			gap: 8px;
		}

		.nav-actions :global(.theme-toggle-btn) {
			width: 40px;
			height: 40px;
		}

		.btn-sm {
			padding: 9px 16px;
			font-size: 0.78rem;
		}

		.nav-toggle {
			width: 40px;
			height: 40px;
			flex-basis: 40px;
		}
	}

	/* ============ PANTALLAS MUY PEQUEÑAS (320px) ============ */
	@media (max-width: 360px) {
		/* El botón dorado y el logo no caben: priorizamos el CTA */
		.brand-title {
			font-size: 0.95rem;
		}

		.logo-shield {
			width: 34px;
			height: 34px;
		}

		.btn-sm {
			padding: 8px 12px;
			font-size: 0.72rem;
		}
	}
</style>
