---
import { getTestimonials, averageRating } from '../lib/testimonials';
import { formatAppDateTime } from '../lib/datetime';
import type { Session } from '../lib/session';

interface Props {
	session: Session | null;
}

const { session } = Astro.props;

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const imageProblem = Astro.url.searchParams.get('imagen');


// Los testimonios se cargan desde Google Sheets; si falla, la página sigue funcionando
let testimonials: Awaited<ReturnType<typeof getTestimonials>> = [];
let loadError = false;
try {
	testimonials = await getTestimonials();
} catch (e) {
	loadError = true;
	console.error('Error al cargar testimonios:', e);
}

const average = averageRating(testimonials);
const totalRatings = testimonials.filter((t) => t.rating > 0).length;

// Las fechas se guardan en ISO con desfase y se muestran en la zona de la
// plataforma; el formato antiguo (generado en UTC) también se interpreta.
const formatDate = (value: string): string => formatAppDateTime(value);

---

<section class="section testimonials-section" id="testimonios" aria-labelledby="testimonials-title">
	<div class="section-container">
		<div class="section-header">
			<span class="section-badge font-cinzel">VOCES DE LA COMUNIDAD</span>
			<h2 class="section-title font-cinzel" id="testimonials-title">
				Testimonios <span class="gold-gradient-text">y Valoraciones</span>
			</h2>
			<p class="section-subtitle">
				Los miembros registrados valoran la metodología de 1 a 5 estrellas y comparten su experiencia. Las
				puntuaciones se muestran sin filtrar, incluyendo las negativas.
			</p>
		</div>

		{totalRatings > 0 && (
			<div class="rating-summary luxury-card">
				<div class="rating-big">
					<span class="rating-average font-cinzel">{average.toFixed(1)}</span>
					<div class="rating-stars" aria-hidden="true">
						{[1, 2, 3, 4, 5].map((n) => (
							<span class:list={['star', { filled: n <= Math.round(average) }]}>★</span>
						))}
					</div>
				</div>
				<div class="rating-meta">
					<strong>{totalRatings}</strong> valoración{totalRatings === 1 ? '' : 'es'} registrada
					{totalRatings === 1 ? '' : 's'}
					<br />
					<span class="rating-hint">Puntuación media de la metodología</span>
				</div>
			</div>
		)}

		{ok && (
			<div class="alert alert-ok" role="status">
				¡Gracias! Tu testimonio y tu valoración han sido publicados.
			</div>
		)}
		{imageProblem === 'config' && (
			<div class="alert alert-error" role="alert">
				Tu testimonio se publicó, pero la imagen no pudo subirse porque el almacenamiento de imágenes no
				está configurado en el servidor. Avísale al administrador para que añada
				<code>BLOB_READ_WRITE_TOKEN</code> en las variables de entorno de Vercel.
			</div>
		)}
		{imageProblem === 'upload' && (
			<div class="alert alert-error" role="alert">
				Tu testimonio se publicó, pero la imagen no pudo subirse al almacenamiento de imágenes. Puedes
				volver a publicarlo más adelante.
			</div>
		)}
		{error && (
			<div class="alert alert-error" role="alert">
				{error}
			</div>
		)}
		{loadError && (
			<div class="alert alert-error" role="alert">
				No se pudieron cargar los testimonios en este momento.
			</div>
		)}

		<div class="testimonials-layout">
			<div class="luxury-card form-card">
				<h3 class="form-title font-cinzel">Comparte tu Experiencia</h3>
				{session ? (
					<form method="POST" action="/api/testimonials" enctype="multipart/form-data" class="tform">
						<div class="field">
							<label for="rating">Valoración de la metodología</label>
							<div class="star-picker">
								<span class="star-picker-label">Selecciona de 1 a 5 estrellas</span>
								<div class="star-options" role="radiogroup" aria-label="Valoración de la metodología">
									{[1, 2, 3, 4, 5].map((n) => (
										<label class="star-option">
											<input type="radio" name="rating" value={n} required={n === 1} />
											<span class="star-option-mark">★</span>
											<span class="sr-only">{n} estrella{n === 1 ? '' : 's'}</span>
										</label>
									))}
								</div>
							</div>
						</div>

						<div class="field">
							<label for="comment">Tu testimonio</label>
							<textarea
								id="comment"
								name="comment"
								rows="5"
								required
								minlength="10"
								maxlength="1200"
								placeholder="¿Qué te ha parecido la metodología? Sé honesto: tu valoración ayuda a otros miembros."
							></textarea>
						</div>

						<div class="field">
							<label for="image">Imagen (opcional)</label>
							<input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
							<span class="field-hint">JPG, PNG, WEBP o GIF. Máximo 5 MB.</span>
						</div>

						<button type="submit" class="gold-button btn-full" data-publish>
						Publicar Testimonio
					</button>
					{/*
						Subir una imagen a Vercel Blob tarda varios segundos. Sin esto el
						botón sigue activo y un doble clic creaba dos testimonios.
					*/}
					<div class="upload-progress" data-progress hidden>
						<div class="upload-bar"><span data-progress-bar></span></div>
						<p class="upload-text" data-progress-text>Subiendo tu testimonio…</p>
					</div>
						<p class="form-note">
							Publicando como <strong>{session.username}</strong>. Tu valoración se mostrará tal cual, sea
							positiva o negativa.
						</p>
					</form>
				) : (
					<div class="login-prompt">
						<p>
							<strong>Inicia sesión</strong> para valorar la metodología y publicar tu testimonio con
							imagen.
						</p>
						<div class="login-actions">
							<a href="/login" class="gold-button">Iniciar Sesión</a>
							<a href="/register" class="ghost-gold-button">Crear Cuenta</a>
						</div>
					</div>
				)}
			</div>
			<div class="testimonials-list">
				{testimonials.length === 0 ? (
					<div class="luxury-card empty-state">
						<p>Aún no hay testimonios publicados. Sé el primero en valorar la metodología.</p>
					</div>
				) : (
					testimonials.map((t) => (
						<article class="luxury-card testimonial-card">
							<div class="testimonial-head">
								<div class="testimonial-author">
									<span class="author-avatar" aria-hidden="true">
										{t.username ? t.username.charAt(0).toUpperCase() : '?'}
									</span>
									<div>
										<strong>{t.username || 'Miembro'}</strong>
										{t.level && <span class="author-level">Nivel {t.level}</span>}
									</div>
								</div>
								<div class="testimonial-rating">
									<span class="sr-only">{t.rating} de 5 estrellas</span>
									{[1, 2, 3, 4, 5].map((n) => (
										<span class:list={['star', { filled: n <= t.rating }]} aria-hidden="true">★</span>
									))}
								</div>
							</div>

							<p class="testimonial-comment">{t.comment}</p>

							{t.imageUrl && (
								<a href={t.imageUrl} target="_blank" rel="noopener noreferrer" class="testimonial-image">
									<img src={t.imageUrl} alt={`Imagen del testimonio de ${t.username}`} loading="lazy" />
								</a>
							)}

							{t.date && <span class="testimonial-date">{formatDate(t.date)}</span>}
						</article>
					))
				)}
			</div>
		</div>
	</div>
</section>

<script>
	// `fetch` no informa el progreso de la subida, asi que se usa
	// XMLHttpRequest: sin esto no habria forma de saber cuanto falta ni de
	// deshabilitar el boton mientras dura el envio.
	const form = document.querySelector<HTMLFormElement>('form.tform');
	const boton = document.querySelector<HTMLButtonElement>('[data-publish]');
	const caja = document.querySelector<HTMLElement>('[data-progress]');
	const barra = document.querySelector<HTMLElement>('[data-progress-bar]');
	const texto = document.querySelector<HTMLElement>('[data-progress-text]');

	form?.addEventListener('submit', (event) => {
		if (!form || !boton) return;

		event.preventDefault();

		// Segundo clic mientras el primero sigue en vuelo: se ignora.
		if (boton.hasAttribute('disabled')) return;

		const datos = new FormData(form);
		const xhr = new XMLHttpRequest();
		xhr.open('POST', '/api/testimonials');

		if (caja) caja.hidden = false;
		if (boton) {
			boton.setAttribute('disabled', 'disabled');
			boton.textContent = 'Publicando…';
		}

		// Se mueve despacio al principio (subir el archivo domina el tiempo) y se
		// completa al recibir la respuesta, que es cuando el alta ya esta hecha.
		xhr.upload.addEventListener('progress', (ev) => {
			if (!ev.lengthComputable || !barra) return;
			const pct = Math.min(92, Math.round((ev.loaded / ev.total) * 100));
			barra.style.width = pct + '%';
			if (texto) texto.textContent = 'Subiendo tu testimonio… ' + pct + '%';
		});

		xhr.addEventListener('load', () => {
			if (barra) barra.style.width = '100%';
			if (texto) texto.textContent = 'Listo. Actualizando…';
			// Se deja que la redireccion del servidor se encargue: el destino ya
			// lleva los parametros de exito o de error.
			window.location.href = xhr.responseURL || '/valoraciones';
		});

		xhr.addEventListener('error', () => {
			if (boton) {
				boton.removeAttribute('disabled');
				boton.textContent = 'Publicar Testimonio';
			}
			if (caja) caja.hidden = true;
			if (texto) texto.textContent = 'No se pudo subir. Inténtalo de nuevo.';
			if (caja) caja.hidden = false;
		});

		xhr.send(datos);
	});
</script>

<style>
	.upload-progress {
		margin-top: 14px;
	}

	.upload-progress[hidden] {
		display: none;
	}

	.upload-bar {
		height: 6px;
		border-radius: 9999px;
		background: rgba(212, 175, 55, 0.16);
		overflow: hidden;
	}

	.upload-bar span {
		display: block;
		height: 100%;
		width: 0%;
		border-radius: 9999px;
		background: var(--gold-gradient);
		transition: width 0.25s ease;
	}

	.upload-text {
		margin: 8px 0 0;
		font-size: 12.5px;
		color: var(--text-secondary);
	}

	/* Boton bloqueado durante la subida: tiene que verse que no hace nada. */
	.gold-button[disabled] {
		opacity: 0.65;
		cursor: progress;
		transform: none;
	}

	.testimonial-card {
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.testimonial-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 22px 48px -16px rgba(10, 17, 40, 0.35);
	}

	.testimonial-image img {
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.testimonial-image:hover img {
		transform: scale(1.05);
	}
	.section {
		padding: 85px 24px;
	}

	.section-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 50px;
	}

	.section-badge {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		font-weight: 700;
		color: var(--gold-primary);
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 800;
		margin-bottom: 16px;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 620px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* Solo para lectores de pantalla */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ---- Resumen de valoración ---- */
	.rating-summary {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 28px;
		padding: 24px 30px;
		margin-bottom: 36px;
	}

	.rating-big {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.rating-average {
		font-size: 2.6rem;
		font-weight: 900;
		color: var(--gold-primary);
		line-height: 1;
	}

	.rating-stars,
	.testimonial-rating {
		display: inline-flex;
		gap: 3px;
	}

	.star {
		color: rgba(212, 175, 55, 0.25);
		font-size: 1.15rem;
		line-height: 1;
	}

	.star.filled {
		color: var(--gold-primary);
	}

	.rating-meta {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.6;
	}

	.rating-meta strong {
		color: var(--text-primary);
		font-size: 1.1rem;
	}

	.rating-hint {
		font-size: 0.82rem;
	}

	/* ---- Avisos ---- */
	.alert {
		padding: 13px 18px;
		border-radius: 12px;
		font-size: 0.92rem;
		margin-bottom: 22px;
		line-height: 1.5;
	}

	.alert-ok {
		background: rgba(16, 185, 129, 0.12);
		border: 1px solid rgba(16, 185, 129, 0.35);
		color: #10b981;
	}

	.alert-error {
		background: rgba(239, 68, 68, 0.12);
		border: 1px solid rgba(239, 68, 68, 0.35);
		color: #ef4444;
	}

	/* ---- Disposición ---- */
	.testimonials-layout {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 32px;
		align-items: start;
	}

	/* ---- Formulario ---- */
	.form-card {
		padding: 34px 30px;
		position: sticky;
		top: 110px;
	}

	.form-title {
		font-size: 1.3rem;
		font-weight: 800;
		margin-bottom: 22px;
	}

	.tform {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--text-secondary);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.field textarea,
	.field input[type='file'] {
		padding: 13px 15px;
		background: rgba(15, 23, 42, 0.05);
		border: 1px solid var(--gold-border);
		border-radius: 12px;
		font-size: 0.95rem;
		font-family: inherit;
		color: var(--text-primary);
		width: 100%;
		box-sizing: border-box;
		transition: border-color 0.25s ease, box-shadow 0.25s ease;
	}

	:global([data-theme='dark']) .field textarea,
	:global([data-theme='dark']) .field input[type='file'] {
		background: rgba(4, 11, 28, 0.6);
	}

	.field textarea:focus,
	.field input[type='file']:focus {
		outline: none;
		border-color: var(--gold-primary);
		box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
	}

	.field textarea {
		resize: vertical;
		min-height: 110px;
		line-height: 1.6;
	}

	.field-hint {
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	.btn-full {
		width: 100%;
		padding: 14px;
		font-size: 0.95rem;
	}

	.form-note {
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.5;
		text-align: center;
	}

	/* ---- Selector de estrellas ---- */
	.star-picker {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.star-picker-label {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.star-options {
		display: flex;
		gap: 6px;
	}

	.star-option {
		cursor: pointer;
		line-height: 1;
	}

	.star-option input {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}

	.star-option-mark {
		display: block;
		font-size: 2rem;
		color: rgba(212, 175, 55, 0.28);
		transition: color 0.2s ease, transform 0.2s ease;
		padding: 0 2px;
	}

	/* Resaltar al pasar el cursor */
	.star-option:hover .star-option-mark,
	.star-option:hover ~ .star-option .star-option-mark {
		color: var(--gold-primary);
	}

	.star-option:hover .star-option-mark {
		transform: scale(1.12);
	}

	.star-option:focus-within .star-option-mark {
		outline: 2px solid var(--gold-primary);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* ---- Lista de testimonios ---- */
	.testimonials-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.testimonial-card {
		padding: 24px 26px;
	}

	.testimonial-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 14px;
		flex-wrap: wrap;
	}

	.testimonial-author {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.author-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid var(--gold-border);
		color: var(--gold-primary);
		display: grid;
		place-items: center;
		font-weight: 800;
		font-size: 1rem;
		flex-shrink: 0;
	}

	.testimonial-author strong {
		display: block;
		font-size: 0.95rem;
		color: var(--text-primary);
	}

	.author-level {
		font-size: 0.75rem;
		color: var(--gold-primary);
		font-weight: 600;
	}

	.testimonial-comment {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 14px;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.testimonial-image {
		display: block;
		margin-bottom: 14px;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--gold-border);
	}

	.testimonial-image img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 320px;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.testimonial-image:hover img {
		transform: scale(1.03);
	}

	.testimonial-date {
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	/* ---- Estado vacío / login ---- */
	.empty-state {
		padding: 40px 30px;
		text-align: center;
		color: var(--text-muted);
	}

	.login-prompt {
		text-align: center;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.login-actions {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 22px;
	}

	/* ============ RESPONSIVE ============ */
	@media (max-width: 900px) {
		.testimonials-layout {
			grid-template-columns: 1fr;
		}

		/* En una sola columna el sticky molesta */
		.form-card {
			position: static;
		}
	}

	@media (max-width: 640px) {
		.section {
			padding: 52px 18px;
		}

		.section-header {
			margin-bottom: 34px;
		}

		.rating-summary {
			flex-direction: column;
			gap: 12px;
			padding: 22px 18px;
			margin-bottom: 28px;
		}

		.rating-average {
			font-size: 2.1rem;
		}

		.form-card {
			padding: 26px 20px;
		}

		/* Las estrellas se mantienen en fila: son el control principal */
		.star-option-mark {
			font-size: 1.7rem;
		}

		.testimonial-card {
			padding: 20px 18px;
		}

		.testimonial-image img {
			max-height: 220px;
		}
	}
</style>