---
import Logo from './Logo.astro';
---

<footer class="footer">
	<div class="footer-container">
		<div class="footer-top">
			<div class="footer-brand">
				<div class="logo-shield">
					<Logo size={26} />
				</div>
				<span class="brand-title font-cinzel">GANA <span class="gold-gradient-text">PRO</span></span>
				<p class="brand-desc">
					La cumbre de las soluciones financieras, membresías exclusivas y plataformas de alto rendimiento. Diseñado con precisión, elegancia y tecnología de vanguardia.
				</p>
			</div>

			<div class="footer-nav">
				<div class="nav-col">
					<h4 class="col-title font-cinzel">La Plataforma</h4>
					<a href="/gana-dinero">Gana Dinero</a>
					<a href="/sobre-nosotros">Sobre Nosotros</a>
					<a href="/#testimonios">Testimonios</a>
					<a href="/dashboard">Mi Portal</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="copyright">
				© 2026 <a href="/" class="site-link">Gana Pro</a> - <a
					href="https://nexuswebstudio.vercel.app/"
					target="_blank"
					rel="noopener noreferrer"
					class="studio-link">Nexus Web Studio</a> &nbsp;Todos los derechos reservados.
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--bg-tertiary);
		border-top: 1px solid var(--gold-border);
		padding: 70px 24px 30px;
		margin-top: auto;
		position: relative;
	}

	.footer-container {
		max-width: 1280px;
		margin: 0 auto;
	}

	.footer-top {
		display: grid;
		/* Marca a la izquierda, columna de enlaces a la derecha */
		grid-template-columns: 1.2fr 1fr;
		gap: 60px;
		padding-bottom: 50px;
		border-bottom: 1px solid rgba(212, 175, 55, 0.15);
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.logo-shield {
		width: 42px;
		height: 42px;
		border-radius: 10px;
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid var(--gold-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gold-primary);
	}

	.brand-title {
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: 0.1em;
	}

	.brand-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.7;
		max-width: 420px;
	}

	/* Una sola columna de enlaces: ocupa menos espacio y mantiene la jerarquía */
	.footer-nav {
		display: grid;
		grid-template-columns: 1fr;
		gap: 30px;
		justify-items: start;
	}

	.col-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--gold-primary);
		letter-spacing: 0.1em;
		margin-bottom: 18px;
		text-transform: uppercase;
	}

	.nav-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.nav-col a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.nav-col a:hover {
		color: var(--gold-primary);
		transform: translateX(3px);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 30px;
		font-size: 0.85rem;
		color: var(--text-muted);
		flex-wrap: wrap;
		gap: 16px;
	}

	.copyright a {
		color: var(--gold-primary);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.copyright a:hover {
		color: var(--gold-hover);
		border-bottom-color: var(--gold-primary);
	}

	@media (max-width: 860px) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 40px;
		}
	}

	@media (max-width: 520px) {
		.footer-bottom {
			flex-direction: column;
			text-align: center;
		}
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 640px) {
		.footer {
			padding: 48px 18px 26px;
		}

		.footer-top {
			padding-bottom: 34px;
		}

		.footer-brand {
			gap: 12px;
		}

		.brand-title {
			font-size: 1.3rem;
		}

		/* Los enlaces del footer necesitan altura mínima para el dedo */
		.nav-col {
			gap: 4px;
		}

		.nav-col a {
			display: inline-block;
			padding: 9px 0;
			font-size: 0.88rem;
		}

		.col-title {
			margin-bottom: 10px;
		}

		.footer-bottom {
			padding-top: 22px;
			flex-direction: column;
			gap: 10px;
			text-align: center;
		}
	}
</style>
