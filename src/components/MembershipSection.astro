---
// MembershipSection.astro
---

<section id="membresia" class="section membership-section">
	<div class="section-container">
		<div class="section-header">
			<span class="section-badge font-cinzel">NIVELES DE PRIVILEGIO</span>
			<h2 class="section-title font-cinzel">Membresías de <span class="gold-gradient-text">Élite</span></h2>
			<p class="section-subtitle">Acceso exclusivo al club financiero y tecnológico más prestigioso.</p>
		</div>

		<div class="membership-grid">
			<div class="luxury-card tier-card">
				<h3 class="tier-name font-cinzel">Gold Reserve</h3>
				<p class="tier-for">Para inversores en crecimiento de alta distinción</p>
				<div class="tier-price font-cinzel">
					<span class="currency">$</span>
					<span class="val">1,500</span>
					<span class="period">/ mes</span>
				</div>
				<ul class="tier-list">
					<li>Retornos cuantitativos de hasta 22% anual</li>
					<li>Acceso ininterrumpido al portal seguro</li>
					<li>Notificaciones de mercado prioritarias</li>
					<li>Conserjería financiera dedicada</li>
				</ul>
				<a href="/register" class="ghost-gold-button full-btn">Comenzar Gold</a>
			</div>

			<div class="luxury-card tier-card tier-featured">
				<div class="featured-ribbon font-cinzel">NIVEL MÁXIMO</div>
				<h3 class="tier-name font-cinzel">Black Diamond</h3>
				<p class="tier-for">Exclusivo para patrimonios exigentes y fondos privados</p>
				<div class="tier-price font-cinzel">
					<span class="currency">$</span>
					<span class="val">5,000</span>
					<span class="period">/ mes</span>
				</div>
				<ul class="tier-list">
					<li>Rendimiento prioritario +38.4% anual</li>
					<li>Concierge financiero personal 24/7</li>
					<li>Bóveda multi-firmas con custodia Suiza</li>
					<li>Rondas de inversión privada exclusivas</li>
				</ul>
				<a href="/register" class="gold-button full-btn">Solicitar Invitación VIP</a>
			</div>

			<div class="luxury-card tier-card">
				<h3 class="tier-name font-cinzel">Crown Sovereign</h3>
				<p class="tier-for">Para family offices e instituciones corporativas</p>
				<div class="tier-price font-cinzel">
					<span class="val font-cinzel">A MEDIDA</span>
				</div>
				<ul class="tier-list">
					<li>Estrategia cuantitativa a la medida</li>
					<li>Infraestructura con latencia ultra-baja</li>
					<li>Reuniones directivas en Zúrich o Londres</li>
					<li>Garantía de liquidez institucional</li>
				</ul>
				<a href="/register" class="ghost-gold-button full-btn">Contactar Asesor</a>
			</div>
		</div>
	</div>
</section>

<section class="section cta-section">
	<div class="section-container">
		<div class="luxury-card cta-box">
			<div class="cta-content">
				<h2 class="cta-title font-cinzel">¿Listo para elevar su estándar financiero?</h2>
				<p class="cta-desc">Únase a miles de líderes e inversores que disfrutan del poder de GANA PRO.</p>
				<div class="cta-btns">
					<a href="/register" class="gold-button">Crear Cuenta Exclusiva</a>
					<a href="/login" class="ghost-gold-button">Ya Soy Miembro</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.section { padding: 85px 24px; }
	.section-container { max-width: 1240px; margin: 0 auto; }
	.section-header { text-align: center; margin-bottom: 50px; }
	.section-badge {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		font-weight: 700;
		color: var(--gold-primary);
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 12px;
	}
	.section-title { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 800; margin-bottom: 16px; }
	.section-subtitle { font-size: 1.05rem; color: var(--text-muted); max-width: 620px; margin: 0 auto; }
	.membership-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
	.tier-card { padding: 40px 28px; display: flex; flex-direction: column; position: relative; }
	.tier-featured {
		border-color: var(--gold-primary);
		transform: scale(1.03);
		box-shadow: 0 0 40px rgba(212, 175, 55, 0.25);
		background: linear-gradient(180deg, rgba(212, 175, 55, 0.08) 0%, var(--bg-card) 40%);
	}
	.featured-ribbon {
		position: absolute;
		top: -14px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--gold-gradient);
		color: #030712;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.15em;
		padding: 4px 14px;
		border-radius: 9999px;
	}
	.tier-name { font-size: 1.55rem; font-weight: 800; margin-bottom: 8px; }
	.tier-for { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 22px; min-height: 42px; }
	.tier-price { display: flex; align-items: baseline; gap: 4px; margin-bottom: 28px; color: var(--gold-primary); }
	.tier-price .currency { font-size: 1.4rem; font-weight: 700; }
	.tier-price .val { font-size: 2.6rem; font-weight: 900; }
	.tier-price .period { font-size: 0.95rem; color: var(--text-muted); }
	.tier-list { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-bottom: 34px; flex-grow: 1; }
	.tier-list li { font-size: 0.92rem; color: var(--text-secondary); display: flex; align-items: center; gap: 10px; }
	.tier-list li::before { content: '✦'; color: var(--gold-primary); }
	.full-btn { width: 100%; text-align: center; }

	.cta-box {
		padding: 60px 30px;
		text-align: center;
		background: radial-gradient(circle at center, rgba(30, 58, 138, 0.25) 0%, var(--bg-card) 75%);
		border: 1px solid var(--gold-border);
	}
	.cta-content { max-width: 680px; margin: 0 auto; }
	.cta-title { font-size: clamp(2rem, 3.5vw, 2.7rem); font-weight: 800; margin-bottom: 16px; }
	.cta-desc { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 34px; }
	.cta-btns { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }

	@media (max-width: 900px) {
		.membership-grid {
			grid-template-columns: 1fr;
		}
		.tier-featured {
			transform: none;
		}
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 640px) {
		.section {
			padding: 56px 18px;
		}

		.section-header {
			margin-bottom: 36px;
		}

		.tier-card {
			padding: 32px 22px;
		}

		/* La etiqueta "NIVEL MÁXIMO" no debe salirse en pantallas estrechas */
		.featured-ribbon {
			font-size: 0.62rem;
			letter-spacing: 0.1em;
			padding: 4px 10px;
		}

		.tier-price {
			margin-bottom: 22px;
		}

		.tier-price .val {
			font-size: 2.2rem;
		}

		.tier-list {
			gap: 12px;
			margin-bottom: 28px;
		}

		.cta-box {
			padding: 40px 20px;
		}

		.cta-desc {
			margin-bottom: 26px;
		}

		/* Los botones del CTA se apilan a ancho completo */
		.cta-btns {
			flex-direction: column;
		}

		.cta-btns a {
			width: 100%;
		}
	}
</style>
