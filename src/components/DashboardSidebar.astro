---
interface Props {
	isAdmin: boolean;
}

interface NavLink {
	href: string;
	label: string;
	icon?: string;
	anchor?: string;
}

interface NavGroup {
	title: string;
	links: NavLink[];
	adminOnly?: boolean;
}

const { isAdmin } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/dashboard';
const isActive = (path: string) => currentPath === path;

const groups: NavGroup[] = [
	{
		title: 'Principal',
		links: [{ href: '/dashboard', label: 'Inicio', icon: '⌂' }],
	},
	{
		title: 'Administración',
		adminOnly: true,
		links: [
			{ href: '/dashboard/organigrama-global', label: 'Organigrama Global', icon: '⌘' },
			{ href: '/dashboard/usuarios-registrados', label: 'Usuarios Registrados', icon: '♙' },
		],
	},
	{
		title: 'Contabilidad',
		adminOnly: true,
		links: [
			{ href: '/dashboard/recargas', label: 'Solicitudes de Recarga', icon: '↓' },
			{ href: '/dashboard/retiros', label: 'Solicitudes de Retiro', icon: '↑' },
			{ href: '/dashboard/ingresos', label: 'Ingresos', icon: '＋' },
			{ href: '/dashboard/gastos', label: 'Gastos', icon: '－' },
		],
	},
	{
		title: 'Negocio',
		adminOnly: true,
		links: [
			{ href: '/dashboard/negocio', label: 'Configuración del Negocio', icon: '▣' },
			{ href: '/dashboard/negocio#rut-empresarial', label: 'RUT Empresarial', anchor: 'rut-empresarial' },
		],
	},
	{
		title: 'Mi cuenta',
		links: [
			{ href: '/dashboard/mi-organigrama', label: 'Mi organigrama', icon: '⌘' },
			{ href: '/dashboard/informacion-cuenta', label: 'Información de la Cuenta', icon: '◉' },
			{ href: '/dashboard/rut', label: 'NIT y RUT Personal', icon: '▤' },
			{ href: '/dashboard/ubicacion', label: 'Mi Ubicación', icon: '◎' },
		],
	},
];

const visibleGroups = groups.filter((group) => !group.adminOnly || isAdmin);
---

<button
	class="sidebar-mobile-toggle"
	type="button"
	data-sidebar-toggle
	aria-controls="dashboard-sidebar"
	aria-expanded="false"
	aria-label="Abrir menú del panel"
>
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
		<path d="M4 6h16M4 12h16M4 18h16"></path>
	</svg>
</button>

<aside class="dashboard-sidebar" id="dashboard-sidebar" aria-label="Navegación del panel">
	<nav class="sidebar-nav" aria-label="Secciones del panel">
		{visibleGroups.map((group, groupIndex) => (
			<div class:list={['nav-group', { 'nav-group-first': groupIndex === 0 }]}>
				<span class="nav-group-title">{group.title}</span>
				{group.links.map((link) => {
					const linkPath = link.href.split('#')[0];
					const active = link.anchor
						? false
						: linkPath === '/dashboard'
							? isActive('/dashboard') && !Astro.url.hash
							: isActive(linkPath);
					const isChild = Boolean(link.anchor);
					return (
						<a
							class:list={['sidebar-link', { active, 'nested-child': isChild }]}
							href={link.href}
							data-nav-link
							data-home-link={linkPath === '/dashboard' ? true : undefined}
							data-nav-anchor={link.anchor}
							aria-current={active ? 'page' : undefined}
						>
							{link.icon && (
								<span class="nav-icon" aria-hidden="true">{link.icon}</span>
							)}
							<span>{link.label}</span>
						</a>
					);
				})}
			</div>
		))}
	</nav>
</aside>
<div class="sidebar-backdrop" data-sidebar-backdrop></div>

<script>
	const sidebar = document.getElementById('dashboard-sidebar');
	const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
	const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
	const setSidebar = (open: boolean) => {
		toggle?.classList.toggle('is-hidden', open);
		sidebar?.classList.toggle('is-open', open);
		backdrop?.classList.toggle('is-visible', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	const syncAnchorNavigation = () => {
		const hash = window.location.hash.slice(1);
		const homeLink = sidebar?.querySelector<HTMLElement>('[data-home-link]');
		const isDashboardHome = window.location.pathname.replace(/\/+$/, '') === '/dashboard';
		homeLink?.classList.toggle('active', isDashboardHome && !hash);
		if (isDashboardHome && !hash) homeLink?.setAttribute('aria-current', 'page');
		else homeLink?.removeAttribute('aria-current');

		sidebar?.querySelectorAll<HTMLElement>('[data-nav-anchor]').forEach((link) => {
			const active = link.dataset.navAnchor === hash;
			link.classList.toggle('active', active);
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	toggle?.addEventListener('click', () => setSidebar(!sidebar?.classList.contains('is-open')));
	backdrop?.addEventListener('click', () => setSidebar(false));
	sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setSidebar(false)));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setSidebar(false);
	});
	window.addEventListener('hashchange', syncAnchorNavigation);
	syncAnchorNavigation();
</script>

<style>
	.dashboard-sidebar {
		width: 280px;
		height: 100vh;
		min-height: 100vh;
		box-sizing: border-box;
		padding: 18px 12px;
		background: var(--bg-surface);
		border-right: 1px solid var(--gold-border);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		position: sticky;
		top: 0;
		z-index: 60;
	}
	.sidebar-nav {
		height: 100%;
		padding: 0;
		overflow-y: auto;
		scrollbar-width: none;
	}
	.sidebar-nav::-webkit-scrollbar { display: none; }
	.nav-group { margin-top: 18px; }
	.nav-group:first-of-type, .nav-group-first { margin-top: 0; }
	.nav-group-title { display: block; padding: 0 12px 8px; color: var(--gold-primary); font-size: 10px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
	.sidebar-link { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 10px 12px; border: 1px solid transparent; border-radius: 10px; color: var(--text-secondary); font-size: 13px; font-weight: 600; text-decoration: none; transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease; }
	.sidebar-link:hover { color: var(--text-primary); background: rgba(212, 175, 55, 0.08); border-color: var(--gold-border); transform: translateX(2px); }
	.sidebar-link.active { color: var(--gold-primary); background: rgba(212, 175, 55, 0.14); border-color: var(--gold-border); }
	.sidebar-link.nested { min-height: 40px; padding-left: 18px; font-size: 12px; font-weight: 500; }
	.sidebar-link.nested-child { min-height: 36px; padding-left: 52px; font-size: 11px; line-height: 1.4; }
	.nav-icon { width: 22px; flex: 0 0 22px; display: grid; place-items: center; color: currentColor; font-size: 19px; line-height: 1; }
	.sidebar-mobile-toggle, .sidebar-backdrop { display: none; }

	@media (max-width: 1024px) {
		.dashboard-sidebar { position: fixed; inset: 0 auto 0 0; width: min(300px, calc(100vw - 36px)); transform: translateX(-105%); transition: transform 0.25s ease; box-shadow: 18px 0 45px rgba(0, 0, 0, 0.28); }
		.dashboard-sidebar.is-open { transform: translateX(0); }
		.sidebar-mobile-toggle { display: grid; place-items: center; position: fixed; top: 16px; left: 16px; z-index: 70; width: 42px; height: 42px; border: 1px solid var(--gold-border); border-radius: 10px; background: var(--bg-surface); color: var(--gold-primary); cursor: pointer; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2); transition: opacity 0.2s ease, transform 0.2s ease; }
		.sidebar-mobile-toggle svg { width: 21px; height: 21px; }
		.sidebar-mobile-toggle.is-hidden { opacity: 0; pointer-events: none; transform: translateY(-8px); }
		.sidebar-backdrop { display: block; position: fixed; inset: 0; z-index: 55; background: rgba(2, 7, 18, 0.62); opacity: 0; pointer-events: none; transition: opacity 0.25s ease; }
		.sidebar-backdrop.is-visible { opacity: 1; pointer-events: auto; }
	}
</style>
