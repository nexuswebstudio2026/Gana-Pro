---
/**
 * Hero de la portada con la calculadora de la matriz 5x1.
 *
 * Las cifras las calcula `matrix-calculator.ts` en el servidor y se pintan en
 * el HTML, de modo que la sección se lee completa aunque el visitante llegue
 * con JavaScript desactivado. El `<script>` solo cambia de nivel al pulsar, sin
 * recalcular nada: así el número que se muestra es siempre el del servidor.
 */
import { allProjections, type LevelProjection } from '../lib/matrix-calculator';

const projections = allProjections();
const fmt = (value: number) => `$${Math.round(value).toLocaleString('es-CO')}`;
---

<section class="hero-section">
	<div class="ambient-glow"></div>
	<div class="ambient-glow-secondary"></div>

	<div class="hero-container">
		<div class="badge-pill">
			<span class="badge-dot"></span>
			<span class="badge-text font-cinzel">ELITE WEALTH &amp; HIGH-PERFORMANCE 2026</span>
		</div>

		<h1 class="hero-title font-cinzel">
			La Matriz 5x1 que Transforma tu Red en
			<span class="gold-gradient-text">Ingresos Recurrentes</span>
		</h1>

		<p class="hero-desc">
			Únete, activa tu cuenta con <strong>$15.000</strong> y escala del Nivel 1 al
			Nivel 5 con la comunidad <strong>Elite &amp; Luxury</strong>.
		</p>

		<div class="hero-actions">
			<a href="/register" class="gold-button">
				<span>Activar mi Nivel</span>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</a>
			<a href="#calculadora" class="ghost-gold-button">Ver la calculadora</a>
		</div>

		<div class="calc luxury-card" id="calculadora">
			<div class="calc-head">
				<span class="calc-badge font-cinzel">CALCULADORA 5x1</span>
				<h2 class="calc-title font-cinzel">¿A qué nivel quieres llegar?</h2>
				<p class="calc-lead">
					Elige tu nivel objetivo y mira qué necesitas para lograrlo y qué queda de cada
					movimiento.
				</p>
			</div>

			<div class="calc-levels" role="group" aria-label="Selecciona tu nivel objetivo">
				{projections.map((projection, index) => (
					<button
						type="button"
						class:list={['calc-level', { 'is-active': index === 0 }]}
						data-calc-level={projection.level}
						aria-pressed={index === 0 ? 'true' : 'false'}
					>
						<span class="calc-level-num font-cinzel">{projection.level}</span>
						<span class="calc-level-name">{projection.levelName}</span>
					</button>
				))}
			</div>

			{/*
				Un panel por nivel, oculto con `hidden` en vez de con CSS: el
				contenido sigue en el HTML (lo indexan los buscadores y lo lee un
				lector de pantalla) y solo se muestra el elegido.
			*/}
			<div class="calc-panels">
				{projections.map((projection: LevelProjection, index) => (
					<div class="calc-panel" data-calc-panel={projection.level} hidden={index !== 0}>
						<div class="calc-figure">
							<span class="calc-figure-label">Referidos activos requeridos</span>
							<span class="calc-figure-value font-cinzel">{projection.requiredActiveSlots}</span>
							<span class="calc-figure-hint">puestos directos verificados</span>
						</div>

						<div class="calc-figure">
							<span class="calc-figure-label">Envío de ascenso</span>
							<span class="calc-figure-value font-cinzel">
								{projection.ascentRate * 100}%
							</span>
							<span class="calc-figure-hint">
								{fmt(projection.ascentAmount)} al patrocinador
							</span>
						</div>

						<div
							class:list={[
								'calc-figure',
								{ 'is-muted': projection.sustainabilityRate === 0 },
							]}
						>
							<span class="calc-figure-label">Sostenimiento GanaPro</span>
							<span class="calc-figure-value font-cinzel">
								{projection.sustainabilityRate * 100}%
							</span>
							<span class="calc-figure-hint">
								{projection.sustainabilityRate === 0
									? 'se activa en el Nivel 5'
									: `${fmt(projection.sustainabilityAmount)} al fondo`}
							</span>
						</div>

						<div class="calc-figure is-net">
							<span class="calc-figure-label">Ganancia neta estimada</span>
							<span class="calc-figure-value font-cinzel">{fmt(projection.netEarnings)}</span>
							<span class="calc-figure-hint">
								sobre {fmt(projection.grossCommission)} generados
							</span>
						</div>
					</div>
				))}
			</div>

			<p class="calc-footnote">
				Estimación basada en las reglas públicas de la plataforma: activación de
				{fmt(projections[0].activationCost)} y comisión por cada referido activo. Las
				ganancias dependen de la verificación de cada recarga y no están garantizadas.
			</p>

			<a href="/register" class="gold-button calc-cta">Crear mi cuenta y empezar</a>
		</div>
	</div>
</section>

<style>
	.hero-section {
		position: relative;
		padding: 90px 24px 70px;
		text-align: center;
		display: flex;
		justify-content: center;
	}

	.ambient-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.ambient-glow-secondary {
		position: absolute;
		top: 150px;
		right: 10%;
		width: 450px;
		height: 350px;
		background: radial-gradient(ellipse at center, rgba(30, 58, 138, 0.25) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.hero-container {
		position: relative;
		z-index: 1;
		max-width: 980px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.badge-pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 18px;
		border-radius: 9999px;
		background: rgba(212, 175, 55, 0.1);
		border: 1px solid var(--gold-border);
		backdrop-filter: blur(10px);
		margin-bottom: 26px;
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--gold-primary);
		box-shadow: 0 0 10px var(--gold-primary);
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(1.3); }
	}

	.badge-text {
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		font-weight: 700;
		color: var(--gold-primary);
	}

	.hero-title {
		font-size: clamp(2.3rem, 5vw, 4.2rem);
		font-weight: 800;
		line-height: 1.15;
		margin-bottom: 22px;
	}

	.hero-desc {
		font-size: clamp(1.05rem, 1.8vw, 1.25rem);
		line-height: 1.8;
		color: var(--text-secondary);
		max-width: 780px;
		margin-bottom: 38px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		margin-bottom: 56px;
		flex-wrap: wrap;
	}

	/* ============ CALCULADORA 5x1 ============ */
	.calc {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
		padding: 38px 32px;
		background: var(--bg-card);
		border: 1px solid var(--gold-border);
		text-align: center;
	}

	.calc-badge {
		display: inline-block;
		padding: 5px 14px;
		border: 1px solid var(--gold-border);
		border-radius: 9999px;
		background: rgba(212, 175, 55, 0.1);
		color: var(--gold-primary);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.16em;
	}

	.calc-title { margin: 0; font-size: clamp(1.4rem, 3vw, 1.9rem); }

	.calc-lead {
		margin: 0;
		max-width: 56ch;
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.calc-levels {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
	}

	.calc-level {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		min-width: 88px;
		padding: 12px 16px;
		border: 1px solid var(--gold-border);
		border-radius: 14px;
		background: rgba(2, 7, 18, 0.35);
		color: var(--text-secondary);
		font-family: inherit;
		cursor: pointer;
		transition: transform 0.25s ease, border-color 0.25s ease,
			background 0.25s ease, color 0.25s ease;
	}

	.calc-level:hover { transform: translateY(-2px); border-color: var(--gold-primary); }

	.calc-level.is-active {
		background: rgba(212, 175, 55, 0.16);
		border-color: var(--gold-primary);
		color: var(--text-primary);
		box-shadow: 0 0 18px rgba(212, 175, 55, 0.25);
	}

	.calc-level-num { font-size: 1.5rem; font-weight: 800; line-height: 1; }
	.calc-level.is-active .calc-level-num { color: var(--gold-primary); }
	.calc-level-name { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }

	.calc-panels { width: 100%; }

	.calc-panel {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 16px;
		animation: calc-in 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes calc-in {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: none; }
	}

	.calc-figure {
		display: flex;
		flex-direction: column;
		gap: 5px;
		padding: 20px 16px;
		border: 1px solid var(--gold-border);
		border-radius: 14px;
		background: rgba(2, 7, 18, 0.4);
	}

	/* Un dato que todavía no aplica se atenúa en vez de esconderse: así se
	   entiende que existe y cuándo entra en juego. */
	.calc-figure.is-muted { opacity: 0.55; }

	.calc-figure.is-net {
		border-color: var(--gold-primary);
		background: rgba(212, 175, 55, 0.12);
	}

	.calc-figure-label {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.calc-figure-value {
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1.1;
		color: var(--gold-primary);
	}

	.calc-figure-hint { font-size: 0.75rem; color: var(--text-secondary); }

	.calc-footnote {
		margin: 0;
		max-width: 62ch;
		font-size: 0.78rem;
		line-height: 1.65;
		color: var(--text-muted);
	}

	.calc-cta { text-decoration: none; }

	@media (max-width: 860px) {
		.calc { padding: 30px 20px; }
		.calc-level { min-width: 74px; padding: 10px 12px; }
		.calc-figure-value { font-size: 1.45rem; }
	}

	@media (max-width: 520px) {
		.calc { padding: 24px 16px; gap: 18px; }
		.calc-level { flex: 1 1 calc(50% - 10px); min-width: 0; }
		.calc-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
		.calc-figure { padding: 14px 10px; }
		.calc-figure-value { font-size: 1.3rem; }
		.calc-cta { width: 100%; }
	}

	.stats-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		align-items: center;
		padding: 30px 20px;
		background: var(--bg-card);
		border: 1px solid var(--gold-border);
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		text-align: center;
	}

	.stat-number {
		font-size: 2.1rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	@media (max-width: 860px) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 20px;
		}
	}
	@media (max-width: 520px) {
		.stats-grid {
			grid-template-columns: 1fr;
		}
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 640px) {
		.hero-section {
			padding: 52px 18px 46px;
		}

		.hero-desc {
			margin-bottom: 30px;
		}

		/* Los CTA pasan a ocupar todo el ancho para ser cómodo al tocar */
		.hero-actions {
			flex-direction: column;
			align-items: stretch;
			gap: 14px;
			margin-bottom: 42px;
		}

		.hero-actions a {
			width: 100%;
		}

		.stats-grid {
			padding: 22px 14px;
		}

		.stat-number {
			font-size: 1.7rem;
		}
	}

	@media (max-width: 360px) {
		.hero-section {
			padding: 40px 14px 36px;
		}

		.badge-text {
			font-size: 0.62rem;
			letter-spacing: 0.12em;
		}

		.stat-number {
			font-size: 1.5rem;
		}
	}
</style>
<script>
	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-calc-level]')
	);
	const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-calc-panel]'));

	/**
	 * Muestra el panel del nivel elegido.
	 *
	 * No calcula nada: los importes ya vienen en el HTML, así que la única forma
	 * de que el número cambie es que el servidor lo mande distinto.
	 */
	const select = (level: string) => {
		buttons.forEach((button) => {
			const active = button.dataset.calcLevel === level;
			button.classList.toggle('is-active', active);
			button.setAttribute('aria-pressed', String(active));
		});

		panels.forEach((panel) => {
			panel.hidden = panel.dataset.calcPanel !== level;
		});
	};

	buttons.forEach((button) => {
		const level = button.dataset.calcLevel;
		if (!level) return;
		button.addEventListener('click', () => select(level));
	});

	// Flechas del teclado para recorrer los niveles, como un grupo de pestañas.
	document.querySelector('.calc-levels')?.addEventListener('keydown', (event) => {
		const key = (event as KeyboardEvent).key;
		if (key !== 'ArrowLeft' && key !== 'ArrowRight') return;
		event.preventDefault();

		const current = buttons.findIndex((b) => b.classList.contains('is-active'));
		const step = key === 'ArrowRight' ? 1 : -1;
		const next = buttons[(current + step + buttons.length) % buttons.length];
		next?.focus();
		if (next?.dataset.calcLevel) select(next.dataset.calcLevel);
	});
</script>

