---
// HeroSection.astro
---

<section class="hero-section">
	<div class="ambient-glow"></div>
	<div class="ambient-glow-secondary"></div>

	<div class="hero-container">
		<div class="badge-pill">
			<span class="badge-dot"></span>
			<span class="badge-text font-cinzel">ELITE WEALTH & HIGH-PERFORMANCE 2026</span>
		</div>

		<h1 class="hero-title font-cinzel">
			El Estándar Supremo del <br />
			<span class="gold-gradient-text">Prestigio & Rentabilidad</span>
		</h1>

		<p class="hero-desc">
			Bienvenido a <strong>GANA PRO</strong>. Una experiencia financiera y tecnológica diseñada meticulosamente para líderes, visionarios e inversores que exigen sofisticación absoluta, seguridad blindada y rendimientos extraordinarios.
		</p>

		<div class="hero-actions">
			<a href="/register" class="gold-button">
				<span>Comenzar Ahora</span>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</a>
			<a href="/login" class="ghost-gold-button">
				<span>Ingresar a tu Cuenta</span>
			</a>
		</div>

		<!-- Stats Luxury Banner -->
		<div class="stats-grid luxury-card">
			<div class="stat-item">
				<span class="stat-number gold-gradient-text font-cinzel">$4.8B+</span>
				<span class="stat-label">Capital Gestionado</span>
			</div>
			<div class="stat-item">
				<span class="stat-number gold-gradient-text font-cinzel">99.98%</span>
				<span class="stat-label">Efectividad Algorítmica</span>
			</div>
			<div class="stat-item">
				<span class="stat-number gold-gradient-text font-cinzel">+38.4%</span>
				<span class="stat-label">Rendimiento Anual</span>
			</div>
			<div class="stat-item">
				<span class="stat-number gold-gradient-text font-cinzel">24 / 7</span>
				<span class="stat-label">Soporte Concierge VIP</span>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		position: relative;
		padding: 90px 24px 70px;
		text-align: center;
		display: flex;
		justify-content: center;
	}

	.ambient-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.ambient-glow-secondary {
		position: absolute;
		top: 150px;
		right: 10%;
		width: 450px;
		height: 350px;
		background: radial-gradient(ellipse at center, rgba(30, 58, 138, 0.25) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.hero-container {
		position: relative;
		z-index: 1;
		max-width: 980px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.badge-pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 18px;
		border-radius: 9999px;
		background: rgba(212, 175, 55, 0.1);
		border: 1px solid var(--gold-border);
		backdrop-filter: blur(10px);
		margin-bottom: 26px;
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--gold-primary);
		box-shadow: 0 0 10px var(--gold-primary);
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(1.3); }
	}

	.badge-text {
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		font-weight: 700;
		color: var(--gold-primary);
	}

	.hero-title {
		font-size: clamp(2.3rem, 5vw, 4.2rem);
		font-weight: 800;
		line-height: 1.15;
		margin-bottom: 22px;
	}

	.hero-desc {
		font-size: clamp(1.05rem, 1.8vw, 1.25rem);
		line-height: 1.8;
		color: var(--text-secondary);
		max-width: 780px;
		margin-bottom: 38px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		margin-bottom: 60px;
		flex-wrap: wrap;
	}

	.stats-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		align-items: center;
		padding: 30px 20px;
		background: var(--bg-card);
		border: 1px solid var(--gold-border);
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		text-align: center;
	}

	.stat-number {
		font-size: 2.1rem;
		font-weight: 800;
		line-height: 1.1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	@media (max-width: 860px) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 20px;
		}
	}
	@media (max-width: 520px) {
		.stats-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
