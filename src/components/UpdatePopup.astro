---
// UpdatePopup.astro — Estilo Imperio Lux
// Popup que aparece en cada visita con el último commit de GitHub.
---

<div id="update-popup-overlay" class="up-overlay" role="dialog" aria-modal="true" aria-labelledby="up-title" hidden>
  <div class="up-card">

    <!-- Close button -->
    <button id="update-popup-close" class="up-close" aria-label="Cerrar">×</button>

    <!-- Icon box -->
    <div class="up-icon-box">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2l1.09 3.26L16.5 4l-2 2.91L18 8.5l-3.41.5L14 12l-1.09-3.26L9.5 10l2-2.91L8 5.5l3.41-.5z"/>
        <path d="M19 14l.72 2.17L22 17l-2.28.83L19 20l-.72-2.17L16 17l2.28-.83z"/>
        <path d="M5 6l.5 1.5L7 8l-1.5.5L5 10l-.5-1.5L3 8l1.5-.5z"/>
      </svg>
    </div>

    <!-- Label -->
    <p class="up-label">NOVEDADES DE GANA PRO</p>

    <!-- Title -->
    <h2 id="up-title" class="up-title">El sitio se ha<br/>actualizado</h2>

    <!-- Description -->
    <p class="up-description">
      Ya está disponible la versión más reciente publicada desde GitHub.<br/>
      Recarga la página para cargar los últimos cambios.
    </p>

    <!-- Version card -->
    <div class="up-version-card" id="up-version-card">
      <div class="up-version-card-inner">
        <span class="up-version-label">VERSIÓN PUBLICADA</span>
        <div class="up-version-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; color:#d4af37;">
            <circle cx="12" cy="12" r="3"/>
            <line x1="1" y1="12" x2="9" y2="12"/>
            <line x1="15" y1="12" x2="23" y2="12"/>
          </svg>
          <span class="up-version-name" id="up-version-name">
            <!-- filled by JS -->
            <span class="up-version-skeleton"></span>
          </span>
        </div>
      </div>
    </div>

    <!-- Meta: hash + date -->
    <p class="up-meta" id="up-meta" hidden></p>

    <!-- Buttons -->
    <div class="up-actions">
      <button id="update-popup-skip" class="up-btn-ghost">Continuar</button>
      <button id="update-popup-ok" class="up-btn-gold">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        Entendido
      </button>
    </div>

  </div>
</div>

<style>
  /* ── Overlay ─────────────────────────────────────────────────── */
  .up-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: rgba(2, 6, 23, 0.78);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .up-overlay[hidden] { display: none !important; }
  .up-overlay.visible { opacity: 1; }

  /* ── Card ─────────────────────────────────────────────────────── */
  .up-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    background: #0d1629;
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: 20px;
    padding: 2.25rem 2rem 1.75rem;
    box-shadow:
      0 40px 80px rgba(0,0,0,0.7),
      0 0 0 1px rgba(255,255,255,0.04);
    transform: translateY(20px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
  }
  .up-overlay.visible .up-card {
    transform: translateY(0) scale(1);
  }

  /* ── Close ────────────────────────────────────────────────────── */
  .up-close {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.35);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }
  .up-close:hover {
    color: rgba(255,255,255,0.8);
    background: rgba(255,255,255,0.07);
  }

  /* ── Icon box ─────────────────────────────────────────────────── */
  .up-icon-box {
    width: 60px;
    height: 60px;
    background: #141e36;
    border: 1px solid rgba(212,175,55,0.22);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4af37;
    margin-bottom: 1.4rem;
    box-shadow: 0 4px 20px rgba(212,175,55,0.1);
  }

  /* ── Label ────────────────────────────────────────────────────── */
  .up-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c9993a;
    margin-bottom: 0.75rem;
  }

  /* ── Title ────────────────────────────────────────────────────── */
  .up-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 0.9rem;
    letter-spacing: -0.02em;
  }

  /* ── Description ──────────────────────────────────────────────── */
  .up-description {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.65;
    margin-bottom: 1.4rem;
  }

  /* ── Version card ─────────────────────────────────────────────── */
  .up-version-card {
    background: #111827;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    margin-bottom: 1rem;
  }
  .up-version-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .up-version-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }
  .up-version-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .up-version-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
  }

  /* skeleton */
  .up-version-skeleton {
    display: inline-block;
    width: 180px;
    height: 14px;
    border-radius: 6px;
    background: linear-gradient(90deg,
      rgba(255,255,255,0.06) 25%,
      rgba(212,175,55,0.1) 50%,
      rgba(255,255,255,0.06) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
    vertical-align: middle;
  }
  @keyframes shimmer {
    0%   { background-position: 200% center; }
    100% { background-position: -200% center; }
  }

  /* ── Meta ─────────────────────────────────────────────────────── */
  .up-meta {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .up-meta span.hash {
    font-family: 'Courier New', monospace;
    color: rgba(212,175,55,0.55);
    background: rgba(212,175,55,0.07);
    padding: 1px 6px;
    border-radius: 4px;
  }

  /* ── Actions ──────────────────────────────────────────────────── */
  .up-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .up-btn-ghost {
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.55);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.55rem 1rem;
    border-radius: 10px;
    transition: color 0.2s, background 0.2s;
  }
  .up-btn-ghost:hover {
    color: #fff;
    background: rgba(255,255,255,0.06);
  }

  .up-btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #c9993a;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.6rem 1.35rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 18px rgba(201,153,58,0.35);
  }
  .up-btn-gold:hover {
    background: #d4af37;
    transform: translateY(-1px);
    box-shadow: 0 8px 26px rgba(212,175,55,0.45);
  }
  .up-btn-gold:active { transform: translateY(0); }

  /* ── Light theme ──────────────────────────────────────────────── */
  :global([data-theme="light"]) .up-card {
    background: #f9f6ef;
    border-color: rgba(184,134,11,0.25);
    box-shadow: 0 40px 80px rgba(0,0,0,0.18);
  }
  :global([data-theme="light"]) .up-title { color: #0a1128; }
  :global([data-theme="light"]) .up-description { color: rgba(10,17,40,0.5); }
  :global([data-theme="light"]) .up-version-card {
    background: #eee9da;
    border-color: rgba(0,0,0,0.07);
  }
  :global([data-theme="light"]) .up-version-name { color: #0a1128; }
  :global([data-theme="light"]) .up-close { color: rgba(0,0,0,0.3); }
  :global([data-theme="light"]) .up-close:hover { background: rgba(0,0,0,0.07); color: #0a1128; }
  :global([data-theme="light"]) .up-icon-box { background: #ede8d8; }
  :global([data-theme="light"]) .up-btn-ghost { color: rgba(10,17,40,0.5); }
  :global([data-theme="light"]) .up-btn-ghost:hover { background: rgba(0,0,0,0.05); color: #0a1128; }
  :global([data-theme="light"]) .up-meta { color: rgba(10,17,40,0.3); }
</style>

<script>
  (async () => {
    const overlay  = document.getElementById('update-popup-overlay') as HTMLElement;
    const closeBtn = document.getElementById('update-popup-close') as HTMLButtonElement;
    const skipBtn  = document.getElementById('update-popup-skip') as HTMLButtonElement;
    const okBtn    = document.getElementById('update-popup-ok') as HTMLButtonElement;
    const versionNameEl = document.getElementById('up-version-name') as HTMLElement;
    const metaEl   = document.getElementById('up-meta') as HTMLElement;

    function open() {
      overlay.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => overlay.classList.add('visible')));
    }
    function close() {
      overlay.classList.remove('visible');
      setTimeout(() => { overlay.hidden = true; }, 320);
    }

    closeBtn.addEventListener('click', close);
    skipBtn.addEventListener('click', close);
    okBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) close(); });

    open();

    // Fetch commit data
    try {
      const resp = await fetch('/api/update-info');
      if (!resp.ok) throw new Error('err');
      const data = await resp.json() as { hash: string; message: string; date: string };

      versionNameEl.textContent = `GANA PRO — ${data.message}`;
      metaEl.innerHTML = `<span class="hash">#${data.hash}</span><span>${data.date}</span>`;
      metaEl.hidden = false;
    } catch {
      versionNameEl.textContent = 'GANA PRO — Última actualización';
    }
  })();
</script>
