---
/**
 * Barra inferior fija para móvil.
 *
 * Solo se ve en pantallas pequeñas (`display` por CSS de aquí abajo): en
 * escritorio estorbaría, porque la navegación y los botones ya están visibles.
 *
 * Se oculta sola al desplazarse hacia abajo para no tapar el contenido, y vuelve
 * a aparecer al subir. El botón principal es siempre el mismo destino que el
 * CTA del hero, para que la conversión no dependa de la posición.
 *
 * Reserva espacio al final del documento (`body`) para que la barra no tape el
 * pie de página.
 */
import { RECARGA_INICIAL_AMOUNT } from '../lib/p2p';

const fmt = (value: number) => `$${Math.round(value).toLocaleString('es-CO')}`;
---

<div class="mobile-bar" data-mobile-bar>
	<a class="mobile-cta" href="/register">
		<span class="mobile-cta-main">Crear Cuenta / Activar</span>
		<span class="mobile-cta-price">{fmt(RECARGA_INICIAL_AMOUNT)}</span>
	</a>
	<a class="mobile-login" href="/login" aria-label="Iniciar sesión">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
			<polyline points="10 17 15 12 10 7"></polyline>
			<line x1="15" y1="12" x2="3" y2="12"></line>
		</svg>
	</a>
</div>

<style is:global>
	/* Espacio para que la barra fija no tape el pie de página en móvil. */
	@media (max-width: 820px) {
		body:has(.mobile-bar) { padding-bottom: 76px; }
	}
</style>

<style>
	.mobile-bar {
		display: none;
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 80;
		gap: 10px;
		padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px));
		background: rgba(2, 7, 18, 0.94);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-top: 1px solid var(--gold-border);
		transform: translateY(0);
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* Se esconde al bajar para no comer pantalla, y vuelve al subir. */
	.mobile-bar.is-hidden { transform: translateY(110%); }

	.mobile-cta {
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 13px 18px;
		border-radius: 9999px;
		background: linear-gradient(135deg, #d4af37, #f3e5ab);
		color: #030712;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.mobile-cta:active { transform: scale(0.98); }

	.mobile-cta-main { font-size: 0.92rem; letter-spacing: 0.01em; }
	.mobile-cta-price { font-size: 0.92rem; font-weight: 800; opacity: 0.85; }

	.mobile-login {
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		width: 46px;
		border: 1px solid var(--gold-border);
		border-radius: 9999px;
		color: var(--gold-primary);
		text-decoration: none;
		transition: background 0.2s ease;
	}

	.mobile-login:hover, .mobile-login:active { background: rgba(212, 175, 55, 0.12); }

	@media (max-width: 820px) {
		.mobile-bar { display: flex; }
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-bar { transition: none; }
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>('[data-mobile-bar]');
	if (bar) {
		// `lastY` guarda la última posición conocida: si el delta es pequeño se
		// considera un rebote del dedo y no cambia la visibilidad de la barra.
		let lastY = window.scrollY;
		let ticking = false;

		const onScroll = () => {
			const y = Math.max(0, window.scrollY);
			const delta = y - lastY;

			if (Math.abs(delta) > 6) {
				bar.classList.toggle('is-hidden', delta > 0 && y > 120);
				lastY = y;
			}
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(onScroll);
			},
			{ passive: true }
		);
	}
</script>
