---
interface Props {
	links: Array<{
		href: string;
		label: string;
		icon: 'money' | 'rating' | 'about';
	}>;
}

const { links } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
	const [path, hash] = href.split('#');
	const target = path.replace(/\/+$/, '') || '/';
	if (currentPath !== target) return false;
	return !hash || Astro.url.hash === `#${hash}`;
};
---

<nav class="mobile-nav" data-mobile-nav aria-label="Navegación principal">
	{links.map((link) => (
		<a
			href={link.href}
			class:list={['mobile-nav-link', { 'is-current': isCurrent(link.href) }]}
			aria-current={isCurrent(link.href) ? 'page' : undefined}
		>
			{link.icon === 'money' && (
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="9"></circle>
					<path d="M16 8.5c-.8-.8-1.9-1.2-3.2-1.2-1.7 0-2.8.8-2.8 2s1 1.8 2.8 2.2 2.8 1 2.8 2.2-1.2 2-3 2c-1.3 0-2.5-.5-3.4-1.4M12 5.5v13"></path>
				</svg>
			)}
			{link.icon === 'rating' && (
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3z"></path>
				</svg>
			)}
			{link.icon === 'about' && (
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="9"></circle>
					<path d="M12 11v5M12 8h.01"></path>
				</svg>
			)}
			<span>{link.label}</span>
		</a>
	))}
</nav>

<style is:global>
	@media (max-width: 900px) {
		body:has([data-mobile-nav]) {
			padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px));
		}
	}
</style>

<style>
	.mobile-nav {
		display: none;
	}

	@media (max-width: 900px) {
		.mobile-nav {
			position: fixed;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 110;
			display: flex;
			justify-content: space-around;
			gap: 4px;
			padding: 8px max(12px, env(safe-area-inset-left, 0px)) calc(8px + env(safe-area-inset-bottom, 0px));
			background: rgba(2, 7, 18, 0.96);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			border-top: 1px solid var(--gold-border);
		}

		.mobile-nav-link {
			flex: 1 1 0;
			display: flex;
			min-width: 0;
			min-height: 48px;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 4px;
			color: var(--text-secondary);
			text-decoration: none;
			font-size: 0.68rem;
			font-weight: 600;
			line-height: 1.1;
			text-align: center;
			transition: color 0.2s ease;
		}

		.mobile-nav-link svg {
			width: 21px;
			height: 21px;
			flex: 0 0 21px;
		}

		.mobile-nav-link:hover,
		.mobile-nav-link.is-current {
			color: var(--gold-primary);
		}
	}
</style>
