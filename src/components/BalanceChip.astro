---
import { formatBalance, canWithdraw } from '../lib/users';

interface Props {
	/**
	 * Valor crudo de la celda "saldo acumulado" de Google Sheets.
	 * Si viene vacío o no es un número, el chip no se muestra.
	 */
	balance?: string | number | null;
	/**
	 * Nivel del usuario en Google Sheets. Si no alcanza el nivel requerido,
	 * la opción "Retirar" aparece bloqueada con el motivo.
	 */
	level?: string | null;
	/**
	 * Tipo de billetera y número con los que el usuario cobra. Se muestran
	 * solo en "Retirar" y son de solo lectura: provienen de la hoja de usuarios.
	 */
	walletType?: string | null;
	walletNumber?: string | null;
	/**
	 * Billetera del ADMINISTRADOR, a la que el usuario debe transferir al
	 * recargar. Es la que se muestra en el formulario de recarga.
	 */
	adminWalletType?: string | null;
	adminWalletNumber?: string | null;
}

const {
	balance,
	level,
	walletType,
	walletNumber,
	adminWalletType,
	adminWalletNumber,
} = Astro.props;
const label = formatBalance(balance == null ? null : String(balance));
const withdrawalAllowed = canWithdraw(level ?? null);

/** El retiro necesita una billetera registrada para poder pagarse. */
const hasWallet = Boolean(walletType && walletNumber);

/**
 * Las tres operaciones de saldo. `needsRecipient` marca las que piden el
 * usuario de destino (solo "enviar"). `requiresLevel` marca las que exigen
 * un nivel mínimo, en cuyo caso se desactivan con su motivo visible.
 */
const OPERATIONS = [
	{
		id: 'recargar',
		title: 'Recargar',
		hint: 'Envía tu comprobante y el administrador aprueba la recarga.',
		field: 'Monto a recargar',
		needsRecipient: false,
		requiresLevel: false,
	},
	{
		id: 'retirar',
		title: 'Retirar',
		hint: !withdrawalAllowed
? 'Disponible solo para nivel Oro.'
: !hasWallet
? 'Registra una billetera en tu cuenta para retirar.'
: 'Solicita un retiro; lo aprueba el administrador.',
		field: 'Monto a retirar',
		needsRecipient: false,
		requiresLevel: true,
	},
	{
		id: 'enviar',
		title: 'Enviar',
		hint: 'Transfiere saldo a otro miembro registrado.',
		field: 'Monto a enviar',
		needsRecipient: true,
		requiresLevel: false,
	},
] as const;
---

{
	label && (
		<div class="balance" data-balance>
<button
type="button"
class="balance-chip"
data-balance-toggle
aria-expanded="false"
aria-haspopup="true"
title="Saldo acumulado registrado en Google Sheets"
aria-label={`Saldo acumulado: ${label}. Opciones de saldo`}
>
<span class="balance-label">Saldo</span>
<span class="balance-value">{label}</span>
<svg
class="balance-caret"
width="12"
height="12"
viewBox="0 0 24 24"
fill="none"
stroke="currentColor"
stroke-width="3"
aria-hidden="true"
>
<polyline points="6 9 12 15 18 9"></polyline>
</svg>
</button>

<div class="balance-menu" data-balance-menu hidden>
<p class="balance-menu-title">Operaciones de saldo</p>
{OPERATIONS.map((op) => {
const locked = op.requiresLevel && !withdrawalAllowed;
return (
<button
type="button"
class="balance-op"
class:list={{ locked }}
data-op={op.id}
data-title={op.title}
data-field={op.field}
data-hint={op.hint}
data-needs-recipient={String(op.needsRecipient)}
data-requires-level={String(op.requiresLevel)}
disabled={locked}
aria-disabled={locked ? 'true' : undefined}
>
<span class="balance-op-title">
{op.title}
{locked && <span class="balance-lock" aria-label="Bloqueado">Bloqueado</span>}
</span>
<span class="balance-op-hint">{op.hint}</span>
</button>
);
})}
</div>

<form class="balance-form" data-balance-form hidden data-has-wallet={hasWallet ? '' : undefined}>
<h3 class="balance-form-title" data-form-title>Operación</h3>
<p class="balance-form-hint" data-form-hint></p>

<label class="balance-form-label" data-amount-label>Monto</label>
<input type="number" class="balance-input" data-amount min="1" step="1" placeholder="0" required />

{/* Comisión del administrador: se muestra antes de enviar para que el
    usuario sepa cuánto recibirá exactamente. */}
<div class="balance-wallet commission" data-commission hidden>
<span class="balance-wallet-label">Comisión de la plataforma (5%)</span>
<span class="balance-net">Recibirás <strong data-net-amount>$0</strong></span>
<span class="balance-wallet-note">Del monto que elijas se descuenta la comisión al aprobar el retiro.</span>
</div>

{/* Recarga: la billetera del ADMIN, a la que se debe transferir, y el
    comprobante que valida el monto. */}
<div class="balance-wallet admin" data-topup-box hidden>
<span class="balance-wallet-label">Transfiere a esta billetera</span>
<span class="balance-wallet-type">{adminWalletType || 'Billetera del administrador'}</span>
<span class="balance-wallet-number">
N.º <strong>{adminWalletNumber || 'No configurada'}</strong>
</span>

<label class="balance-form-label" for="topup-receipt">Comprobante de la transferencia</label>
<input
type="file"
class="balance-input balance-file"
id="topup-receipt"
data-receipt
accept="image/jpeg,image/png,image/webp,application/pdf"
/>
<span class="balance-wallet-note">
El administrador compara el monto con tu comprobante antes de acreditarlo.
</span>
</div>

{/* Destino del retiro: viene de la hoja de usuarios y no se edita
aquí, para que el admin pague a la billetera que el usuario
mismo registró. */}
<div class="balance-wallet" data-wallet-box hidden>
<span class="balance-wallet-label">Se enviará a tu billetera registrada</span>
<span class="balance-wallet-type">{walletType}</span>
<span class="balance-wallet-number">
N.º <strong>{walletNumber}</strong>
</span>
<span class="balance-wallet-note">
El administrador revisa y aprueba tu solicitud antes de enviar el dinero.
</span>
</div>

<label class="balance-form-label" data-to-label hidden>Usuario que recibe</label>
<input type="text" class="balance-input" data-to placeholder="usuario" autocomplete="off" hidden />

<p class="balance-form-msg" data-form-msg hidden></p>

<div class="balance-form-actions">
<button type="button" class="balance-btn ghost" data-cancel>Cancelar</button>
<button type="submit" class="balance-btn solid">Confirmar</button>
</div>
</form>

<div class="balance-backdrop" data-balance-backdrop hidden></div>
		</div>
	)
}

<script is:inline>
function initBalanceMenus() {
document.querySelectorAll('[data-balance]').forEach(function (root) {
if (!(root instanceof HTMLElement) || root.dataset.ready === '1') return;
root.dataset.ready = '1';

var toggle = root.querySelector('[data-balance-toggle]');
var menu = root.querySelector('[data-balance-menu]');
var form = root.querySelector('[data-balance-form]');
var backdrop = root.querySelector('[data-balance-backdrop]');
var amount = root.querySelector('[data-amount]');
var to = root.querySelector('[data-to]');
var toLabel = root.querySelector('[data-to-label]');
var amountLabel = root.querySelector('[data-amount-label]');
var formTitle = root.querySelector('[data-form-title]');
var formHint = root.querySelector('[data-form-hint]');
var walletBox = root.querySelector('[data-wallet-box]');
var commissionBox = root.querySelector('[data-commission]');
var topupBox = root.querySelector('[data-topup-box]');
var receiptInput = root.querySelector('[data-receipt]');
var netEl = root.querySelector('[data-net-amount]');
// El atributo data-has-wallet vive en el <form>, no en el contenedor:
// consultarlo desde root daba siempre false y la billetera no se mostraba.
var hasWallet = form ? form.getAttribute('data-has-wallet') !== null : false;
var msg = root.querySelector('[data-form-msg]');
var submitBtn = form ? form.querySelector('button[type="submit"]') : null;

if (!(toggle instanceof HTMLButtonElement)) return;
if (!(menu instanceof HTMLElement)) return;
if (!(form instanceof HTMLFormElement)) return;
if (!(amount instanceof HTMLInputElement)) return;

var currentOp = '';

function isNarrow() {
return window.matchMedia('(max-width: 480px)').matches;
}

function closeAll() {
menu.hidden = true;
form.hidden = true;
toggle.setAttribute('aria-expanded', 'false');
if (backdrop instanceof HTMLElement) backdrop.hidden = true;
}

function openMenu() {
form.hidden = true;
menu.hidden = false;
toggle.setAttribute('aria-expanded', 'true');
if (backdrop instanceof HTMLElement) backdrop.hidden = !isNarrow();
}

function showMessage(text, kind) {
if (!(msg instanceof HTMLElement)) return;
msg.textContent = text;
msg.classList.remove('ok', 'error');
msg.classList.add(kind);
msg.hidden = false;
}

toggle.addEventListener('click', function (event) {
event.stopPropagation();
if (menu.hidden && form.hidden) openMenu();
else closeAll();
});

menu.querySelectorAll('[data-op]').forEach(function (btn) {
if (!(btn instanceof HTMLButtonElement)) return;
btn.addEventListener('click', function (event) {
event.stopPropagation();
currentOp = btn.dataset.op || '';
var needsRecipient = btn.dataset.needsRecipient === 'true';
var isWithdraw = currentOp === 'retirar';

if (formTitle) formTitle.textContent = btn.dataset.title || 'Operación';
if (formHint) formHint.textContent = btn.dataset.hint || '';
if (amountLabel) amountLabel.textContent = btn.dataset.field || 'Monto';

if (to instanceof HTMLInputElement) {
to.hidden = !needsRecipient;
to.required = needsRecipient;
to.value = '';
}
if (toLabel instanceof HTMLElement) toLabel.hidden = !needsRecipient;

// La billetera solo aparece en el retiro, que es donde importa.
if (walletBox instanceof HTMLElement) walletBox.hidden = !(isWithdraw && hasWallet);
if (commissionBox instanceof HTMLElement) commissionBox.hidden = !isWithdraw;
		// La recarga necesita el comprobante; el resto de operaciones no.
			var isTopup = currentOp === 'recargar';
			if (topupBox instanceof HTMLElement) topupBox.hidden = !isTopup;
			// El comprobante es obligatorio para recargar: se marca como
			// requerido solo en ese caso para que el navegador lo exija.
			if (receiptInput instanceof HTMLInputElement) {
				receiptInput.value = '';
				receiptInput.required = isTopup;
			}

amount.value = '';
amount.focus();
if (msg instanceof HTMLElement) msg.hidden = true;

menu.hidden = true;
form.hidden = false;
});
});

// Muestra en vivo cuanto recibe el usuario tras la comision del 5 %.
var COMMISSION_RATE = 0.05;
function updateNet() {
if (!(netEl instanceof HTMLElement)) return;
var n = Number(amount.value);
if (!Number.isFinite(n) || n <= 0) { netEl.textContent = '$0'; return; }
var net = Math.round(n - Math.round(n * COMMISSION_RATE));
netEl.textContent = '$' + net.toLocaleString('es-CO');
}
amount.addEventListener('input', updateNet);
updateNet();

var cancelBtn = form.querySelector('[data-cancel]');
if (cancelBtn) cancelBtn.addEventListener('click', closeAll);
if (backdrop) backdrop.addEventListener('click', closeAll);

document.addEventListener('click', function (event) {
if (root instanceof HTMLElement && !root.contains(event.target)) closeAll();
});

document.addEventListener('keydown', function (event) {
if (event.key === 'Escape') closeAll();
});

form.addEventListener('submit', async function (event) {
event.preventDefault();

var value = Number(amount.value);
if (!Number.isFinite(value) || value <= 0) {
showMessage('Escribe un monto mayor que cero.', 'error');
return;
}

if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

try {
// La recarga envía el comprobante en multipart; el resto, JSON.
var url = '/api/balance';
var options;
if (currentOp === 'recargar') {
url = '/api/balance/topup';
var fd = new FormData();
fd.append('amount', String(value));
if (receiptInput instanceof HTMLInputElement && receiptInput.files && receiptInput.files[0]) {
fd.append('receipt', receiptInput.files[0]);
}
options = { method: 'POST', body: fd };
} else {
options = {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify({
op: currentOp,
amount: value,
to: to instanceof HTMLInputElement && !to.hidden ? to.value : undefined
})
};
}

var response = await fetch(url, options);
var data = await response.json().catch(function () { return {}; });

if (data && data.ok) {
showMessage(data.message || 'Operación realizada.', 'ok');

// El retiro no descuenta saldo todavía (lo aprueba el admin), así que solo
// recargamos cuando el saldo pudo cambiar de verdad. En cualquier caso se
// espera a que el usuario lea el mensaje antes de cerrar el panel.
// Ni recarga ni retiro acreditan al instante: ambos espera aprobacion.
var reload = currentOp !== 'retirar' && currentOp !== 'recargar';
setTimeout(function () {
if (reload) {
window.location.reload();
} else {
closeAll();
}
}, 1800);
} else {
showMessage((data && data.message) || 'No se pudo completar la operación.', 'error');
}
} catch (err) {
showMessage('Error de conexión. Inténtalo de nuevo.', 'error');
} finally {
if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
}
});
});
}

initBalanceMenus();
document.addEventListener('astro:page-load', initBalanceMenus);
</script>


<style>
	.balance {
		position: relative;
	}

	/* Chip entre el conmutador de tema y el botón de usuario. Ahora es un
	   botón porque al pulsarlo se despliegan las operaciones de saldo. */
	.balance-chip {
		display: inline-flex;
		align-items: baseline;
		gap: 7px;
		padding: 7px 14px;
		border-radius: 999px;
		background: rgba(212, 175, 55, 0.12);
		border: 1px solid var(--gold-border);
		white-space: nowrap;
		line-height: 1;
		font: inherit;
		color: inherit;
		cursor: pointer;
		transition: background 0.25s ease, border-color 0.25s ease;
	}

	.balance-chip:hover,
	.balance-chip[aria-expanded='true'] {
		background: rgba(212, 175, 55, 0.22);
		border-color: var(--gold-primary);
	}

	.balance-label {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.balance-value {
		font-family: 'Cinzel', Georgia, serif;
		font-size: 0.92rem;
		font-weight: 800;
		color: var(--gold-primary);
	}

	.balance-caret {
		align-self: center;
		color: var(--gold-primary);
		transition: transform 0.25s ease;
	}

	.balance-chip[aria-expanded='true'] .balance-caret {
		transform: rotate(180deg);
	}

	/* ---------- Menú desplegable ---------- */
	.balance-menu,
	.balance-form {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 120;
		min-width: 288px;
		padding: 10px;
		border-radius: 14px;
		background: var(--bg-surface, #0d1526);
		border: 1px solid var(--gold-border);
		box-shadow: 0 22px 50px rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.balance-menu[hidden],
	.balance-form[hidden],
	.balance-backdrop[hidden] {
		display: none;
	}

	.balance-menu-title {
		margin: 2px 6px 8px;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.balance-op {
		display: block;
		width: 100%;
		text-align: left;
		padding: 10px 12px;
		border: 0;
		border-radius: 10px;
		background: transparent;
		color: var(--text-primary);
		cursor: pointer;
		font: inherit;
		transition: background 0.2s ease;
	}

	.balance-op:hover,
	.balance-op:focus-visible {
		background: rgba(212, 175, 55, 0.16);
		outline: none;
	}

	.balance-op-title {
		display: block;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--gold-primary);
	}

	.balance-op-hint {
		display: block;
		margin-top: 2px;
		font-size: 0.74rem;
		color: var(--text-secondary);
	}

	/* Opción bloqueada por nivel insuficiente: se ve, pero no es clicable y
	   explica por qué, para que el usuario sepa qué le falta. */
	.balance-op.locked,
	.balance-op[disabled] {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.balance-op.locked:hover,
	.balance-op[disabled]:hover {
		background: transparent;
	}

	.balance-lock {
		display: inline-block;
		margin-left: 6px;
		padding: 2px 7px;
		border-radius: 999px;
		border: 1px solid var(--gold-border);
		background: rgba(212, 175, 55, 0.14);
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-secondary);
		vertical-align: middle;
	}

	/* ---------- Formulario ---------- */
	.balance-form {
		min-width: 300px;
	}

	.balance-form-title {
		margin: 2px 0 4px;
		font-family: 'Cinzel', Georgia, serif;
		font-size: 1rem;
		font-weight: 700;
		color: var(--gold-primary);
	}

	.balance-form-hint {
		margin: 0 0 12px;
		font-size: 0.76rem;
		color: var(--text-secondary);
	}

	.balance-form-label {
		display: block;
		margin-bottom: 5px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.balance-input {
		width: 100%;
		margin-bottom: 12px;
		padding: 10px 12px;
		border-radius: 10px;
		border: 1px solid var(--gold-border);
		background: rgba(2, 7, 18, 0.45);
		color: var(--text-primary);
		font: inherit;
	}

	.balance-input:focus {
		outline: none;
		border-color: var(--gold-primary);
	}

	.balance-form-msg {
		margin: 0 0 10px;
		padding: 9px 11px;
		border-radius: 8px;
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.balance-form-msg[hidden] {
		display: none;
	}

	.balance-form-msg.ok {
		color: #10b981;
		background: rgba(16, 185, 129, 0.14);
		border: 1px solid rgba(16, 185, 129, 0.4);
	}

	.balance-form-msg.error {
		color: #ef4444;
		background: rgba(239, 68, 68, 0.14);
		border: 1px solid rgba(239, 68, 68, 0.4);
	}

	/* ---------- Destino del retiro (billetera) ---------- */
	.balance-wallet {
		display: grid;
		gap: 3px;
		margin: 0 0 12px;
		padding: 11px 13px;
		border-radius: 10px;
		background: rgba(212, 175, 55, 0.08);
		border: 1px dashed var(--gold-border);
	}

	.balance-wallet[hidden] {
		display: none;
	}

	/* Bloque de la comisión: verde para el neto que recibe el usuario. */
	.balance-net {
		font-size: 0.86rem;
		color: var(--text-primary);
	}

	.balance-net strong {
		font-family: 'Cinzel', Georgia, serif;
		font-size: 1rem;
		font-weight: 800;
		color: #10b981;
	}

	.balance-wallet.admin {
		border-style: solid;
	}

	/* Campo de archivo del comprobante. */
	.balance-file {
		font-size: 0.76rem;
		padding: 8px 10px;
		cursor: pointer;
	}

	.balance-file::file-selector-button {
		margin-right: 10px;
		padding: 6px 12px;
		border: 0;
		border-radius: 8px;
		background: var(--gold-primary);
		color: #10233f;
		font: inherit;
		font-size: 0.74rem;
		font-weight: 700;
		cursor: pointer;
	}

	.balance-wallet-label {
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.balance-wallet-type {
		font-family: 'Cinzel', Georgia, serif;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--gold-primary);
	}

	.balance-wallet-number {
		font-size: 0.84rem;
		color: var(--text-primary);
		letter-spacing: 0.04em;
	}

	.balance-wallet-note {
		margin-top: 5px;
		font-size: 0.72rem;
		line-height: 1.4;
		color: var(--text-secondary);
	}

	.balance-form-actions {
		display: flex;
		gap: 8px;
	}

	.balance-btn {
		flex: 1;
		padding: 10px 12px;
		border-radius: 10px;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
		transition: filter 0.2s ease, background 0.2s ease;
	}

	.balance-btn.solid {
		border: 1px solid var(--gold-primary);
		background: var(--gold-primary);
		color: #10233f;
	}

	.balance-btn.solid:hover {
		filter: brightness(1.08);
	}

	.balance-btn.solid[disabled] {
		opacity: 0.6;
		cursor: progress;
	}

	.balance-btn.ghost {
		border: 1px solid var(--gold-border);


		background: transparent;
		color: var(--text-primary);
	}

	.balance-btn.ghost:hover {
		background: rgba(212, 175, 55, 0.12);
	}

	/* ---------- Fondo oscurecido (solo móvil) ---------- */
	.balance-backdrop {
		position: fixed;
		inset: 0;
		z-index: 110;
		background: rgba(2, 7, 18, 0.5);
	}

	/* En pantallas estrechas la palabra "Saldo" empuja al botón de usuario
	   fuera de pantalla, así que se queda solo la cifra. */
	@media (max-width: 480px) {
		.balance-chip {
padding: 6px 11px;
gap: 0;
		}

		.balance-label {
display: none;
		}

		.balance-value {
font-size: 0.82rem;
		}

		.balance-caret {
display: none;
		}

		/* En móvil el panel se ancla abajo para que el teclado no lo tape. */
		.balance-menu,
		.balance-form {
position: fixed;
left: 12px;
right: 12px;
top: auto;
bottom: 12px;
min-width: 0;
		}
	}
</style>
