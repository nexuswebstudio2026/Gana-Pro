---
/**
 * Vía 02 en detalle: cómo funciona el código de referido.
 *
 * Termina con una comparación de las dos vías porque es la decisión que el
 * visitante tiene que tomar de verdad: no "qué es cada cosa" sino "por dónde
 * empiezo". La tabla reutiliza el componente de filas del sistema visual
 * (`.data-table`), así que las dos comparaciones de la portada se leen igual.
 */
import { COMMISSION_PER_REFERRAL } from '../../lib/referrals';
import { RECARGA_INICIAL_AMOUNT } from '../../lib/p2p';

const fmt = (value: number) => `$${value.toLocaleString('es-CO')}`;

const steps = [
	{
		step: 'I',
		title: 'Obtienes tu código',
		body: 'Al crear tu cuenta se genera un código de referido y un código propio únicos. Ambos aparecen en tu panel de miembro y son el identificador de tu posición en la red.',
	},
	{
		step: 'II',
		title: 'Lo compartes',
		body: 'Tu enlace incorpora el código. Cualquier persona que se registre con él queda vinculada a tu red, sin importar si luego invita a más por su cuenta.',
	},
	{
		step: 'III',
		title: 'Se suma a tu base',
		body: 'El referido ocupa una posición de Nivel 1 bajo ti y cuenta para tus métricas. Cada referido que trae también rellena posiciones de tu constelación, así que ambas vías se alimentan entre sí.',
	},
	{
		step: 'IV',
		title: `Recibe ${fmt(COMMISSION_PER_REFERRAL)} al activarse el referido`,
		body: `El registro no genera comisión. Recibes un único pago de ${fmt(COMMISSION_PER_REFERRAL)} cuando se aprueba la recarga inicial de ${fmt(RECARGA_INICIAL_AMOUNT)} del referido.`,
	},
];

/** Comparación de las dos vías: el mismo formato de tabla que el flujo de fondos. */
const comparison = [
	{ criterion: 'Requisito', constellation: '5 posiciones completas', referrals: 'Ningún requisito previo' },
	{ criterion: 'Aporte', constellation: '$15.000 por posición', referrals: 'Ninguno' },
	{ criterion: 'Comisión', constellation: '50 % / 65 % según el nivel', referrals: `$1.000 al aprobar la recarga inicial de ${fmt(RECARGA_INICIAL_AMOUNT)}` },
	{ criterion: 'Activación', constellation: 'Exige 5 confirmaciones', referrals: `Recarga aprobada de ${fmt(RECARGA_INICIAL_AMOUNT)}` },
	{ criterion: 'Techo', constellation: 'Nivel 5 de la constelación', referrals: 'Sin tope de nivel' },
];
---

<section class="section" id="via-referidos-detalle" aria-labelledby="referidos-title">
	<div class="section-container">
		<header class="section-header">
			<span class="section-eyebrow font-cinzel">Vía 02 · Captación directa</span>
			<h2 class="section-title font-cinzel" id="referidos-title">
				Red de <span class="gold-gradient-text">referidos</span>
			</h2>
			<p class="section-subtitle">
				Mientras la Constelación funciona llenando posiciones hacia abajo, tu código de referido
				trabaja en horizontal. Ganas <strong class="accent">{fmt(COMMISSION_PER_REFERRAL)}</strong> una
				sola vez cuando cada persona activa su cuenta con la recarga inicial aprobada de
				<strong class="accent">{fmt(RECARGA_INICIAL_AMOUNT)}</strong>. El registro por sí solo no genera comisión.
			</p>
		</header>

		<div class="card panel">
			<h3 class="panel-title font-cinzel">Cómo funciona tu código de referido</h3>
			<p class="panel-intro">
				Comparte tu enlace para vincular a las personas que lo usen. La comisión se acredita cuando
				aprueban su recarga inicial de {fmt(RECARGA_INICIAL_AMOUNT)}.
			</p>

			<ol class="cycle">
				{steps.map((item) => (
					<li>
						<span class="cycle-step font-cinzel">{item.step}</span>
						<div>
							<h4 class="cycle-name font-cinzel">{item.title}</h4>
							<p>{item.body}</p>
						</div>
					</li>
				))}
			</ol>

			<p class="cycle-note">
				En la Constelación la comisión depende de llenar tus 5 posiciones. En Referidos recibes
				<strong class="accent">{fmt(COMMISSION_PER_REFERRAL)} cuando el usuario invitado completa y obtiene
				aprobación de su recarga inicial</strong>; el registro por sí solo no genera un pago.
			</p>
		</div>

		<div class="card panel">
			<h3 class="panel-title font-cinzel">Constelación frente a Referidos</h3>
			<p class="panel-intro">
				Las dos vías viven en la misma plataforma y se complementan: Referidos llena posiciones y
				Constelación las sostiene.
			</p>

			<div class="data-table" role="table" aria-label="Comparación entre constelación y referidos">
				<div class="data-row data-row--head" role="row">
					<span role="columnheader">Criterio</span>
					<span role="columnheader">Vía 01 · Constelación</span>
					<span role="columnheader">Vía 02 · Referidos</span>
				</div>
				{comparison.map((row) => (
					<div class="data-row data-row--compare" role="row">
						<span class="data-key font-cinzel" role="cell">{row.criterion}</span>
						<span role="cell" data-label="Constelación">{row.constellation}</span>
						<span class="data-in" role="cell" data-label="Referidos">{row.referrals}</span>
					</div>
				))}
			</div>

			<div class="note note--risk">
				<h4 class="note-title font-cinzel">Lo que nadie te dice</h4>
				<p>
					Las dos vías dependen de <strong class="accent">captación de personas</strong>. Ninguna
					funciona de forma pasiva: sin referidos la Constelación no se completa, y sin referidos
					la red tampoco crece.
				</p>
				<p>
					En la Constelación, quien no completa su grupo de 5 <strong class="accent">no recibe
					ningún retorno</strong> y pierde el aporte de {fmt(15_000)}. Antes de comprometer capital,
					evalúa con honestidad a cuántas personas puedes captar y sostener.
				</p>
			</div>
		</div>
	</div>
</section>
