---
/**
 * Servicios complementarios.
 *
 * El subtítulo deja claro desde el principio que no son vías de ingreso: es la
 * sección que más se confunde con las dos anteriores cuando se lee en diagonal,
 * y conviene que el propio texto lo desambigue.
 *
 * `featured` marca la tarjeta destacada y `badge` su distintivo; el resaltado se
 * decide con clases (`card--featured`, `card-badge`) para que el color lo ponga
 * la hoja de estilos y no el marcado.
 */
interface Service {
	title: string;
	body: string;
	featured?: boolean;
	badge?: string;
	icon: 'wallet' | 'chart' | 'vault';
}

const services: Service[] = [
	{
		title: 'Carteras de inversión',
		body: 'Este servicio no está disponible en el portal. La plataforma no ejecuta inversiones en divisas, metales ni otros activos desde esta sección.',
		badge: 'No disponible',
		icon: 'wallet',
	},
	{
		title: 'Analítica de mercado',
		body: 'El portal no ofrece actualmente modelos predictivos ni señales de mercado. La calculadora solo simula los movimientos definidos para la matriz 5x1.',
		badge: 'No disponible',
		icon: 'chart',
	},
	{
		title: 'Seguridad de la cuenta',
		body: 'Las contraseñas se protegen con hash PBKDF2. Esta medida protege credenciales y no representa custodia ni garantía sobre los fondos.',
		badge: 'Protección de acceso',
		icon: 'vault',
	},
];
---

<section class="section" id="servicios" aria-labelledby="servicios-title">
	<div class="section-container">
		<header class="section-header">
			<span class="section-eyebrow font-cinzel">Información del portal</span>
			<h2 class="section-title font-cinzel" id="servicios-title">
				Servicios <span class="gold-gradient-text">y disponibilidad</span>
			</h2>
			<p class="section-subtitle">
				La matriz 5x1 y las funciones del panel se describen en sus secciones. Los servicios de
				inversión y analítica que aparecen aquí no están disponibles actualmente.
			</p>
		</header>

		<div class="grid grid--3">
			{services.map((service) => (
				<article class:list={['card', { 'card--featured': service.featured }]}>
					{service.badge && <span class="card-badge">{service.badge}</span>}

					<div class="card-icon" aria-hidden="true">
						{service.icon === 'wallet' && (
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="12" y1="1" x2="12" y2="23"></line>
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
							</svg>
						)}
						{service.icon === 'chart' && (
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
								<polyline points="17 6 23 6 23 12"></polyline>
							</svg>
						)}
						{service.icon === 'vault' && (
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
							</svg>
						)}
					</div>

					<h3 class="card-title font-cinzel">{service.title}</h3>
					<p class="card-desc">{service.body}</p>
				</article>
			))}
		</div>
	</div>
</section>
