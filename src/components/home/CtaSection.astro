---
/**
 * Cierre de la portada: el último llamado a la acción.
 *
 * Los dos botones se ofrecen siempre, incluso a quien ya tiene sesión. Quien ha
 * llegado leyendo tiene aquí su salida natural, y quien ya es miembro tiene el
 * acceso al panel en la barra superior.
 */
---

<section class="section" aria-labelledby="cierre-title">
	<div class="section-container">
		<div class="card cta">
			<h2 class="cta-title font-cinzel" id="cierre-title">
				Conoce cómo funciona <span class="gold-gradient-text">la matriz 5x1</span>
			</h2>
			<p class="cta-desc">
				Revisa los requisitos, los movimientos y los escenarios de la calculadora antes de decidir
				si quieres participar.
			</p>
			<div class="cta-actions">
				<a href="/register" class="gold-button">Crear cuenta exclusiva</a>
				<a href="/login" class="ghost-gold-button">Ya soy miembro</a>
			</div>
		</div>
	</div>
</section>
