---
import type { SponsoredAd } from '../../lib/advertising';

interface Props {
	ads: SponsoredAd[];
	unavailable?: boolean;
}

const { ads, unavailable = false } = Astro.props;
---

<section class="section" id="publicidad" aria-labelledby="advertising-title">
	<div class="section-container">
		<header class="advertising-header">
			<span class="advertising-label">Publicidad y contenido patrocinado</span>
			<h2 class="advertising-title font-cinzel" id="advertising-title">
				Ideas y oportunidades <span class="gold-gradient-text">para descubrir</span>
			</h2>
		</header>

		{unavailable ? (
			<p class="advertising-empty" role="status">
				No se pudo cargar la publicidad en este momento. Inténtalo más tarde.
			</p>
		) : ads.length > 0 ? (
			<div class="advertising-grid">
				{ads.map((ad) => (
					<article class="advertising-card">
						<div class="advertising-card-heading">
							{ad.logoUrl && (
								<img class="advertising-logo" src={ad.logoUrl} alt="" loading="lazy" />
							)}
							<div>
								<span class="advertising-badge">
									{ad.category ? `Anuncio · ${ad.category}` : 'Contenido patrocinado'}
								</span>
								{ad.advertiser && <p class="advertising-advertiser">{ad.advertiser}</p>}
							</div>
						</div>
						<h3 class="advertising-ad-title">{ad.title}</h3>
						<p class="advertising-copy">{ad.description}</p>
						{ad.url && (
							<a class="advertising-link" href={ad.url} target="_blank" rel="noopener noreferrer sponsored">
								Conocer más
							</a>
						)}
					</article>
				))}
			</div>
		) : (
			<p class="advertising-empty">
				En este momento no hay contenido patrocinado disponible.
				<a href="/publicidad">Información para anunciantes</a>
			</p>
		)}
	</div>
</section>

<style>
	.advertising-header {
		margin: 0 auto 30px;
		text-align: center;
	}

	.advertising-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 20px;
	}

	.advertising-card {
		padding: clamp(20px, 4vw, 32px);
		border: 1px solid var(--gold-border);
		border-radius: 20px;
		background: var(--bg-card);
		box-shadow: var(--card-shadow);
	}

	.advertising-card-heading {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 18px;
	}

	.advertising-logo {
		width: 52px;
		height: 52px;
		flex: 0 0 52px;
		object-fit: contain;
		border-radius: 10px;
	}

	.advertising-label {
		display: inline-block;
		margin-bottom: 12px;
		color: var(--gold-primary);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.advertising-title {
		font-size: clamp(1.5rem, 4vw, 2.2rem);
	}

	.advertising-badge {
		color: var(--gold-primary);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.advertising-advertiser {
		margin-top: 4px;
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	.advertising-ad-title {
		margin-bottom: 10px;
		font-size: 1.15rem;
	}

	.advertising-copy {
		margin-bottom: 18px;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.advertising-link {
		color: var(--gold-primary);
		font-weight: 700;
		text-underline-offset: 4px;
	}

	.advertising-empty {
		padding: 24px;
		border: 1px dashed var(--gold-border);
		border-radius: 14px;
		color: var(--text-secondary);
		text-align: center;
	}

	.advertising-empty a {
		margin-left: 0.3em;
		color: var(--gold-primary);
		font-weight: 700;
		text-underline-offset: 4px;
	}
</style>
