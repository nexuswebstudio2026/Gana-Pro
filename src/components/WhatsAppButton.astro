---
/**
 * Botón flotante de soporte por WhatsApp.
 *
 * El número sale de `SUPPORT_WHATSAPP` del entorno: cambiar el número de
 * soporte no debe obligar a tocar código ni a recompilar. Si no está
 * configurado, el botón **no se pinta** — es preferible a mostrar un enlace
 * roto que mande al usuario a ninguna parte.
 */
import { getEnvValue } from '../lib/sheets';
import { whatsappLink } from '../lib/account-profile';

const supportNumber = getEnvValue('SUPPORT_WHATSAPP')?.trim() ?? '';
const href = whatsappLink(supportNumber);
const message = encodeURIComponent('Hola, necesito ayuda con GanaPro.');
---

{href && (
	<a
		class="wa-float"
		href={`${href}?text=${message}`}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Escribir a soporte por WhatsApp"
		title="Soporte por WhatsApp"
	>
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48 1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z" />
			<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24z" />
		</svg>
		<span class="wa-float-text">Soporte</span>
	</a>
)}

<style>
	.wa-float {
		position: fixed;
		bottom: 22px;
		right: 22px;
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 12px 18px 12px 14px;
		border-radius: 9999px;
		background: linear-gradient(135deg, #25d366, #128c7e);
		color: #fff;
		font-size: 13.5px;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4);
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
	}

	.wa-float:hover {
		transform: translateY(-3px) scale(1.03);
		box-shadow: 0 14px 36px rgba(37, 211, 102, 0.55);
	}

	.wa-float svg { width: 24px; height: 24px; flex: 0 0 24px; }

	/* Latido suave para que se note sin resultar invasivo. */
	.wa-float::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.55);
		animation: wa-pulse 2.6s ease-out infinite;
	}

	@keyframes wa-pulse {
		0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
		70% { box-shadow: 0 0 0 16px rgba(37, 211, 102, 0); }
		100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
	}

	@media (max-width: 520px) {
		.wa-float {
			bottom: 16px;
			right: 16px;
			padding: 12px;
		}

		/* En móvil solo el icono: ocupa menos y no tapa el contenido. */
		.wa-float-text { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.wa-float { animation: none; transition: none; }
		.wa-float::after { animation: none; }
	}
</style>
