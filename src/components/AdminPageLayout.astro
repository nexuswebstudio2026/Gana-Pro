---
import ThemeToggle from './ThemeToggle.astro';
import AdminSidebar from './AdminSidebar.astro';
import type { Session } from '../lib/session';

interface Props {
	session: Session;
	title: string;
	eyebrow: string;
	description: string;
}

const { session, title, eyebrow, description } = Astro.props;
const roleLabel = session.role || 'Admin';
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<title>{title} — GANA PRO</title>
		<script is:inline>
			const savedTheme = localStorage.getItem('gana_theme') || localStorage.getItem('theme') || 'dark';
			document.documentElement.setAttribute('data-theme', savedTheme);
		</script>
	</head>
	<body>
		<div class="dashboard-wrapper admin-layout">
			<AdminSidebar />
			<div class="dashboard-content">
				<header class="header">
					<div class="brand">
						<div class="logo-shield">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
								<path d="m9 12 2 2 4-4"></path>
							</svg>
						</div>
						<a href="/dashboard" class="brand-name font-cinzel">GANA <span class="gold-gradient-text">PRO</span></a>
					</div>
					<div class="header-actions">
						<ThemeToggle />
						<div class="user-chip">
							<div class="avatar">{session.username.charAt(0).toUpperCase()}</div>
							<div class="user-meta"><span class="user-name">{session.username}</span><span class="user-badge">{roleLabel}</span></div>
						</div>
						<form method="POST" action="/api/logout">
							<button type="submit" class="btn-logout" title="Cerrar sesión">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
									<polyline points="16 17 21 12 16 7"></polyline>
									<line x1="21" y1="12" x2="9" y2="12"></line>
								</svg>
								<span>Salir</span>
							</button>
						</form>
					</div>
				</header>
				<main class="main-content">
					<section class="module-hero luxury-card">
						<span class="eyebrow">{eyebrow}</span>
						<h1 class="font-cinzel">{title}</h1>
						<p>{description}</p>
					</section>
					<slot />
				</main>
			</div>
		</div>
	</body>
</html>

<style is:global>
	:root { --bg-primary: #0a0e17; --bg-surface: rgba(18, 25, 43, 0.75); --text-primary: #f8fafc; --text-secondary: #94a3b8; --gold-primary: #d4af37; --gold-border: rgba(212, 175, 55, 0.35); }
	:root:not([data-theme="dark"]) { --bg-primary: #f8fafc; --bg-surface: rgba(255, 255, 255, 0.85); --text-primary: #0f172a; --text-secondary: #475569; --gold-primary: #996515; --gold-border: rgba(153, 101, 21, 0.35); }
	*, *::before, *::after { box-sizing: border-box; }
	html, body { min-height: 100%; }
	body { margin: 0; min-height: 100vh; font-family: 'Montserrat', sans-serif; background: var(--bg-primary); color: var(--text-primary); }
	.font-cinzel { font-family: 'Cinzel', serif; }
	.gold-gradient-text { background: linear-gradient(135deg, #d4af37, #f3e5ab 50%, #aa7c11); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
	.luxury-card { background: var(--bg-surface); border: 1px solid var(--gold-border); border-radius: 16px; backdrop-filter: blur(16px); }
	.dashboard-wrapper { min-height: 100vh; }
	.dashboard-wrapper.admin-layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); align-items: start; }
	.dashboard-content { min-width: 0; }
	.header { display: flex; align-items: center; justify-content: space-between; padding: 16px 36px; background: var(--bg-surface); border-bottom: 1px solid var(--gold-border); position: sticky; top: 0; z-index: 50; }
	.brand { display: flex; align-items: center; gap: 12px; }
	.logo-shield { width: 36px; height: 36px; border-radius: 8px; background: rgba(212, 175, 55, 0.15); border: 1px solid var(--gold-border); display: flex; align-items: center; justify-content: center; color: var(--gold-primary); }
	.brand-name { color: var(--text-primary); font-size: 1.3rem; font-weight: 800; letter-spacing: 0.1em; text-decoration: none; }
	.header-actions, .user-chip, .user-meta { display: flex; align-items: center; }
	.header-actions { gap: 20px; }
	.user-chip { gap: 12px; padding: 6px 14px 6px 6px; background: rgba(212, 175, 55, 0.08); border: 1px solid var(--gold-border); border-radius: 9999px; }
	.avatar { width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #d4af37, #996515); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; }
	.user-meta { flex-direction: column; align-items: flex-start; gap: 2px; }
	.user-name { font-size: 13.5px; font-weight: 600; line-height: 1.2; }
	.user-badge { color: var(--gold-primary); font-size: 11px; font-weight: 600; }
	.btn-logout { display: flex; align-items: center; gap: 6px; padding: 8px 16px; background: transparent; color: var(--text-secondary); border: 1px solid var(--gold-border); border-radius: 8px; cursor: pointer; }
	.btn-logout:hover { color: #ef4444; border-color: #ef4444; }
	.main-content { width: 100%; max-width: 1200px; margin: 0 auto; padding: 36px; box-sizing: border-box; display: flex; flex-direction: column; gap: 28px; }
	.module-hero { padding: 32px 36px; }
	.eyebrow { display: block; margin-bottom: 8px; color: var(--gold-primary); font-size: 11.5px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
	.module-hero h1 { margin: 0 0 8px; font-size: 2rem; }
	.module-hero p { margin: 0; color: var(--text-secondary); font-size: 14.5px; line-height: 1.6; }
	.module-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
	.module-card { padding: 24px; }
	.module-card h2 { margin: 0 0 10px; font-size: 1.1rem; }
	.module-card p { margin: 0; color: var(--text-secondary); font-size: 14px; line-height: 1.6; }
	@media (max-width: 1024px) { .dashboard-wrapper.admin-layout { display: block; } .header { padding-left: 72px; } }
	@media (max-width: 768px) { .header { padding: 14px 20px 14px 72px; } .main-content { padding: 20px; } .module-hero { padding: 24px 20px; } }
</style>

