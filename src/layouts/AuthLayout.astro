---
import ThemeToggle from '../components/ThemeToggle.astro';
import Logo from '../components/Logo.astro';

interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" sizes="64x64" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#020712" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="GANA PRO" />
		<meta name="mobile-web-app-capable" content="yes" />
		<title>{title} — GANA PRO</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<script is:inline>
			const savedTheme = localStorage.getItem('gana_theme');
			if (savedTheme) {
				document.documentElement.setAttribute('data-theme', savedTheme);
			} else {
				document.documentElement.setAttribute('data-theme', 'dark');
			}
		</script>
	</head>
	<body>
		<div class="auth-wrapper">
			<div class="top-bar">
				<a href="/" class="back-home">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
						<line x1="19" y1="12" x2="5" y2="12"></line>
						<polyline points="12 19 5 12 12 5"></polyline>
					</svg>
					<span>Volver al Inicio</span>
				</a>
				<ThemeToggle />
			</div>

			<div class="auth-card luxury-card">
				<div class="brand">
					<div class="logo-shield">
						<Logo size={24} />
					</div>
					<h2 class="font-cinzel">GANA <span class="gold-gradient-text">PRO</span></h2>
				</div>

				<h1 class="card-title font-cinzel">{title}</h1>
				{subtitle && <p class="subtitle">{subtitle}</p>}

				<slot />
			</div>

			<p class="auth-footer">© 2026 GANA PRO • Seguridad y Privacidad Blindada</p>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-primary: #f8fafc;
		--bg-card: rgba(255, 255, 255, 0.95);
		--bg-card-border: rgba(203, 161, 53, 0.3);
		--text-primary: #0a1128;
		--text-secondary: #334155;
		--text-muted: #64748b;
		--gold-primary: #b8860b;
		--gold-gradient: linear-gradient(135deg, #cba135 0%, #fae69e 50%, #a47618 100%);
		--gold-text-gradient: linear-gradient(135deg, #a47618 0%, #d4af37 50%, #85581A 100%);
		--gold-border: rgba(203, 161, 53, 0.35);
		--font-serif: 'Cinzel', serif;
		--font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
	}

	[data-theme="dark"] {
		--bg-primary: #020712;
		--bg-card: rgba(8, 18, 44, 0.85);
		--bg-card-border: rgba(212, 175, 55, 0.35);
		--text-primary: #f8fafc;
		--text-secondary: #cbd5e1;
		--text-muted: #94a3b8;
		--gold-primary: #d4af37;
		--gold-gradient: linear-gradient(135deg, #d4af37 0%, #fff099 35%, #b5831d 70%, #fbd14b 100%);
		--gold-text-gradient: linear-gradient(135deg, #fff2a3 0%, #d4af37 50%, #e6a817 100%);
		--gold-border: rgba(212, 175, 55, 0.45);
	}

	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	html, body {
		min-height: 100%;
		font-family: var(--font-sans);
		background-color: var(--bg-primary);
		color: var(--text-primary);
		transition: background-color 0.35s ease, color 0.35s ease;
		overflow-x: hidden;
	}
	.font-cinzel { font-family: var(--font-serif); }
	.gold-gradient-text {
		background: var(--gold-text-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* iOS Safari hace auto-zoom al enfocar campos con fuente < 16px.
	   Se aplica globalmente para cubrir login, register y forgot-password. */
	@media (max-width: 900px) {
		input,
		select,
		textarea {
			font-size: 16px !important;
		}
	}

	/* Respeta el notch / barra de gestos en iPhone */
	@supports (padding: max(0px)) {
		body {
			padding-left: env(safe-area-inset-left);
			padding-right: env(safe-area-inset-right);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

<style>
	.auth-wrapper {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 24px;
		position: relative;
		background: radial-gradient(circle at 50% 25%, rgba(30, 58, 138, 0.25) 0%, transparent 60%);
	}
	.top-bar {
		position: absolute;
		top: 24px;
		left: 24px;
		right: 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
	}
	.back-home {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.back-home:hover { color: var(--gold-primary); }
	.auth-card {
		background: var(--bg-card);
		backdrop-filter: blur(20px);
		border: 1px solid var(--bg-card-border);
		border-radius: 24px;
		padding: 44px 38px;
		width: 100%;
		max-width: 440px;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
		margin: 60px 0 20px;
	}
	.brand { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
	.logo-shield {
		width: 38px;
		height: 38px;
		border-radius: 10px;
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid var(--gold-primary);
		color: var(--gold-primary);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.brand h2 { font-size: 1.35rem; font-weight: 800; }
	.card-title { font-size: 1.55rem; font-weight: 800; margin-bottom: 6px; }
	.subtitle { color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; margin-bottom: 26px; }
	.auth-footer { font-size: 0.8rem; color: var(--text-muted); text-align: center; }

	/* ============ MÓVIL ============ */
	@media (max-width: 640px) {
		.auth-wrapper {
			padding: 16px;
			justify-content: flex-start;
		}

		/* La barra superior deja de flotar para no pisar la tarjeta */
		.top-bar {
			position: static;
			margin-bottom: 26px;
			padding-top: 6px;
		}

		.auth-card {
			margin: 0 0 18px;
			padding: 32px 24px;
			border-radius: 20px;
		}

		.card-title {
			font-size: 1.35rem;
		}

		.back-home {
			font-size: 0.85rem;
		}
	}

	@media (max-width: 480px) {
		.auth-card {
			padding: 28px 18px;
		}

		/* Evitar que el email largo desborde en pantallas muy estrechas */
		.auth-footer {
			font-size: 0.75rem;
			line-height: 1.6;
		}
	}
</style>
