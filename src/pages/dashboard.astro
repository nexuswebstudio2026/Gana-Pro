---
import { validateSession } from '../lib/session';
import { getGoogleSheetUsers } from '../lib/sheets';
import { getReferralStats, COMMISSION_PER_REFERRAL, formatCOP } from '../lib/referrals';
import {
	getUserLocation,
	getLocationSheetUrl,
	getMapUrl,
	type StoredLocation,
} from '../lib/location';

import { formatAppDateTime } from '../lib/datetime';

import type { User } from '../lib/types';
import ThemeToggle from '../components/ThemeToggle.astro';
import AdminSidebar from '../components/AdminSidebar.astro';
import Logo from '../components/Logo.astro';

// SSR: this page must check cookies at request time
export const prerender = false;

const token = Astro.cookies.get('auth_session')?.value;
const session = validateSession(token);

if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

// Consultar datos detallados del usuario en Google Sheets
let userDetail: User | null = null;
try {
	const users = await getGoogleSheetUsers();
	const found = users.find(
		(u) =>
			u.username?.toLowerCase() === session.username.toLowerCase() ||
			u.email?.toLowerCase() === session.email.toLowerCase()
	);
	if (found) userDetail = found;
} catch (e) {
	console.error('Error fetching user detail in dashboard:', e);
}

const effectiveRole = (userDetail?.role || session.role || '').trim().toLowerCase();
const isAdmin = effectiveRole === 'admin' || effectiveRole === 'administrator';

// Red de referidos: código propio, cuántos han entrado y la comisión acumulada
let referrals = {
	ownCode: userDetail?.ownCode || session.username,
	referred: [] as User[],
	count: 0,
	commission: 0,
	shareUrl: '',
};
if (userDetail) {
	try {
		referrals = await getReferralStats(userDetail, Astro.url.origin);
	} catch (e) {
		console.error('Error al calcular la red de referidos:', e);
	}
} else {
	referrals.shareUrl = `${Astro.url.origin}/register?ref=${encodeURIComponent(referrals.ownCode)}`;
}
const referralLink = referrals.shareUrl || `${Astro.url.origin}/register?ref=${encodeURIComponent(referrals.ownCode)}`;

// --- Ubicación en tiempo real ---
let myLocation: StoredLocation | null = null;
let locationSheetUrl = getLocationSheetUrl();
try {
	myLocation = await getUserLocation(session.username);
	if (myLocation) locationSheetUrl = getLocationSheetUrl(myLocation.sheetId);
} catch (e) {
	console.error('Error al leer la ubicación:', e);
}
const hasLocation = myLocation !== null;
const mapUrl = hasLocation ? myLocation!.mapUrl || getMapUrl(myLocation!.lat, myLocation!.lng) : '';

// --- NIT y RUT (DIAN) ---
const docResult = Astro.url.searchParams.get('doc');
const docMessage = Astro.url.searchParams.get('msg');
const docStatus = (userDetail?.documentStatus || 'Pendiente').trim();
const nitValue = (userDetail?.nit || userDetail?.documentNumber || '').trim();
// El RUT es el único archivo: si el registro aún guarda el documento antiguo,
// se muestra como RUT para no perderlo.
const rutLink = (userDetail?.rutLink || userDetail?.documentLink || '').trim();
const rutFileName = (userDetail?.scannedRut || userDetail?.scannedDocument || 'rut.pdf').trim() || 'rut.pdf';
const isPdf = rutFileName.toLowerCase().endsWith('.pdf');
const docApproved = docStatus === 'Aprobado';
const docRejected = docStatus === 'Rechazado';
const hasRut = rutLink !== '';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" sizes="64x64" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#020712" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Montserrat:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{isAdmin ? 'Panel de Administración' : 'Panel de Miembro'} — GANA PRO</title>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'dark') {
				document.documentElement.setAttribute('data-theme', 'dark');
			} else {
				document.documentElement.removeAttribute('data-theme');
			}
		</script>
	</head>
	<body>
		<div class:list={['dashboard-wrapper', { 'admin-layout': isAdmin }]}>
			{isAdmin && <AdminSidebar />}
			<div class="dashboard-content">
				<header class="header">
				<div class="brand">
					<div class="logo-shield">
						<Logo size={22} />
					</div>
					<a href="/" class="brand-name font-cinzel">GANA <span class="gold-gradient-text">PRO</span></a>
				</div>

				<div class="header-actions">
					<ThemeToggle />
					<div class="user-chip">
						<div class="avatar">{session.username.charAt(0).toUpperCase()}</div>
						<div class="user-meta">
							<span class="user-name">{session.username}</span>
							<span class="user-badge">{userDetail?.role || session.role || 'Miembro VIP'}</span>
						</div>
					</div>
					<form method="POST" action="/api/logout">
						<button type="submit" class="btn-logout" title="Cerrar sesión">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
								<polyline points="16 17 21 12 16 7"></polyline>
								<line x1="21" y1="12" x2="9" y2="12"></line>
							</svg>
							<span>Salir</span>
						</button>
					</form>
				</div>
			</header>

			<main class="main-content" id="inicio">
				<div class="welcome-banner luxury-card">
					<div class="banner-text">
						<span class="eyebrow">{isAdmin ? 'Panel de Administración' : 'Panel de Control Exclusivo'}</span>
						<h1 class="font-cinzel">Bienvenido, <span class="gold-gradient-text">{session.username}</span></h1>
						<p class="banner-sub">Su cuenta está verificada y sincronizada con Google Sheets en tiempo real.</p>
					</div>
					<div class="banner-status">
						<div class="status-indicator">
							<span class="pulse-dot"></span>
							<span>Sesión Activa</span>
						</div>
					</div>
				</div>

				<div class="stats-grid">
					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<line x1="12" y1="1" x2="12" y2="23"></line>
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Saldo Acumulado</span>
							<h2 class="stat-value gold-gradient-text">{userDetail?.balance || ' $0'}</h2>
						</div>
					</div>

					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Nivel de Miembro</span>
							<h2 class="stat-value">Nivel {userDetail?.level || '1'}</h2>
						</div>
					</div>

					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="8.5" cy="7.5" r="4"></circle>
								<polyline points="17 11 19 13 23 9"></polyline>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Estado de Documento</span>
							<h2 class="stat-value">{userDetail?.documentStatus || 'Pendiente'}</h2>
						</div>
					</div>

					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Código Propio</span>
							<h2 class="stat-value code-pill">{userDetail?.ownCode || session.username}</h2>
						</div>
					</div>
				</div>
				<div class="luxury-card doc-box">
					<div class="doc-heading">
						<div>
							<h3 class="detail-title font-cinzel">NIT y RUT (DIAN)</h3>
							<p class="doc-lead">
								Registra tu NIT y sube el RUT emitido por la DIAN para completar la verificación de la cuenta. Puedes adjuntar una imagen o un PDF de hasta 5 MB.
							</p>
						</div>
						<span class:list={['doc-badge', {
							ok: docApproved,
							ko: docRejected,
							wait: !docApproved && !docRejected,
						}]}>{docStatus}</span>
					</div>

					{docResult === 'ok' && (
						<div class="doc-alert ok" role="status">
							RUT recibido. Queda pendiente de revisión por un administrador.
						</div>
					)}
					{docResult === 'error' && (
						<div class="doc-alert ko" role="alert">
							{docMessage || 'No se pudo guardar tu RUT.'}
						</div>
					)}
					{docResult === 'config' && (
						<div class="doc-alert ko" role="alert">
							{docMessage || 'El almacenamiento no está disponible en el servidor.'}
						</div>
					)}

					{nitValue && (
						<div class="doc-current">
							<div class="doc-current-info">
								<span class="doc-label">NIT (Identificación Tributaria DIAN)</span>
								<code class="doc-file">{nitValue}</code>
							</div>
						</div>
					)}
					{hasRut && (
						<div class="doc-current">
							<div class="doc-current-info">
								<span class="doc-label">RUT emitido por la DIAN</span>
								<code class="doc-file">{rutFileName}</code>
							</div>
							<a
								href={rutLink}
								target="_blank"
								rel="noopener noreferrer"
								class="doc-view"
							>
								{isPdf ? 'Ver PDF' : 'Ver imagen'}
							</a>
						</div>
					)}

					{docApproved ? (
						<p class="doc-note ok">
							Tu NIT y RUT fueron verificados. Si necesitas actualizarlos, vuelve a subirlos.
						</p>
					) : (
						<form method="POST" action="/api/documents" enctype="multipart/form-data" class="doc-form">
							<div class="doc-field">
								<label for="nit">NIT (Identificación Tributaria DIAN)</label>
								<input
									type="text"
									id="nit"
									name="nit"
									value={nitValue}
									placeholder="Ej: 900123456"
									inputmode="numeric"
									required
									minlength="6"
									maxlength="20"
									pattern="[0-9]*"
									title="Solo números, entre 6 y 20 dígitos"
								/>
							</div>
							<div class="doc-field">
								<label for="rut">RUT emitido por la DIAN</label>
								<input
									type="file"
									id="rut"
									name="rut"
									accept="image/jpeg,image/png,image/webp,application/pdf"
									required={!hasRut}
								/>
								<p class="doc-hint">JPG, PNG, WEBP o PDF de hasta 5 MB.</p>
							</div>
							<button type="submit" class="gold-button">
								{hasRut ? 'Actualizar NIT y RUT' : 'Subir NIT y RUT'}
							</button>
						</form>
					)}
				</div>

				<!-- ============ MI UBICACIÓN EN TIEMPO REAL ============ -->
				<div class="luxury-card doc-box loc-box" id="mi-ubicacion" data-loc-url="/api/location">
					<div class="doc-head">
						<div>
							<h3 class="detail-title font-cinzel">Mi Ubicación</h3>
							<p class="doc-hint">
								{hasLocation
									? 'Última posición registrada al ingresar a tu cuenta.'
									: 'Necesitamos tu ubicación para registrar tu acceso y actualizar la hoja de control.'}
							</p>
						</div>
						<span class="doc-status" class:list={{ wait: true, ok: false, ko: false }} data-loc-badge>
							{hasLocation ? 'Registrada' : 'Sin registrar'}
						</span>
					</div>

					<div class="loc-alert ko" role="alert" data-loc-error hidden></div>

					{hasLocation && (
						<div class="loc-grid" data-loc-box>
							<div class="loc-item">
								<span class="loc-label">Latitud</span>
								<code class="loc-value" data-loc-lat>{myLocation!.lat.toFixed(6)}</code>
							</div>
							<div class="loc-item">
								<span class="loc-label">Longitud</span>
								<code class="loc-value" data-loc-lng>{myLocation!.lng.toFixed(6)}</code>
							</div>
							<div class="loc-item">
								<span class="loc-label">Exactitud</span>
								<code class="loc-value" data-loc-acc>
									{myLocation!.accuracy !== undefined ? `± ${myLocation!.accuracy} m` : 'No reportada'}
								</code>
							</div>
							<div class="loc-item">
								<span class="loc-label">Registrado</span>
								<code class="loc-value" data-loc-date>
									{myLocation!.date ? formatAppDateTime(myLocation!.date) : '—'}
								</code>
							</div>
						</div>
					)}

					<div class="doc-actions">
						<button type="button" class="gold-button" data-loc-btn>
							{hasLocation ? 'Actualizar mi ubicación' : 'Compartir mi ubicación'}
						</button>
						{hasLocation && (
							<a href={mapUrl} target="_blank" rel="noopener noreferrer" class="doc-view">
								Ver en Google Maps
							</a>
						)}
					</div>

					{hasLocation && (
						<code class="loc-url" data-loc-url-link>{mapUrl}</code>
					)}

					<a
						href={locationSheetUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="doc-note"
					>
						Ver la hoja de ubicaciones en Google Sheets →
					</a>
				</div>

				<div class="luxury-card referral-box">
					<h3 class="detail-title font-cinzel">Mi Red de Referidos</h3>
					<p class="referral-lead">
						Comparte tu enlace. Cada persona que se registre con tu código suma
						<strong>{formatCOP(COMMISSION_PER_REFERRAL)}</strong> de una sola vez a tu comisión, sin
						exigirte a ti nada más.
					</p>

					<div class="referral-codes">
						<div class="referral-code-item">
							<span class="referral-label">Tu código de referido</span>
							<code class="referral-code">{referrals.ownCode}</code>
						</div>
						<div class="referral-code-item">
							<span class="referral-label">Tu enlace de invitación</span>
							<code class="referral-link">{referralLink}</code>
						</div>
					</div>

					<div class="referral-totals">
						<div class="referral-total">
							<span class="referral-total-value font-cinzel">{referrals.count}</span>
							<span class="referral-total-label">Referidos registrados</span>
						</div>
						<div class="referral-total">
							<span class="referral-total-value font-cinzel gold-gradient-text">{formatCOP(referrals.commission)}</span>
							<span class="referral-total-label">Comisión acumulada (pago único)</span>
						</div>
					</div>

					{referrals.count > 0 ? (
						<ul class="referred-list">
							{referrals.referred.map((u) => (
								<li>
									<span class="referred-avatar" aria-hidden="true">
										{(u.username || '?').charAt(0).toUpperCase()}
									</span>
									<span class="referred-name">{u.username}</span>
									<span class="referred-commission">{formatCOP(COMMISSION_PER_REFERRAL)}</span>
								</li>
							))}
						</ul>
					) : (
						<p class="referral-empty">
							Todavía no tienes referidos. Comparte tu enlace para empezar a acumular tu primera comisión de
							{formatCOP(COMMISSION_PER_REFERRAL)}.
						</p>
					)}
				</div>

				<div class="details-grid">
					<div class="detail-card luxury-card">
						<h3 class="detail-title font-cinzel">Información de la Cuenta</h3>
						<div class="info-list">
							<div class="info-row">
								<span class="info-label">Usuario</span>
								<span class="info-val">{session.username}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Correo Electrónico</span>
								<span class="info-val">{session.email}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Rol del Sistema</span>
								<span class="info-val role-badge">{userDetail?.role || session.role || 'User'}</span>
							</div>
							{userDetail?.documentType && (
								<div class="info-row">
									<span class="info-label">Documento</span>
									<span class="info-val">{userDetail.documentType}: {userDetail.documentNumber}</span>
								</div>
							)}
							{userDetail?.registeredAt && (
								<div class="info-row">
									<span class="info-label">Fecha de Registro</span>
									<span class="info-val">{userDetail.registeredAt}</span>
								</div>
							)}
						</div>
					</div>

					<div class="detail-card luxury-card">
						<h3 class="detail-title font-cinzel">Billetera y Pagos</h3>
						<div class="info-list">
							<div class="info-row">
								<span class="info-label">Método de Pago</span>
								<span class="info-val">{userDetail?.paymentMethod || 'No configurado'}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Número de Cuenta / Celular</span>
								<span class="info-val">{userDetail?.walletNumber || 'Sin vincular'}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Base de Datos</span>
								<span class="info-val text-gold">Google Sheets (En Vivo)</span>
							</div>
						</div>
					</div>
				</div>
			</main>
			</div>
		</div>
	<script>
		// Pide la ubicación al navegador y la envía al servidor.
		// Los navegadores exigen un clic del usuario para conceder el permiso.
		const locBox = document.querySelector<HTMLElement>('#mi-ubicacion');
		const locBtn = document.querySelector<HTMLButtonElement>('[data-loc-btn]');
		const locError = document.querySelector<HTMLElement>('[data-loc-error]');

		function locFail(message: string): void {
			if (!locError) return;
			locError.textContent = message;
			locError.hidden = false;
		}

		async function sendLocation(lat: number, lng: number, accuracy: number): Promise<void> {
			const res = await fetch((locBox && locBox.dataset.locUrl) || '/api/location', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ lat, lng, accuracy, source: 'gps' }),
			});
			if (!res.ok) throw new Error('No se pudo guardar la ubicación en la hoja.');
		}

		if (locBtn) {
			locBtn.addEventListener('click', () => {
				if (!('geolocation' in navigator)) {
					locFail('Tu navegador no admite la geolocalización.');
					return;
				}

				locBtn.disabled = true;
				locBtn.textContent = 'Obteniendo ubicación…';

				navigator.geolocation.getCurrentPosition(
					async (pos) => {
						try {
							await sendLocation(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy);
							// Se recarga para pintar la tarjeta con los datos ya leídos de la hoja
							window.location.reload();
						} catch (err) {
							locFail(err instanceof Error ? err.message : 'Error al guardar la ubicación.');
							locBtn.disabled = false;
							locBtn.textContent = 'Reintentar';
						}
					},
					(err) => {
						const mensajes: Record<number, string> = {
							1: 'Permiso denegado. Actívalo desde el candado de la barra de direcciones.',
							2: 'No se pudo determinar tu posición. Revisa que el GPS esté encendido.',
							3: 'La solicitud tardó demasiado. Intenta de nuevo.',
						};
						locFail(mensajes[err.code] || 'No se pudo obtener la ubicación.');
						locBtn.disabled = false;
						locBtn.textContent = 'Reintentar';
					},
					{ enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
				);
			});
		}

		// Si el permiso ya estaba concedido en visitas anteriores,
		// la ubicación se refresca sola en cada ingreso.
		if (locBox && navigator.permissions && navigator.permissions.query) {
			navigator.permissions
				.query({ name: 'geolocation' })
				.then((status) => {
					if (status.state !== 'granted' || locBox.dataset.locAuto === 'done') return;
					locBox.dataset.locAuto = 'done';
					navigator.geolocation.getCurrentPosition(
						(pos) => {
							sendLocation(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy).catch(
								() => undefined
							);
						},
						() => undefined,
						{ enableHighAccuracy: true, timeout: 10000 }
					);
				})
				.catch(() => undefined);
		}
	</script>

	</body>
</html>




<style>
	:root {
		--bg-primary: #0a0e17;
		--bg-surface: rgba(18, 25, 43, 0.75);
		--text-primary: #f8fafc;
		--text-secondary: #94a3b8;
		--gold-primary: #d4af37;
		--gold-border: rgba(212, 175, 55, 0.35);
	}
	:root:not([data-theme="dark"]) {
		--bg-primary: #f8fafc;
		--bg-surface: rgba(255, 255, 255, 0.85);
