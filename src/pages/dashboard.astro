---
import { validateSession } from '../lib/session';
import { getGoogleSheetUsers } from '../lib/sheets';
import type { User } from '../lib/types';
import ThemeToggle from '../components/ThemeToggle.astro';
import AdminSidebar from '../components/AdminSidebar.astro';

// SSR: this page must check cookies at request time
export const prerender = false;

const token = Astro.cookies.get('auth_session')?.value;
const session = validateSession(token);

if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

// Consultar datos detallados del usuario en Google Sheets
let userDetail: User | null = null;
try {
	const users = await getGoogleSheetUsers();
	const found = users.find(
		(u) =>
			u.username?.toLowerCase() === session.username.toLowerCase() ||
			u.email?.toLowerCase() === session.email.toLowerCase()
	);
	if (found) userDetail = found;
} catch (e) {
	console.error('Error fetching user detail in dashboard:', e);
}

const effectiveRole = (userDetail?.role || session.role || '').trim().toLowerCase();
const isAdmin = effectiveRole === 'admin' || effectiveRole === 'administrator';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Montserrat:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{isAdmin ? 'Panel de Administración' : 'Panel de Miembro'} — GANA PRO</title>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'dark') {
				document.documentElement.setAttribute('data-theme', 'dark');
			} else {
				document.documentElement.removeAttribute('data-theme');
			}
		</script>
	</head>
	<body>
		<div class:list={['dashboard-wrapper', { 'admin-layout': isAdmin }]}>
			{isAdmin && <AdminSidebar />}
			<div class="dashboard-content">
				<header class="header">
				<div class="brand">
					<div class="logo-shield">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							<path d="m9 12 2 2 4-4"></path>
						</svg>
					</div>
					<a href="/" class="brand-name font-cinzel">GANA <span class="gold-gradient-text">PRO</span></a>
				</div>

				<div class="header-actions">
					<ThemeToggle />
					<div class="user-chip">
						<div class="avatar">{session.username.charAt(0).toUpperCase()}</div>
						<div class="user-meta">
							<span class="user-name">{session.username}</span>
							<span class="user-badge">{userDetail?.role || session.role || 'Miembro VIP'}</span>
						</div>
					</div>
					<form method="POST" action="/api/logout">
						<button type="submit" class="btn-logout" title="Cerrar sesión">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
								<polyline points="16 17 21 12 16 7"></polyline>
								<line x1="21" y1="12" x2="9" y2="12"></line>
							</svg>
							<span>Salir</span>
						</button>
					</form>
				</div>
			</header>

			<main class="main-content" id="inicio">
				<div class="welcome-banner luxury-card">
					<div class="banner-text">
						<span class="eyebrow">{isAdmin ? 'Panel de Administración' : 'Panel de Control Exclusivo'}</span>
						<h1 class="font-cinzel">Bienvenido, <span class="gold-gradient-text">{session.username}</span></h1>
						<p class="banner-sub">Su cuenta está verificada y sincronizada con Google Sheets en tiempo real.</p>
					</div>
					<div class="banner-status">
						<div class="status-indicator">
							<span class="pulse-dot"></span>
							<span>Sesión Activa</span>
						</div>
					</div>
				</div>

				<div class="stats-grid">
					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<line x1="12" y1="1" x2="12" y2="23"></line>
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Saldo Acumulado</span>
							<h2 class="stat-value gold-gradient-text">{userDetail?.balance || ' $0'}</h2>
						</div>
					</div>

					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Nivel de Miembro</span>
							<h2 class="stat-value">Nivel {userDetail?.level || '1'}</h2>
						</div>
					</div>

					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="8.5" cy="7.5" r="4"></circle>
								<polyline points="17 11 19 13 23 9"></polyline>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Estado de Documento</span>
							<h2 class="stat-value">{userDetail?.documentStatus || 'Pendiente'}</h2>
						</div>
					</div>

					<div class="stat-card luxury-card">
						<div class="stat-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
							</svg>
						</div>
						<div class="stat-info">
							<span class="stat-label">Código Propio</span>
							<h2 class="stat-value code-pill">{userDetail?.ownCode || session.username}</h2>
						</div>
					</div>
				</div>
				<div class="details-grid">
					<div class="detail-card luxury-card">
						<h3 class="detail-title font-cinzel">Información de la Cuenta</h3>
						<div class="info-list">
							<div class="info-row">
								<span class="info-label">Usuario</span>
								<span class="info-val">{session.username}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Correo Electrónico</span>
								<span class="info-val">{session.email}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Rol del Sistema</span>
								<span class="info-val role-badge">{userDetail?.role || session.role || 'User'}</span>
							</div>
							{userDetail?.documentType && (
								<div class="info-row">
									<span class="info-label">Documento</span>
									<span class="info-val">{userDetail.documentType}: {userDetail.documentNumber}</span>
								</div>
							)}
							{userDetail?.registeredAt && (
								<div class="info-row">
									<span class="info-label">Fecha de Registro</span>
									<span class="info-val">{userDetail.registeredAt}</span>
								</div>
							)}
						</div>
					</div>

					<div class="detail-card luxury-card">
						<h3 class="detail-title font-cinzel">Billetera y Pagos</h3>
						<div class="info-list">
							<div class="info-row">
								<span class="info-label">Método de Pago</span>
								<span class="info-val">{userDetail?.paymentMethod || 'No configurado'}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Número de Cuenta / Celular</span>
								<span class="info-val">{userDetail?.walletNumber || 'Sin vincular'}</span>
							</div>
							<div class="info-row">
								<span class="info-label">Base de Datos</span>
								<span class="info-val text-gold">Google Sheets (En Vivo)</span>
							</div>
						</div>
					</div>
				</div>
			</main>
			</div>
		</div>
	</body>
</html>




<style>
	:root {
		--bg-primary: #0a0e17;
		--bg-surface: rgba(18, 25, 43, 0.75);
		--text-primary: #f8fafc;
		--text-secondary: #94a3b8;
		--gold-primary: #d4af37;
		--gold-border: rgba(212, 175, 55, 0.35);
	}
	:root:not([data-theme="dark"]) {
		--bg-primary: #f8fafc;
		--bg-surface: rgba(255, 255, 255, 0.85);
		--text-primary: #0f172a;
		--text-secondary: #475569;
		--gold-primary: #996515;
		--gold-border: rgba(153, 101, 21, 0.35);
	}
	body {
		margin: 0;
		font-family: 'Montserrat', sans-serif;
		background: var(--bg-primary);
		color: var(--text-primary);
		min-height: 100vh;
	}
	.font-cinzel { font-family: 'Cinzel', serif; }
	.gold-gradient-text {
		background: linear-gradient(135deg, #d4af37 0%, #f3e5ab 50%, #aa7c11 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.text-gold { color: var(--gold-primary); font-weight: 600; }
	.luxury-card {
		background: var(--bg-surface);
		backdrop-filter: blur(16px);
		border: 1px solid var(--gold-border);
		border-radius: 16px;
	}
	.dashboard-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
	.dashboard-wrapper.admin-layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); align-items: start; }
	.dashboard-content { min-width: 0; }
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 36px;
		background: var(--bg-surface);
		border-bottom: 1px solid var(--gold-border);
		position: sticky;
		top: 0;
		z-index: 50;
	}
	.brand { display: flex; align-items: center; gap: 12px; }
	.logo-shield {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid var(--gold-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gold-primary);
	}
	.brand-name {
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-decoration: none;
		color: var(--text-primary);
	}
	.header-actions { display: flex; align-items: center; gap: 20px; }
	.user-chip {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 6px 14px 6px 6px;
		background: rgba(212, 175, 55, 0.08);
		border: 1px solid var(--gold-border);
		border-radius: 9999px;
	}
	.avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: linear-gradient(135deg, #d4af37, #996515);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 14px;
	}
	.user-meta { display: flex; flex-direction: column; }
	.user-name { font-size: 13.5px; font-weight: 600; line-height: 1.2; }
	.user-badge { font-size: 11px; color: var(--gold-primary); font-weight: 600; }
	.btn-logout {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 8px 16px;
		background: transparent;
		color: var(--text-secondary);
		border: 1px solid var(--gold-border);
		border-radius: 8px;
		cursor: pointer;
	}
	.btn-logout:hover { color: #ef4444; border-color: #ef4444; }
	.main-content {
		padding: 36px;
		max-width: 1200px;
		margin: 0 auto;
		width: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
	.welcome-banner {
		padding: 32px 36px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 11.5px;
		font-weight: 700;
		color: var(--gold-primary);
		margin-bottom: 8px;
		display: block;
	}
	.welcome-banner h1 { margin: 0 0 8px 0; font-size: 2rem; font-weight: 800; }
	.banner-sub { margin: 0; color: var(--text-secondary); font-size: 14.5px; }
	.status-indicator {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.3);
		color: #10b981;
		border-radius: 9999px;
		font-size: 13px;
		font-weight: 600;
	}
	.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; }
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
	}
	.stat-card { padding: 24px; display: flex; align-items: center; gap: 18px; }
	.stat-icon {
		width: 50px;
		height: 50px;
		border-radius: 12px;
		background: rgba(212, 175, 55, 0.1);
		border: 1px solid var(--gold-border);
		color: var(--gold-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.stat-label { display: block; font-size: 12.5px; color: var(--text-secondary); margin-bottom: 6px; }
	.stat-value { margin: 0; font-size: 1.45rem; font-weight: 700; }
	.code-pill { font-family: monospace; background: rgba(212, 175, 55, 0.15); padding: 2px 8px; border-radius: 6px; }
	.details-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
		gap: 24px;
	}
	.detail-card { padding: 28px; }
	.detail-title { margin: 0 0 20px 0; font-size: 1.2rem; border-bottom: 1px solid var(--gold-border); padding-bottom: 12px; }
	.info-list { display: flex; flex-direction: column; gap: 16px; }
	.info-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
		border-bottom: 1px solid rgba(212, 175, 55, 0.1);
		font-size: 14px;
	}
	.info-row:last-child { border-bottom: none; padding-bottom: 0; }
	.info-label { color: var(--text-secondary); }
	.info-val { font-weight: 600; }
	.role-badge {
		background: rgba(212, 175, 55, 0.15);
		color: var(--gold-primary);
		padding: 4px 10px;
		border-radius: 6px;
		font-size: 12px;
	}
	@media (max-width: 1024px) {
		.dashboard-wrapper.admin-layout { display: block; }
		.header { padding-left: 72px; }
	}
	@media (max-width: 768px) {
		.header { padding: 14px 20px 14px 72px; }
		.main-content { padding: 20px; }
		.welcome-banner { flex-direction: column; align-items: flex-start; gap: 16px; }
		.details-grid { grid-template-columns: 1fr; }
	}

	/* ============ MÓVIL PEQUEÑO ============ */
	@media (max-width: 520px) {
		/* El chip de usuario + toggle + salir no caben en una fila */
		.header-actions { gap: 10px; }
		.user-meta { display: none; }
		.user-chip { padding: 5px; }
		.brand-name { font-size: 1.1rem; }
		.btn-logout { padding: 8px 12px; }
		.btn-logout span { display: none; }

		.main-content { padding: 16px; gap: 20px; }
		.welcome-banner { padding: 22px 18px; }
		.welcome-banner h1 { font-size: 1.5rem; }

		/* minmax(240px) desborda en pantallas de 320px */
		.stats-grid { grid-template-columns: 1fr; gap: 14px; }
		.stat-card { padding: 18px; gap: 14px; }
		.stat-value { font-size: 1.2rem; }

		.detail-card { padding: 20px 16px; }
		.detail-title { font-size: 1.05rem; }

		/* Las filas de datos se apilan para evitar desbordes */
		.info-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 4px;
		}
	}
</style>