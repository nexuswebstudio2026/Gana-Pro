---
import AuthLayout from '../layouts/AuthLayout.astro';

// SSR: query params are read at request time
export const prerender = false;

const error = Astro.url.searchParams.get('error');
---

<AuthLayout title="Membresía Exclusiva" subtitle="Complete sus datos para solicitar su cuenta en GANA PRO">
	{error && (
		<div class="msg msg-error">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<span>{error}</span>
		</div>
	)}

	<form method="POST" action="/api/register" class="form">
		<div class="field">
			<label for="username">Nombre de Usuario VIP</label>
			<input
				type="text"
				id="username"
				name="username"
				placeholder="alexander_v"
				required
				minlength="3"
				pattern="[a-zA-Z0-9_]+"
				title="Solo letras, números y guion bajo (mínimo 3 caracteres)"
				autofocus
			/>
		</div>

		<div class="field">
			<label for="email">Correo Electrónico Corporativo / Personal</label>
			<input
				type="email"
				id="email"
				name="email"
				placeholder="inversionista@empresa.com"
				required
			/>
		</div>

		<div class="field">
			<label for="password">Contraseña Cifrada (Mínimo 6 caracteres)</label>
			<input
				type="password"
				id="password"
				name="password"
				placeholder="••••••••••••"
				required
				minlength="6"
			/>
		</div>

		<div class="field">
			<label for="passwordConfirm">Confirmar Contraseña</label>
			<input
				type="password"
				id="passwordConfirm"
				name="passwordConfirm"
				placeholder="••••••••••••"
				required
				minlength="6"
			/>
		</div>

		<button type="submit" class="gold-button btn-full">
			<span>Registrar y Activar Membresía</span>
			<span>→</span>
		</button>
	</form>

	<div class="links">
		<a href="/login" class="auth-link gold-link">¿Ya es miembro distinguido? Inicie sesión</a>
	</div>
</AuthLayout>

<style>
	.msg {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		border-radius: 12px;
		font-size: 13.5px;
		margin-bottom: 22px;
		line-height: 1.5;
	}

	.msg-error {
		background: rgba(239, 68, 68, 0.12);
		color: #ef4444;
		border: 1px solid rgba(239, 68, 68, 0.35);
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin-bottom: 24px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.field label {
		font-size: 13px;
		font-weight: 600;
		color: var(--text-secondary);
		letter-spacing: 0.02em;
	}

	.field input {
		padding: 13px 16px;
		background: rgba(15, 23, 42, 0.05);
		border: 1px solid var(--gold-border);
		border-radius: 12px;
		font-size: 14.5px;
		color: var(--text-primary);
		font-family: inherit;
		transition: all 0.25s ease;
	}

	:global([data-theme="dark"]) .field input {
		background: rgba(4, 11, 28, 0.6);
	}

	.field input:focus {
		outline: none;
		border-color: var(--gold-primary);
		box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
	}

	.btn-full {
		width: 100%;
		padding: 14px;
		font-size: 0.95rem;
		border: 1px solid rgba(255, 235, 150, 0.6);
		margin-top: 8px;
	}

	.links {
		font-size: 13.5px;
		text-align: center;
	}

	.auth-link {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.gold-link {
		color: var(--gold-primary);
		font-weight: 600;
	}

	.gold-link:hover {
		text-decoration: underline;
	}
</style>
