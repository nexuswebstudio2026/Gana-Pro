---
import AuthLayout from '../layouts/AuthLayout.astro';
import { DOCUMENT_TYPES } from '../lib/testimonials';
import { lookupReferrer, ownCodeOf } from '../lib/referrals';

// SSR: query params are read at request time
export const prerender = false;

const error = Astro.url.searchParams.get('error');
// Si llegaron con /registrarusuario/cod=Ankamo, se extrae el código de referido.
let referralCode = (Astro.url.searchParams.get('ref') ?? '').trim().slice(0, 60);

if (!referralCode) {
    const newFormatMatch = Astro.url.pathname.match(/\/registrarusuario\/cod=(.+)/);
    if (newFormatMatch) {
        referralCode = newFormatMatch[1].trim().slice(0, 60);
    }
}
// El código que viene del enlace se comprueba contra la hoja ANTES de pintar
// el formulario: si quien invitó no está registrado, se avisa en el mismo
// momento en que se abre la página en lugar de dejar que el usuario llene
// todo el formulario para rechazarlo después en `/api/register`.
// Si la hoja no responde, `unavailable` muestra un aviso distinto sin afirmar
// que el usuario no existe.
const lookup = referralCode ? await lookupReferrer(referralCode) : null;
const refInvalid = lookup?.status === 'missing';
const refUnavailable = lookup?.status === 'unavailable';
const refLocked = lookup?.status === 'found';
if (refLocked && lookup?.user) {
	referralCode = ownCodeOf(lookup.user);
}
// Si el registro se rechazó por un tipo de documento no válido, se repone el
// que el usuario había elegido en vez de dejar el select en el primer valor.
const tipoDoc = Astro.url.searchParams.get('tipoDocumento') ?? '';
---

<AuthLayout title="Membresía Exclusiva" subtitle="Complete sus datos para solicitar su cuenta en GANA PRO">
	{error && (
		<div class="msg msg-error">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<span>{error}</span>
		</div>
	)}

	{/* El enlace de referido apunta a alguien que no tiene cuenta: se avisa
	    aquí mismo y el campo queda editable para corregirlo o vaciarlo. */}
	{refInvalid && (
		<div class="msg msg-error" role="alert">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<span>
				El usuario «{referralCode}» no está registrado. Verifica el código de
				referido o regístrate sin él.
			</span>
		</div>
	)}

	{refUnavailable && (
		<div class="msg msg-error" role="alert">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<span>No se pudo verificar el código de referido en este momento. Intenta de nuevo más tarde.</span>
		</div>
	)}

	<form method="POST" action="/api/register" class="form">
		<div class="field">
			<label for="username">Nombre de Usuario VIP</label>
			<input
				type="text"
				id="username"
				name="username"
				placeholder="alexander_v"
				required
				minlength="3"
				pattern="[a-zA-Z0-9_]+"
				title="Solo letras, números y guion bajo (mínimo 3 caracteres)"
				autofocus
			/>
		</div>

		<div class="field">
			<label for="email">Correo Electrónico Corporativo / Personal</label>
			<input
				type="email"
				id="email"
				name="email"
				placeholder="inversionista@empresa.com"
				required
			/>
		</div>

		<div class="field">
			<label for="password">Contraseña Cifrada (Mínimo 6 caracteres)</label>
			<input
				type="password"
				id="password"
				name="password"
				placeholder="••••••••••••"
				required
				minlength="6"
			/>
		</div>

		<div class="field">
			<label for="passwordConfirm">Confirmar Contraseña</label>
			<input
				type="password"
				id="passwordConfirm"
				name="passwordConfirm"
				placeholder="••••••••••••"
				required
				minlength="6"
			/>
		</div>

		<div class="field">
			<label for="ref">
				Código de Referido {refLocked
					? '(de quien te invitó)'
					: refInvalid
						? '(no registrado)'
						: refUnavailable
							? '(pendiente de verificación)'
							: '(opcional)'}
			</label>
			<div class="input-lock" id="ref-container">
				<input
					type="text"
					id="ref"
					name="ref"
					value={referralCode}
					placeholder={refLocked ? '' : 'Si alguien te invitó, escribe su código'}
					maxlength="60"
					autocomplete="off"
					readonly={refLocked ? true : undefined}
					aria-readonly={refLocked ? 'true' : undefined}
				/>
				{refLocked && (
					<svg
						class="lock-icon"
						width="15"
						height="15"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
						<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
					</svg>
				)}
			</div>
			{/* Marca el origen del código: el API solo conserva en la URL de error
			    el que vino del enlace, para no bloquear uno escrito a mano. */}
			{refLocked && <input type="hidden" name="refFromLink" value="1" />}
			<span class="field-hint" id="ref-hint">
				{refInvalid
					? 'Nadie usa todavía ese código: corrígelo o déjalo vacío para continuar.'
					: refUnavailable
						? 'No pudimos verificar este código. Puedes volver a intentarlo más tarde o quitarlo.'
						: refLocked
							? 'Código de tu invitador: se muestra tal cual y no se puede modificar.'
							: 'Por cada persona que se registre con tu código ganas $1.000 (una sola vez).'}
			</span>
		</div>

		<div class="section-divider" role="separator">
			<span>Datos de contacto</span>
		</div>

		<div class="field">
			<label for="tipoDocumento">Tipo de Documento de Identidad</label>
			<select
				id="tipoDocumento"
				name="tipoDocumento"
				required
				value={tipoDoc}
			>
				<option value="" disabled selected={!tipoDoc}>Selecciona una opción</option>
				{DOCUMENT_TYPES.map((tipo) => (
					<option value={tipo.code} selected={tipoDoc === tipo.code}>
						{tipo.code} — {tipo.label}
					</option>
				))}
			</select>
			<span class="field-hint">Documento con el que te identificas ante el negocio.</span>
		</div>

		<div class="field">
			<label for="numeroDocumento">Número de Documento</label>
			<input
				type="text"
				id="numeroDocumento"
				name="numeroDocumento"
				placeholder="Ej: 1020304050"
				minlength="6"
				maxlength="20"
				required
				inputmode="numeric"
				autocomplete="off"
			/>
			<span class="field-hint">Solo números, entre 6 y 20 dígitos.</span>
		</div>

		<div class="field">
			<label for="address">Dirección de Residencia</label>
			<input
				type="text"
				id="address"
				name="address"
				placeholder="Calle 100 # 50-30"
				maxlength="160"
				required
				autocomplete="street-address"
			/>
		</div>

		<div class="field">
			<label for="neighborhood">Barrio</label>
			<input
				type="text"
				id="neighborhood"
				name="neighborhood"
				placeholder="El Poblado"
				maxlength="80"
				required
			/>
		</div>

		<div class="field">
			<label for="city">Ciudad de Residencia</label>
			<input
				type="text"
				id="city"
				name="city"
				placeholder="Medellín"
				maxlength="80"
				required
				autocomplete="address-level2"
			/>
		</div>

		<div class="field">
			<label for="phone">Teléfono de Contacto</label>
			<input
				type="tel"
				id="phone"
				name="phone"
				placeholder="300 123 4567"
				maxlength="30"
				required
				inputmode="tel"
				autocomplete="tel"
			/>
			<span class="field-hint">Solo números y los signos + ( ) - (de 7 a 15 dígitos).</span>
		</div>

		<div class="field">
			<label for="whatsapp">Contacto de WhatsApp</label>
			<input
				type="tel"
				id="whatsapp"
				name="whatsapp"
				placeholder="311 765 4321"
				maxlength="30"
				required
				inputmode="tel"
				autocomplete="tel"
			/>
			<span class="field-hint">Solo números y los signos + ( ) - (de 7 a 15 dígitos).</span>
		</div>

		<button type="submit" class="gold-button btn-full">
			<span>Registrar y Activar Membresía</span>
			<span>→</span>
		</button>
	</form>

	<div class="links">
		<a href="/login" class="auth-link gold-link">¿Ya es miembro distinguido? Inicie sesión</a>
	</div>

	<script>
		const refInput = document.getElementById('ref') as HTMLInputElement | null;
		const refHint = document.getElementById('ref-hint');
		const lockContainer = document.getElementById('ref-container');

		if (refInput && !refInput.readOnly) {
			let timer: number | undefined;

			const checkCode = async (val: string) => {
				const clean = val.trim();
				if (!clean) {
					if (refHint) refHint.textContent = 'Por cada persona que se registre con tu código ganas $1.000 (una sola vez).';
					return;
				}

				try {
					const res = await fetch(`/api/check-referrer?ref=${encodeURIComponent(clean)}`);
					const data = await res.json();
					if (data.valid) {
						if (data.ownCode) refInput.value = data.ownCode;
						refInput.readOnly = true;
						refInput.setAttribute('aria-readonly', 'true');

						if (lockContainer && !lockContainer.querySelector('.lock-icon')) {
							const lockSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
							lockSvg.setAttribute('class', 'lock-icon');
							lockSvg.setAttribute('width', '15');
							lockSvg.setAttribute('height', '15');
							lockSvg.setAttribute('viewBox', '0 0 24 24');
							lockSvg.setAttribute('fill', 'none');
							lockSvg.setAttribute('stroke', 'currentColor');
							lockSvg.setAttribute('stroke-width', '2');
							lockSvg.setAttribute('stroke-linecap', 'round');
							lockSvg.setAttribute('stroke-linejoin', 'round');
							lockSvg.setAttribute('aria-hidden', 'true');
							lockSvg.innerHTML = '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>';
							lockContainer.appendChild(lockSvg);
						}

						let hidden = document.querySelector('input[name="refFromLink"]') as HTMLInputElement;
						if (!hidden && lockContainer?.parentNode) {
							hidden = document.createElement('input');
							hidden.type = 'hidden';
							hidden.name = 'refFromLink';
							hidden.value = '1';
							lockContainer.parentNode.appendChild(hidden);
						}

						if (refHint) {
							refHint.textContent = `Código de tu invitador: se muestra tal cual y no se puede modificar.`;
						}
					} else if (data.reason === 'missing') {
						if (refHint) {
							refHint.textContent = 'Nadie usa todavía ese código: corrígelo o déjalo vacío para continuar.';
						}
					} else if (data.reason === 'unavailable') {
						if (refHint) {
							refHint.textContent = 'No pudimos verificar este código. Intenta de nuevo más tarde o quítalo.';
						}
					}
				} catch (err) {
					console.error('Error al verificar código:', err);
				}
			};

			refInput.addEventListener('input', () => {
				window.clearTimeout(timer);
				timer = window.setTimeout(() => checkCode(refInput.value), 450);
			});

			refInput.addEventListener('blur', () => {
				window.clearTimeout(timer);
				checkCode(refInput.value);
			});
		}
	</script>
</AuthLayout>

<style>
	.msg {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		border-radius: 12px;
		font-size: 13.5px;
		margin-bottom: 22px;
		line-height: 1.5;
	}

	.msg-error {
		background: rgba(239, 68, 68, 0.12);
		color: #ef4444;
		border: 1px solid rgba(239, 68, 68, 0.35);
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin-bottom: 24px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.field label {
		font-size: 13px;
		font-weight: 600;
		color: var(--text-secondary);
		letter-spacing: 0.02em;
	}

	.field input,
	.field select {
		padding: 13px 16px;
		background: rgba(15, 23, 42, 0.05);
		border: 1px solid var(--gold-border);
		border-radius: 12px;
		font-size: 14.5px;
		color: var(--text-primary);
		font-family: inherit;
		transition: all 0.25s ease;
	}

	:global([data-theme="dark"]) .field input,
	:global([data-theme="dark"]) .field select {
		background: rgba(4, 11, 28, 0.6);
	}

	.field input:focus,
	.field select:focus {
		outline: none;
		border-color: var(--gold-primary);
		box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
	}

	/* Contenedor del candado: el input sigue ocupando todo el ancho y el icono
	   se superpone a la derecha sin empujar el texto del código. */
	.input-lock {
		position: relative;
		display: flex;
	}

	.input-lock input {
		flex: 1;
		min-width: 0;
	}

	/* Código que llegó desde el enlace de referido: se ve, pero no se toca. */
	.input-lock input[readonly] {
		padding-right: 42px;
		cursor: not-allowed;
		color: var(--gold-primary);
		letter-spacing: 0.04em;
	}

	.lock-icon {
		position: absolute;
		right: 14px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--gold-primary);
		opacity: 0.7;
		pointer-events: none;
	}

	/* El option se pinta con el fondo del tema: en Windows el desplegable
	   heredaría el blanco del sistema y el texto dorado quedaría ilegible. */
	.field select option {
		background: var(--bg-primary, #ffffff);
		color: var(--text-primary, #0f172a);
	}

	.field-hint {
		font-size: 11.5px;
		color: var(--text-muted);
		line-height: 1.45;
	}

	/* Separador del bloque de contacto: agrupa los cinco campos nuevos
	   para que el formulario no parezca una lista interminable. */
	.section-divider {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 6px 0 0;
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gold-primary);
	}

	.section-divider::before,
	.section-divider::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--gold-border);
	}

	.btn-full {
		width: 100%;
		padding: 14px;
		font-size: 0.95rem;
		border: 1px solid rgba(255, 235, 150, 0.6);
		margin-top: 8px;
	}

	.links {
		font-size: 13.5px;
		text-align: center;
	}

	.auth-link {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.gold-link {
		color: var(--gold-primary);
		font-weight: 600;
	}

	.gold-link:hover {
		text-decoration: underline;
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 480px) {
		/* Las etiquetas largas del registro necesitan más espacio */
		.field label {
			font-size: 12.5px;
			line-height: 1.4;
		}

		.btn-full {
			padding: 14px 12px;
			font-size: 0.85rem;
		}

		.msg {
			padding: 11px 13px;
			font-size: 13px;
		}

		.form {
			gap: 16px;
		}
	}
</style>
