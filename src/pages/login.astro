---
import AuthLayout from '../layouts/AuthLayout.astro';

// SSR: query params are read at request time
export const prerender = false;

const error = Astro.url.searchParams.get('error');
const registered = Astro.url.searchParams.get('registered') === '1';
const loggedout = Astro.url.searchParams.get('loggedout') === '1';
---

<AuthLayout title="Acceso Exclusivo" subtitle="Ingrese sus credenciales de miembro para entrar al portal">
	{error && (
		<div class="msg msg-error">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="12" y1="8" x2="12" y2="12"></line>
				<line x1="12" y1="16" x2="12.01" y2="16"></line>
			</svg>
			<span>{error}</span>
		</div>
	)}

	{loggedout && (
		<div class="msg msg-success">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
			<span>Ha cerrado sesión con éxito. Su sesión ha sido asegurada.</span>
		</div>
	)}

	{registered && (
		<div class="msg msg-success">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
			<span>Membresía registrada con éxito. Ya puede iniciar sesión.</span>
		</div>
	)}

	<form method="POST" action="/api/login" class="form">
		<div class="field">
			<label for="identifier">Usuario o Correo Electrónico</label>
			<input
				type="text"
				id="identifier"
				name="identifier"
				placeholder="su-usuario@ganapro.com"
				required
				autofocus
			/>
		</div>

		<div class="field">
			<label for="password">Contraseña Cifrada</label>
			<input
				type="password"
				id="password"
				name="password"
				placeholder="••••••••••••"
				required
				minlength="6"
			/>
		</div>

		<button type="submit" class="gold-button btn-full">
			<span>Ingresar al Portal VIP</span>
			<span>→</span>
		</button>
	</form>

	<div class="links">
		<a href="/forgot-password" class="auth-link">¿Olvidó su contraseña?</a>
		<a href="/register" class="auth-link gold-link">¿Desea solicitar membresía? Regístrese</a>
	</div>
</AuthLayout>

<style>
	.msg {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		border-radius: 12px;
		font-size: 13.5px;
		margin-bottom: 22px;
		line-height: 1.5;
	}

	.msg-error {
		background: rgba(239, 68, 68, 0.12);
		color: #ef4444;
		border: 1px solid rgba(239, 68, 68, 0.35);
	}

	.msg-success {
		background: rgba(16, 185, 129, 0.12);
		color: #10b981;
		border: 1px solid rgba(16, 185, 129, 0.35);
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-bottom: 26px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		font-size: 13px;
		font-weight: 600;
		color: var(--text-secondary);
		letter-spacing: 0.02em;
	}

	.field input {
		padding: 14px 16px;
		background: rgba(15, 23, 42, 0.05);
		border: 1px solid var(--gold-border);
		border-radius: 12px;
		font-size: 15px;
		color: var(--text-primary);
		font-family: inherit;
		transition: all 0.25s ease;
	}

	:global([data-theme="dark"]) .field input {
		background: rgba(4, 11, 28, 0.6);
	}

	.field input:focus {
		outline: none;
		border-color: var(--gold-primary);
		box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
	}

	.btn-full {
		width: 100%;
		padding: 14px;
		font-size: 0.95rem;
		border: 1px solid rgba(255, 235, 150, 0.6);
		margin-top: 6px;
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 13.5px;
		text-align: center;
	}

	.auth-link {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.auth-link:hover {
		color: var(--text-primary);
	}

	.gold-link {
		color: var(--gold-primary);
		font-weight: 600;
	}

	.gold-link:hover {
		text-decoration: underline;
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 480px) {
		/* El botón con flecha "→" puede desbordar en pantallas estrechas */
		.btn-full {
			padding: 14px 16px;
			font-size: 0.88rem;
		}

		.msg {
			padding: 11px 13px;
			font-size: 13px;
		}

		.links {
			font-size: 13px;
		}
	}
</style>
