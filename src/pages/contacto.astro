---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// SSR: la página usa el Navbar, que lee la cookie de sesión
export const prerender = false;
---

<Layout title="Contacto">
	<Navbar />

	<main class="main-content">
		<section class="section page-hero">
			<div class="section-container">
				<div class="section-header">
					<span class="section-badge font-cinzel">CONCIERGE VIP</span>
					<h1 class="section-title font-cinzel">
						Hablemos <span class="gold-gradient-text">Directamente</span>
					</h1>
					<p class="section-subtitle">
						Nuestro equipo de asesoría privada responde en menos de 24 horas hábiles. Tu consulta es
						estrictamente confidencial.
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="contact-grid">
					<div class="luxury-card contact-card">
						<div class="card-icon-box">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Correo Electrónico</h2>
						<p class="card-desc">Canal directo con nuestro equipo de asesoría.</p>
						<a href="mailto:concierge@ganapro.com" class="contact-link">concierge@ganapro.com</a>
					</div>

					<div class="luxury-card contact-card">
						<div class="card-icon-box">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Asesoría Privada</h2>
						<p class="card-desc">Atención personalizada para miembros y candidatos.</p>
						<span class="contact-link">Disponible 24/7</span>
					</div>

					<div class="luxury-card contact-card">
						<div class="card-icon-box">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Oficinas</h2>
						<p class="card-desc">Presencia internacional para atender a nuestros clientes.</p>
						<span class="contact-link">Ginebra • Londres • Nueva York</span>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="luxury-card cta-box">
					<div class="cta-content">
						<h2 class="cta-title font-cinzel">Únete a GANA PRO</h2>
						<p class="cta-desc">Crea tu cuenta exclusiva y accede de inmediato al portal seguro.</p>
						<div class="cta-btns">
							<a href="/register" class="gold-button">Crear Cuenta Exclusiva</a>
							<a href="/login" class="ghost-gold-button">Ya Soy Miembro</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.main-content {
		position: relative;
		overflow: hidden;
	}

	.section {
		padding: 85px 24px;
	}

	.section-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 55px;
	}

	.section-badge {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		font-weight: 700;
		color: var(--gold-primary);
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 800;
		margin-bottom: 16px;
		line-height: 1.2;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 620px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.page-hero {
		padding-top: 70px;
		padding-bottom: 20px;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 30px;
	}

	.contact-card {
		padding: 38px 30px;
		display: flex;
		flex-direction: column;
	}

	.card-icon-box {
		width: 54px;
		height: 54px;
		border-radius: 14px;
		background: rgba(212, 175, 55, 0.12);
		border: 1px solid var(--gold-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gold-primary);
		margin-bottom: 20px;
	}

	.card-title {
		font-size: 1.3rem;
		font-weight: 800;
		margin-bottom: 12px;
	}

	.card-desc {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 18px;
	}

	.contact-link {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--gold-primary);
		text-decoration: none;
		margin-top: auto;
		transition: opacity 0.2s ease;
	}

	a.contact-link:hover {
		opacity: 0.8;
		text-decoration: underline;
	}

	.cta-box {
		padding: 60px 30px;
		text-align: center;
		background: radial-gradient(circle at center, rgba(30, 58, 138, 0.25) 0%, var(--bg-card) 75%);
		border: 1px solid var(--gold-border);
	}

	.cta-content {
		max-width: 680px;
		margin: 0 auto;
	}

	.cta-title {
		font-size: clamp(2rem, 3.5vw, 2.7rem);
		font-weight: 800;
		margin-bottom: 16px;
	}

	.cta-desc {
		font-size: 1.05rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 34px;
	}

	.cta-btns {
		display: flex;
		justify-content: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 640px) {
		.section {
			padding: 52px 18px;
		}

		.section-header {
			margin-bottom: 34px;
		}

		.page-hero {
			padding-top: 44px;
			padding-bottom: 10px;
		}

		.contact-grid {
			gap: 20px;
		}

		.contact-card {
			padding: 28px 22px;
		}

		.card-icon-box {
			width: 48px;
			height: 48px;
			margin-bottom: 16px;
		}

		.card-title {
			font-size: 1.18rem;
		}

		/* El email es largo: permitir salto de línea en pantallas estrechas */
		.contact-link {
			font-size: 0.9rem;
			word-break: break-word;
		}

		.cta-box {
			padding: 38px 20px;
		}

		.cta-btns {
			flex-direction: column;
		}

		.cta-btns a {
			width: 100%;
		}
	}

	@media (max-width: 360px) {
		.section {
			padding: 42px 14px;
		}

		.contact-card {
			padding: 24px 18px;
		}
	}
</style>
