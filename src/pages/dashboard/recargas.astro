---
import { validateSession } from '../../lib/session';
import { formatAppDateTime } from '../../lib/datetime';
import { getGoogleSheetUsers } from '../../lib/sheets';
import { listTopups, TOPUP_STATUS, type TopupRequest } from '../../lib/topups';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import type { User } from '../../lib/types';

export const prerender = false;

const session = validateSession(Astro.cookies.get('auth_session')?.value);
if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

let userDetail: User | null = null;
try {
	const users = await getGoogleSheetUsers();
	userDetail =
		users.find(
			(user) =>
				user.username?.toLowerCase() === session.username.toLowerCase() ||
				user.email?.toLowerCase() === session.email.toLowerCase()
		) || null;
} catch (error) {
	console.error('Error al cargar el rol del usuario:', error);
}

const role = (userDetail?.role || session.role || '').trim().toLowerCase();
const isAdmin = role === 'admin' || role === 'administrator';
if (!isAdmin) {
	return Astro.redirect('/dashboard?error=' + encodeURIComponent('No tienes permisos para ver las recargas.'), 303);
}

let requests: TopupRequest[] = [];
let loadError = false;
try {
	requests = await listTopups();
} catch (error) {
	loadError = true;
	console.error('Error al cargar las solicitudes de recarga:', error);
}

const pending = requests.filter((r) => r.status === TOPUP_STATUS.pendiente);
const resolved = requests.filter((r) => r.status !== TOPUP_STATUS.pendiente);
const approved = requests.filter((r) => r.status === TOPUP_STATUS.aprobado);
const totalApproved = approved.reduce((sum, r) => sum + r.amount, 0);

const statusMsg = Astro.url.searchParams.get('msg');
const statusOk = Astro.url.searchParams.get('ok') === '1';

/**
 * Formatea un monto en pesos colombianos.
 *
 * Acepta `number` o `string` porque los montos leídos del comprobante llegan
 * como texto (separados por "|") y se comparan contra los numéricos.
 */
const fmt = (value: number | string): string =>
	`$${Math.round(Number(value)).toLocaleString('es-CO')}`;
---

<AdminPageLayout
	session={session}
	title="Solicitudes de Recarga"
	eyebrow="REVISIÓN DEL ADMINISTRADOR"
	description="Compara el monto solicitado con la imagen del comprobante y aprueba la recarga. El saldo se acredita al aprobar."
>
	{statusMsg && (
		<p class:list={['account-alert', { ok: statusOk, ko: !statusOk }]} role="status">
			{statusMsg}
		</p>
	)}

	{loadError && (
		<p class="account-alert ko" role="alert">
			No se pudieron cargar las solicitudes de recarga en este momento.
		</p>
	)}

	{approved.length > 0 && (
		<div class="withdraw-total">
			<span>
				Recargas aprobadas: <strong>{approved.length}</strong> por un total de{' '}
				{fmt(totalApproved)} acreditados
			</span>
			<strong>{fmt(totalApproved)}</strong>
		</div>
	)}

	<section class="luxury-card">
		<header class="withdraw-head">
			<h2 class="font-cinzel">Pendientes ({pending.length})</h2>
			<span class="withdraw-count">{pending.length}</span>
		</header>

		{pending.length === 0 ? (
			<p class="withdraw-empty">No hay recargas pendientes de revisión.</p>
		) : (
			<ul class="withdraw-list">
				{pending.map((r) => (
					<li class="withdraw-item">
							<div class="withdraw-main">
								<div class="withdraw-who">
									<strong>{r.username}</strong>
									<span>{r.email}</span>
								</div>
								<div class="withdraw-amount">{fmt(r.amount)}</div>
								<dl class="withdraw-meta">
									<div><dt>Recarga</dt><dd>#{r.id}</dd></div>
									<div><dt>Enviado</dt><dd>{formatAppDateTime(r.createdAt)}</dd></div>
									<div><dt>Archivo</dt><dd>{r.receiptName || '—'}</dd></div>
								</dl>

								{r.receiptUrl && (
									<a class="receipt-link" href={r.receiptUrl} target="_blank" rel="noopener">
										Ver comprobante completo
									</a>
								)}
							</div>

							<div class="withdraw-actions">
								<button type="button" class="withdraw-btn approve" data-topup="aprobar" data-id={r.id}>
									Aprobar
								</button>
								<button type="button" class="withdraw-btn reject" data-topup="rechazar" data-id={r.id}>
									Rechazar
								</button>
							</div>
						</li>
				))}
			</ul>
		)}
	</section>

	{resolved.length > 0 && (
		<section class="luxury-card">
			<header class="withdraw-head">
				<h2 class="font-cinzel">Procesadas ({resolved.length})</h2>
			</header>
			<ul class="withdraw-list">
				{resolved.map((r) => (
					<li class="withdraw-item done">
						<div class="withdraw-main">
							<div class="withdraw-who">
								<strong>{r.username}</strong>
								<span>{r.email}</span>
							</div>
							<div class="withdraw-amount">{fmt(r.amount)}</div>
							<dl class="withdraw-meta">
								<div><dt>Estado</dt><dd>{r.status}</dd></div>
								<div><dt>Enviado</dt><dd>{formatAppDateTime(r.createdAt)}</dd></div>
								{r.adminNotes && <div><dt>Nota</dt><dd>{r.adminNotes}</dd></div>}
							</dl>
							{r.receiptUrl && (
								<a class="receipt-link" href={r.receiptUrl} target="_blank" rel="noopener">
									Ver comprobante
								</a>
							)}
						</div>
					</li>
				))}
			</ul>
		</section>
	)}
</AdminPageLayout>

<style is:global>
	.withdraw-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 18px;
	}

	.withdraw-head h2 {
		font-size: 1.15rem;
		margin: 0;
	}

	.withdraw-count {
		font-family: 'Cinzel', serif;
		font-weight: 800;
		color: var(--gold-primary);
	}

	.withdraw-empty {
		color: var(--text-secondary);
		font-size: 0.9rem;
		margin: 0;
	}

	.withdraw-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 14px;
	}

	.withdraw-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		padding: 16px;
		border-radius: 12px;
		border: 1px solid var(--gold-border);
		background: rgba(2, 7, 18, 0.3);
	}

	.withdraw-item.done {
		opacity: 0.7;
	}

	.withdraw-main {
		flex: 1;
		min-width: 260px;
	}

	.withdraw-who {
		display: flex;
		flex-direction: column;
	}

	.withdraw-who strong {
		color: var(--text-primary);
		font-size: 1rem;
	}

	.withdraw-who span {
		font-size: 0.78rem;
		color: var(--text-secondary);
	}

	.withdraw-amount {
		font-family: 'Cinzel', serif;
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--gold-primary);
		margin: 6px 0;
	}

	.withdraw-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 18px;
		margin: 0;
	}

	.withdraw-meta div {
		display: flex;
		gap: 6px;
		font-size: 0.78rem;
	}

	.withdraw-meta dt {
		color: var(--text-secondary);
	}

	.withdraw-meta dd {
		margin: 0;
		color: var(--text-primary);
	}

	.receipt-link {
		display: inline-block;
		margin-top: 10px;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--gold-primary);
		text-decoration: underline;
	}

	.withdraw-actions {
		display: flex;
		gap: 10px;
	}

	.withdraw-btn {
		padding: 10px 20px;
		border-radius: 10px;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		cursor: pointer;
		border: 1px solid var(--gold-border);
		background: transparent;
		color: var(--text-primary);
		transition: filter 0.2s ease, background 0.2s ease;
	}

	.withdraw-btn.approve {
		background: var(--gold-primary);
		border-color: var(--gold-primary);
		color: #10233f;
	}

	.withdraw-btn.approve:hover {
		filter: brightness(1.08);
	}

	.withdraw-btn.reject:hover {
		background: rgba(239, 68, 68, 0.16);
		border-color: #ef4444;
	}

	.withdraw-btn[disabled] {
		opacity: 0.6;
		cursor: progress;
	}

	.withdraw-total {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin: 0 0 18px;
		padding: 14px 16px;
		border-radius: 12px;
		border: 1px solid var(--gold-border);
		background: rgba(212, 175, 55, 0.1);
		font-size: 0.9rem;
	}

	.withdraw-total strong {
		font-family: 'Cinzel', serif;
		font-size: 1.3rem;
		color: var(--gold-primary);
	}

	@media (max-width: 600px) {
		.withdraw-actions {
			width: 100%;
		}

		.withdraw-btn {
			flex: 1;
		}
	}
</style>

<script is:inline>
	// Aprueba o rechaza una recarga y recarga la lista al terminar.
	document.querySelectorAll('[data-topup]').forEach(function (btn) {
		btn.addEventListener('click', async function () {
			var id = btn.getAttribute('data-id');
			var action = btn.getAttribute('data-topup');
			if (!id || !action) return;

			if (
				action === 'aprobar' &&
				!confirm('¿Verificaste que el comprobante coincide con el monto? Se acreditará el saldo.')
			) {
				return;
			}
			if (action === 'rechazar' && !confirm('¿Rechazar esta solicitud de recarga?')) {
				return;
			}

			btn.setAttribute('disabled', 'disabled');
			try {
				var res = await fetch('/api/admin/topups', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id: id, action: action }),
				});
				var data = await res.json().catch(function () { return {}; });
				var url =
					'/dashboard/recargas?ok=' + (data && data.ok ? '1' : '0') +
					'&msg=' + encodeURIComponent((data && data.message) || 'No se pudo completar.');
				window.location.href = url;
			} catch (err) {
				btn.removeAttribute('disabled');
				alert('Error de conexión. Inténtalo de nuevo.');
			}
		});
	});
</script>
