---
import { getGoogleSheetUsers } from '../../lib/sheets';
import { buildUserHierarchy, countOrganizationUsers, countByLevel, maxOrganizationDepth } from '../../lib/user-hierarchy';
import { getBusinessSettings } from '../../lib/business-settings';
import {
	DASHBOARD_PAGES,
	isSectionKey,
	isAdminRole,
	getBusinessFeedback,
	getDocumentsFeedback,
	getContactFeedback,
	toUserRowViews,
	getModuleCards,
} from '../../lib/dashboard-sections';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import OrgChartPanel from '../../components/dashboard/OrgChartPanel.astro';
import UsersTable from '../../components/dashboard/UsersTable.astro';
import BusinessSettingsPanel from '../../components/dashboard/BusinessSettingsPanel.astro';
import ModuleCards from '../../components/dashboard/ModuleCards.astro';
import type { User } from '../../lib/types';
import '../../styles/org-chart.css';
import '../../styles/org-focus.css';
import '../../styles/org-tree.css';
import '../../styles/users-table.css';
import AdminAccountingPanel from '../../components/dashboard/AdminAccountingPanel.astro';
import { listTopups, type TopupRequest } from '../../lib/topups';
import { listWithdrawals, type WithdrawalRequest } from '../../lib/withdrawals';
import { listP2PPayments, type P2PPayment } from '../../lib/p2p-payments';
import { listAdminExpenses, type AdminExpense } from '../../lib/admin-records';

export const prerender = false;

// --- Guardia de ruta (el middleware ya resolvio la sesion) ---
const section = Astro.params.section || '';
if (!isSectionKey(section)) {
	return Astro.redirect('/dashboard', 303);
}

const session = Astro.locals.user;
if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

if (!isAdminRole(session.role)) {
	return Astro.redirect('/dashboard', 303);
}

const page = DASHBOARD_PAGES[section];

// --- Carga de datos (misma lógica, nombres agrupados) ---
let businessSettings = null;
let businessSettingsLoadFailed = false;
let organizationLoadFailed = false;
let usersLoadFailed = false;

try {
	businessSettings = await getBusinessSettings();
} catch (error) {
	businessSettingsLoadFailed = true;
	console.error('Error al cargar la configuración del negocio:', error);
}

let sheetUsers: User[] = [];
try {
	sheetUsers = await getGoogleSheetUsers();
} catch (error) {
	organizationLoadFailed = true;
	usersLoadFailed = true;
	console.error('Error al cargar usuarios desde Google Sheets:', error);
}

// --- Vista organigrama (derivados puros) ---
const hierarchy = buildUserHierarchy(sheetUsers);
const orgTotal = countOrganizationUsers(hierarchy);
const orgDepth = maxOrganizationDepth(hierarchy);
const orgLevels = countByLevel(hierarchy);

// --- Vista usuarios (filas enriquecidas) ---
const userRows = toUserRowViews(sheetUsers, businessSettings);

// --- Feedback de formularios (querystring) ---
const { result: businessResult, message: businessMessage } = getBusinessFeedback(Astro.url.searchParams);
const { review: reviewResult, reviewMessage } = getDocumentsFeedback(Astro.url.searchParams);
const { contact: contactResult, contactMessage } = getContactFeedback(Astro.url.searchParams);

// --- Tarjetas genéricas (ingresos / gastos / usuario) ---
const moduleCards = getModuleCards(section);
let accountingTopups: TopupRequest[] = [];
let accountingWithdrawals: WithdrawalRequest[] = [];
let accountingPayments: P2PPayment[] = [];
let accountingExpenses: AdminExpense[] = [];
if (section === 'ingresos' || section === 'gastos') {
	[accountingTopups, accountingWithdrawals, accountingPayments, accountingExpenses] = await Promise.all([
		listTopups(), listWithdrawals(), listP2PPayments(), listAdminExpenses(),
	]);
}
---

<AdminPageLayout
	session={session}
	isAdmin={true}
	title={page.title}
	eyebrow={page.eyebrow}
	description={page.description}
>
	{section === 'organigrama-global' ? (
		<OrgChartPanel
			hierarchy={hierarchy}
			total={orgTotal}
			depth={orgDepth}
			levels={orgLevels}
			loadFailed={organizationLoadFailed}
		/>
	) : section === 'usuarios-registrados' ? (
		<UsersTable
			users={userRows}
			review={reviewResult}
			reviewMessage={reviewMessage}
			loadFailed={usersLoadFailed}
			contact={contactResult}
			contactMessage={contactMessage}
		/>
	) : section === 'negocio' ? (
		<BusinessSettingsPanel
			settings={businessSettings}
			result={businessResult}
			message={businessMessage}
			loadFailed={businessSettingsLoadFailed}
		/>
	) : section === 'ingresos' || section === 'gastos' ? (
		<AdminAccountingPanel mode={section} topups={accountingTopups} withdrawals={accountingWithdrawals} payments={accountingPayments} expenses={accountingExpenses} />
	) : (
		<ModuleCards cards={moduleCards} />
	)}
</AdminPageLayout>
