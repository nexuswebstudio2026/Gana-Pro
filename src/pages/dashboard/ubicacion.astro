---
import { validateSession } from '../../lib/session';
import { isAdminRole } from '../../lib/auth';
import { formatAppDateTime } from '../../lib/datetime';
import {
	getUserLocation,
	getLocationSheetUrl,
	getMapUrl,
	type StoredLocation,
} from '../../lib/location';
import { getGoogleSheetUsers } from '../../lib/sheets';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import type { User } from '../../lib/types';

export const prerender = false;

const session = validateSession(Astro.cookies.get('auth_session')?.value);
if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

let userDetail: User | null = null;
try {
	const users = await getGoogleSheetUsers();
	userDetail = users.find(
		(user) =>
			user.username?.toLowerCase() === session.username.toLowerCase() ||
			user.email?.toLowerCase() === session.email.toLowerCase()
	) || null;
} catch (error) {
	console.error('Error al cargar el rol del usuario:', error);
}

const isAdmin = isAdminRole(userDetail?.role || session.role);
let myLocation: StoredLocation | null = null;
let locationSheetUrl = getLocationSheetUrl();
try {
	myLocation = await getUserLocation(session.username);
	if (myLocation) locationSheetUrl = getLocationSheetUrl(myLocation.sheetId);
} catch (error) {
	console.error('Error al leer la ubicación:', error);
}
const hasLocation = myLocation !== null;
const mapUrl = hasLocation ? myLocation!.mapUrl || getMapUrl(myLocation!.lat, myLocation!.lng) : '';
---

<AdminPageLayout
	session={session}
	isAdmin={isAdmin}
	title="Mi Ubicación"
	eyebrow="Configuración · Usuario"
	description="Consulta o actualiza la ubicación compartida desde tu cuenta."
>
	<section class="luxury-card doc-box loc-box" id="mi-ubicacion" data-loc-url="/api/location" aria-labelledby="location-title">
		<div class="doc-head">
			<div>
				<h2 class="detail-title font-cinzel" id="location-title">Mi Ubicación</h2>
				<p class="doc-hint">
					{hasLocation
						? 'Última posición registrada al ingresar a tu cuenta.'
						: 'Necesitamos tu ubicación para registrar tu acceso y actualizar la hoja de control.'}
				</p>
			</div>
			<span class="doc-status wait" data-loc-badge>
				{hasLocation ? 'Registrada' : 'Sin registrar'}
			</span>
		</div>

		<div class="loc-alert ko" role="alert" data-loc-error hidden></div>

		<!-- Ubicación en vivo (tiempo real del navegador) -->
		<div class="live-card" data-live-card aria-live="polite">
			<div class="live-head">
				<span class="live-dot" data-live-dot aria-hidden="true"></span>
				<strong data-live-status>Solicitando permiso de ubicación…</strong>
			</div>
			<p class="doc-hint" data-live-hint>
				Al entrar a esta página el navegador te pedirá permiso para usar tu ubicación actual.
			</p>
			<div class="loc-grid">
				<div class="loc-item">
					<span class="loc-label">Latitud actual</span>
					<code class="loc-value" data-live-lat>—</code>
				</div>
				<div class="loc-item">
					<span class="loc-label">Longitud actual</span>
					<code class="loc-value" data-live-lng>—</code>
				</div>
				<div class="loc-item">
					<span class="loc-label">Exactitud</span>
					<code class="loc-value" data-live-acc>—</code>
				</div>
				<div class="loc-item">
					<span class="loc-label">Actualizado</span>
					<code class="loc-value" data-live-time>—</code>
				</div>
			</div>
			<div class="doc-actions">
				<a href="#" target="_blank" rel="noopener noreferrer" class="doc-view" data-live-map hidden>Ver ubicación actual en Google Maps</a>
				<span class="doc-note" data-live-saved hidden></span>
			</div>
		</div>

		{hasLocation && (
			<div class="loc-grid" data-loc-box>
				<div class="loc-item">
					<span class="loc-label">Latitud</span>
					<code class="loc-value" data-loc-lat>{myLocation!.lat.toFixed(6)}</code>
				</div>
				<div class="loc-item">
					<span class="loc-label">Longitud</span>
					<code class="loc-value" data-loc-lng>{myLocation!.lng.toFixed(6)}</code>
				</div>
				<div class="loc-item">
					<span class="loc-label">Exactitud</span>
					<code class="loc-value" data-loc-acc>
						{myLocation!.accuracy !== undefined ? `± ${myLocation!.accuracy} m` : 'No reportada'}
					</code>
				</div>
				<div class="loc-item">
					<span class="loc-label">Registrado</span>
					<code class="loc-value" data-loc-date>
						{myLocation!.date ? formatAppDateTime(myLocation!.date) : '—'}
					</code>
				</div>
			</div>
		)}

		<div class="doc-actions">
			<button type="button" class="gold-button" data-loc-btn>
				{hasLocation ? 'Actualizar mi ubicación' : 'Compartir mi ubicación'}
			</button>
			<button type="button" class="doc-view" data-live-toggle hidden>
				Detener seguimiento en vivo
			</button>
			{hasLocation && (
				<a href={mapUrl} target="_blank" rel="noopener noreferrer" class="doc-view">Ver en Google Maps</a>
			)}
		</div>

		{hasLocation && <code class="loc-url" data-loc-url-link>{mapUrl}</code>}

		<a href={locationSheetUrl} target="_blank" rel="noopener noreferrer" class="doc-note">
			Ver la hoja de ubicaciones en Google Sheets →
		</a>
	</section>
</AdminPageLayout>

<script>
	const locBox = document.querySelector<HTMLElement>('#mi-ubicacion');
	const locBtn = document.querySelector<HTMLButtonElement>('[data-loc-btn]');
	const locError = document.querySelector<HTMLElement>('[data-loc-error]');

	const liveLat = document.querySelector<HTMLElement>('[data-live-lat]');
	const liveLng = document.querySelector<HTMLElement>('[data-live-lng]');
	const liveAcc = document.querySelector<HTMLElement>('[data-live-acc]');
	const liveTime = document.querySelector<HTMLElement>('[data-live-time]');
	const liveStatus = document.querySelector<HTMLElement>('[data-live-status]');
	const liveHint = document.querySelector<HTMLElement>('[data-live-hint]');
	const liveMap = document.querySelector<HTMLAnchorElement>('[data-live-map]');
	const liveSaved = document.querySelector<HTMLElement>('[data-live-saved]');
	const liveDot = document.querySelector<HTMLElement>('[data-live-dot]');
	const liveToggle = document.querySelector<HTMLButtonElement>('[data-live-toggle]');

	let watchId: number | null = null;
	let saveTimer: ReturnType<typeof setTimeout> | null = null;

	function locFail(message: string): void {
		if (!locError) return;
		locError.textContent = message;
		locError.hidden = false;
	}

	function locClearError(): void {
		if (!locError) return;
		locError.textContent = '';
		locError.hidden = true;
	}

	function setLiveState(state: string, message?: string): void {
		if (liveDot) liveDot.dataset.state = state;
		if (liveStatus && message) liveStatus.textContent = message;
		if (liveToggle) liveToggle.hidden = state !== 'live';
	}

	async function sendLocation(lat: number, lng: number, accuracy: number): Promise<void> {
		const response = await fetch(locBox?.dataset.locUrl || '/api/location', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ lat, lng, accuracy, source: 'gps' }),
		});
		if (!response.ok) throw new Error('No se pudo guardar la ubicación en la hoja.');
		if (liveSaved) {
			liveSaved.hidden = false;
			liveSaved.textContent = `Guardada en Sheets · ${new Date().toLocaleTimeString('es-CO')}`;
		}
	}

	function queueAutoSave(lat: number, lng: number, accuracy: number): void {
		if (saveTimer) clearTimeout(saveTimer);
		saveTimer = setTimeout(() => {
			sendLocation(lat, lng, accuracy).catch(() => undefined);
		}, 5000);
	}

	function renderLivePosition(position: GeolocationPosition): void {
		locClearError();
		const { latitude, longitude, accuracy } = position.coords;
		if (liveLat) liveLat.textContent = latitude.toFixed(6);
		if (liveLng) liveLng.textContent = longitude.toFixed(6);
		if (liveAcc) liveAcc.textContent = Number.isFinite(accuracy) ? `± ${Math.round(accuracy)} m` : '—';
		if (liveTime) liveTime.textContent = new Date().toLocaleString('es-CO');
		if (liveMap) {
			liveMap.hidden = false;
			liveMap.href = `https://www.google.com/maps/search/?api=1&query=${latitude},${longitude}`;
		}
		if (liveHint) liveHint.textContent = 'Ubicación actual de tu navegador (se actualiza en tiempo real).';
		setLiveState('live', 'Ubicación en vivo activa');
		queueAutoSave(latitude, longitude, accuracy);
	}

	function handleLiveError(error: GeolocationPositionError): void {
		const messages: Record<number, string> = {
			1: 'Permiso denegado. Pulsa "Compartir mi ubicación" y acepta el permiso en el navegador.',
			2: 'No se pudo determinar tu posición. Revisa que el GPS esté encendido.',
			3: 'La solicitud tardó demasiado. Intenta de nuevo.',
		};
		locFail(messages[error.code] || 'No se pudo obtener la ubicación.');
		setLiveState('error', 'Ubicación en vivo detenida');
	}

	locBtn?.addEventListener('click', () => {
		if (!('geolocation' in navigator)) {
			locFail('Tu navegador no admite la geolocalización.');
			return;
		}

		locBtn.disabled = true;
		locBtn.textContent = 'Obteniendo ubicación…';
		navigator.geolocation.getCurrentPosition(
			async (position) => {
				try {
					await sendLocation(position.coords.latitude, position.coords.longitude, position.coords.accuracy);
					window.location.reload();
				} catch (error) {
					locFail(error instanceof Error ? error.message : 'Error al guardar la ubicación.');
					locBtn.disabled = false;
					locBtn.textContent = 'Reintentar';
				}
			},
			(error) => {
				const messages: Record<number, string> = {
					1: 'Permiso denegado. Actívalo desde el candado de la barra de direcciones.',
					2: 'No se pudo determinar tu posición. Revisa que el GPS esté encendido.',
					3: 'La solicitud tardó demasiado. Intenta de nuevo.',
				};
				locFail(messages[error.code] || 'No se pudo obtener la ubicación.');
				locBtn.disabled = false;
				locBtn.textContent = 'Reintentar';
			},
			{ enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
		);
	});

	function startLiveTracking(): void {
		if (!('geolocation' in navigator)) {
			locFail('Tu navegador no admite la geolocalización.');
			setLiveState('error', 'Geolocalización no disponible');
			return;
		}
		if (watchId !== null) return;
		setLiveState('loading', 'Solicitando permiso de ubicación…');
		watchId = navigator.geolocation.watchPosition(renderLivePosition, handleLiveError, {
			enableHighAccuracy: true,
			timeout: 15000,
			maximumAge: 5000,
		});
	}

	liveToggle?.addEventListener('click', () => {
		if (watchId !== null) {
			navigator.geolocation.clearWatch(watchId);
			watchId = null;
		}
		if (saveTimer) {
			clearTimeout(saveTimer);
			saveTimer = null;
		}
		setLiveState('stopped', 'Seguimiento en vivo pausado');
		if (liveToggle) liveToggle.hidden = true;
	});

	// Al entrar a la página se pide el permiso del navegador de inmediato
	// y el seguimiento continúa en tiempo real con watchPosition.
	startLiveTracking();
</script>

<style>
	.doc-box { display: block; padding: 28px; margin-bottom: 24px; }
	.detail-title { margin: 0 0 20px; font-size: 1.2rem; border-bottom: 1px solid var(--gold-border); padding-bottom: 12px; }
	.doc-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
	.doc-hint { margin: 0; color: var(--text-secondary); font-size: 13px; line-height: 1.55; }
	.doc-status { flex: 0 0 auto; padding: 6px 14px; border: 1px solid var(--gold-border); border-radius: 9999px; font-size: 12px; font-weight: 700; }
	.doc-status.wait { background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); }
	.doc-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
	.doc-view { display: inline-flex; align-items: center; padding: 10px 18px; border: 1px solid var(--gold-border); border-radius: 9999px; background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); font-size: 13.5px; font-weight: 700; text-decoration: none; transition: background 0.2s ease, border-color 0.2s ease; }
	.doc-view:hover { background: rgba(212, 175, 55, 0.22); border-color: var(--gold-primary); }
	.doc-note { display: inline-block; margin-top: 4px; color: var(--text-secondary); font-size: 14px; }
	.loc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.75rem; margin-bottom: 1rem; }
	.loc-item { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.7rem 0.85rem; border: 1px solid var(--gold-border); border-radius: 10px; background: rgba(255, 255, 255, 0.02); }
	.loc-label { color: var(--text-secondary); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }
	.loc-value { color: var(--gold-primary); font-size: 0.92rem; font-weight: 600; word-break: break-all; }
	.loc-alert { margin-bottom: 0.9rem; padding: 0.65rem 0.85rem; border: 1px solid rgba(220, 80, 80, 0.35); border-radius: 8px; background: rgba(220, 80, 80, 0.1); color: #ff9a9a; font-size: 0.85rem; }
	.loc-url { display: block; margin-bottom: 0.75rem; padding: 0.5rem 0.7rem; border: 1px dashed var(--gold-border); border-radius: 8px; background: rgba(212, 175, 55, 0.08); color: var(--gold-primary); font-size: 0.75rem; word-break: break-all; }
	.live-card { margin-bottom: 1.25rem; padding: 1rem 1.1rem; border: 1px solid var(--gold-border); border-radius: 14px; background: rgba(212, 175, 55, 0.05); }
	.live-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
	.live-head strong { font-size: 0.95rem; }
	.live-dot { width: 12px; height: 12px; border-radius: 50%; background: #f5b301; flex: 0 0 12px; }
	.live-dot[data-state='live'] { background: #10b981; box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.18); animation: livePulse 1.6s ease-in-out infinite; }
	.live-dot[data-state='error'], .live-dot[data-state='stopped'] { background: #ef4444; box-shadow: none; animation: none; }
	@keyframes livePulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.25); } }
	.live-card .loc-grid { margin-bottom: 0.5rem; }
	.live-card .doc-actions { margin: 8px 0 0; }
	@media (max-width: 768px) {
		.doc-box { padding: 22px 18px; }
		.doc-head { flex-direction: column; gap: 12px; }
	}
</style>
