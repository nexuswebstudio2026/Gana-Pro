---
/**
 * Comprobantes de pago entre usuarios.
 *
 * El selector de conceptos (con su monto y si está habilitado) lo arma el
 * servidor con las reglas de `p2p.ts`, igual que hace `/api/p2p/receipts`: el
 * formulario no puede habilitar un concepto ni calcular un monto distinto al
 * que después valida el endpoint.
 */
import { isAdminRole } from '../../lib/auth';
import { getSheetUserLevel, getUserBalance } from '../../lib/users';
import { parseSheetBalance } from '../../lib/sheets';
import { P2P_CONCEPTS, P2P_CONCEPT_INFO, canSubmitConcept, conceptAmount } from '../../lib/p2p';
import { listP2PPayments } from '../../lib/p2p-payments';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import UploadReceiptModal from '../../components/dashboard/UploadReceiptModal.astro';

export const prerender = false;

const session = Astro.locals.user!;

const level = await getSheetUserLevel(session.username, session.email);
const balance = parseSheetBalance(await getUserBalance(session.username, session.email));

let payments: Awaited<ReturnType<typeof listP2PPayments>> = [];
try {
	// Se pide filtrado por usuario: la lista completa incluye los movimientos
	// de los demás, que no son datos de esta persona.
	payments = await listP2PPayments(session.username);
} catch (error) {
	console.error('No se pudo cargar el historial de pagos P2P:', error);
}

const concepts = P2P_CONCEPTS.map((id) => {
	const info = P2P_CONCEPT_INFO[id];
	return {
		id,
		label: info.label,
		detail: info.detail,
		amount: conceptAmount(id, balance),
		enabled: canSubmitConcept(id, level),
	};
});

const isAdmin = isAdminRole(session.role);
---

<AdminPageLayout
	session={session}
	isAdmin={isAdmin}
	title="Comprobantes de pago"
	eyebrow="Configuración · Usuario"
	description="Sube el comprobante de tu recarga inicial y de tus envíos entre usuarios, y sigue el estado de cada movimiento."
>
	<UploadReceiptModal concepts={concepts} payments={payments} />
</AdminPageLayout>
