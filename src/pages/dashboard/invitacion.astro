---
import { isAdminRole } from '../../lib/auth';
import { formatAppDateTime } from '../../lib/datetime';
import { getGoogleSheetUsers, getPublicSiteUrl } from '../../lib/sheets';
import { ownCodeOf } from '../../lib/referrals';
import { COMMISSION_PER_REFERRAL } from '../../lib/referrals';
import { formatCOP } from '../../lib/referrals';
import type { User } from '../../lib/types';

export const prerender = false;

const session = Astro.locals.user!;

let userDetail: User | null = null;
try {
	const users = await getGoogleSheetUsers();
	userDetail =
		users.find(
			(user) =>
				user.username?.toLowerCase() === session.username.toLowerCase() ||
				user.email?.toLowerCase() === session.email.toLowerCase()
		) || null;
} catch (error) {
	console.error('Error al cargar los datos de la invitaciÃ³n:', error);
}

const isAdmin = isAdminRole(userDetail?.role || session.role);
if (!isAdmin && !userDetail) {
	return Astro.redirect('/dashboard', 303);
}

// El QR se sirve desde /api/referral-qr, que ya devuelve el SVG del usuario
// conectado con el dominio pÃºblico correcto.
const referralCode = userDetail
	? ownCodeOf(userDetail)
	: String(session.username || '').trim();
const siteUrl = getPublicSiteUrl(Astro.request);
const referralUrl = `${siteUrl}/register?ref=${encodeURIComponent(referralCode)}`;
