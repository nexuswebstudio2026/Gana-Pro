---
import { validateSession } from '../../lib/session';
import { getGoogleSheetUsers } from '../../lib/sheets';
import { buildUserHierarchy, countOrganizationUsers, countByLevel, maxOrganizationDepth } from '../../lib/user-hierarchy';
import { DOCUMENT_STATUS } from '../../lib/testimonials';
import { getBusinessSettings, type BusinessSettings } from '../../lib/business-settings';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import UserOrgNode from '../../components/UserOrgNode.astro';
import type { User } from '../../lib/types';

export const prerender = false;

const pages = {
	'organigrama-global': {
		title: 'Organigrama Global de Usuarios',
		eyebrow: 'Gana Pro',
		description: 'Consulta la estructura general de usuarios y sus relaciones dentro de la organización.',
		cards: [
			{ title: 'Estructura organizacional', text: 'Visualiza la distribución de usuarios por niveles y responsables.' },
			{ title: 'Relaciones jerárquicas', text: 'Identifica responsables directos y equipos principales.' },
		],
	},
	'usuarios-registrados': {
		title: 'Usuarios Registrados',
		eyebrow: 'Gana Pro',
		description: 'Administra la información de las cuentas registradas en la plataforma.',
		cards: [
			{ title: 'Directorio de usuarios', text: 'Consulta las cuentas activas y sus datos de acceso.' },
			{ title: 'Estado de cuentas', text: 'Revisa el estado de cada usuario dentro del sistema.' },
		],
	},
	'ingresos': {
		title: 'Ingresos',
		eyebrow: 'Contabilidad',
		description: 'Centraliza el seguimiento de los ingresos del negocio.',
		cards: [
			{ title: 'Resumen de ingresos', text: 'Consulta los ingresos registrados por período.' },
			{ title: 'Historial', text: 'Revisa el detalle de los movimientos de ingresos.' },
		],
	},
	'gastos': {
		title: 'Gastos',
		eyebrow: 'Contabilidad',
		description: 'Centraliza el seguimiento de los gastos del negocio.',
		cards: [
			{ title: 'Resumen de gastos', text: 'Consulta los gastos registrados por período.' },
			{ title: 'Historial', text: 'Revisa el detalle de los movimientos de gastos.' },
		],
	},
	'negocio': {
		title: 'Negocio',
		eyebrow: 'Configuración',
		description: 'Administra la configuración general de Gana Pro.',
		cards: [
			{ title: 'Información del negocio', text: 'Mantén los datos generales de la organización.' },
			{ title: 'Preferencias', text: 'Gestiona las preferencias operativas del negocio.' },
		],
	},
	'usuario': {
		title: 'Usuario',
		eyebrow: 'Configuración',
		description: 'Administra tu cuenta y la información de acceso al panel.',
		cards: [
			{ title: 'Perfil de usuario', text: 'Consulta la información asociada a tu cuenta.' },
			{ title: 'Acceso y seguridad', text: 'Gestiona las preferencias de acceso al panel.' },
		],
	},
} as const;

type SectionKey = keyof typeof pages;
const section = Astro.params.section || '';
if (!(section in pages)) {
	return Astro.redirect('/dashboard', 303);
}

const token = Astro.cookies.get('auth_session')?.value;
const session = validateSession(token);
if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

const role = (session.role || '').trim().toLowerCase();
if (role !== 'admin' && role !== 'administrator') {
	return Astro.redirect('/dashboard', 303);
}

const page = pages[section as SectionKey];
let businessSettings: BusinessSettings | null = null;
let businessSettingsLoadFailed = false;

if (section === 'negocio') {
	try {
		businessSettings = await getBusinessSettings();
	} catch (error) {
		businessSettingsLoadFailed = true;
		console.error('Error al obtener la configuración del negocio:', error);
	}
}

const businessResult = Astro.url.searchParams.get('business');
const businessMessage = Astro.url.searchParams.get('msg');

let hierarchy = buildUserHierarchy([]);
let organizationLoadFailed = false;
let sheetUsers: User[] = [];
let usersLoadFailed = false;

if (section === 'organigrama-global' || section === 'usuarios-registrados') {
	try {
		sheetUsers = await getGoogleSheetUsers();
	} catch (error) {
		organizationLoadFailed = true;
		usersLoadFailed = true;
		console.error('Error al obtener usuarios desde Google Sheets:', error);
	}
}

if (section === 'organigrama-global') {
	hierarchy = buildUserHierarchy(sheetUsers);
}

const orgTotal = countOrganizationUsers(hierarchy);
const orgDepth = maxOrganizationDepth(hierarchy);
const orgLevels = countByLevel(hierarchy);
const orgDirect = hierarchy.children.length;

// --- Revisión de documentos ---
const reviewResult = Astro.url.searchParams.get('review');
const reviewMessage = Astro.url.searchParams.get('msg');
// Solo los que han enviado NIT/RUT necesitan revisión
const withDocument = sheetUsers.filter(
	(u) => (u.documentLink || '').trim() !== '' || (u.rutLink || '').trim() !== ''
);
const pendingDocuments = withDocument.filter(
	(user) => documentStatusOf(user) === DOCUMENT_STATUS.pendiente
);

function documentStatusOf(user: User): string {
	return (user.documentStatus || DOCUMENT_STATUS.pendiente).trim();
}
---

<AdminPageLayout
	session={session}
	title={page.title}
	eyebrow={page.eyebrow}
	description={page.description}
>
	{section === 'organigrama-global' ? (
		<section class="org-panel luxury-card" aria-label="Organigrama global de usuarios">
			<div class="org-panel-heading">
				<div>
					<h2>Estructura de usuarios</h2>
					<p>Cada usuario principal recibe hasta cinco usuarios siguientes según el orden de registro.</p>
				</div>
				<span class="org-total">{orgTotal} usuarios distribuidos</span>
			</div>
			<div class="org-stats" role="list" aria-label="Resumen del organigrama">
				<div class="org-stat" role="listitem">
					<span class="org-stat-value">{orgTotal}</span>
					<span class="org-stat-label">Usuarios en red</span>
				</div>
				<div class="org-stat" role="listitem">
					<span class="org-stat-value">{orgDirect}<small>/5</small></span>
					<span class="org-stat-label">Directos de GANA PRO</span>
				</div>
				<div class="org-stat" role="listitem">
					<span class="org-stat-value">{orgDepth}</span>
					<span class="org-stat-label">Niveles de profundidad</span>
				</div>
				<div class="org-stat" role="listitem">
					<span class="org-stat-value">{orgLevels.length}</span>
					<span class="org-stat-label">Niveles con usuarios</span>
				</div>
			</div>
			{orgLevels.length > 1 && (
				<ol class="org-levels" aria-label="Usuarios por nivel">
					{orgLevels.map(({ level, count }) => (
						<li class="org-level">
							<span class="org-level-name">{level === 0 ? 'Raíz' : `Nivel ${level}`}</span>
							<span class="org-level-bar" aria-hidden="true">
								<span style={`width: ${(count / Math.max(orgTotal + 1, 1)) * 100}%`}></span>
							</span>
							<span class="org-level-count">{count}</span>
						</li>
					))}
				</ol>
			)}
			<div class="org-toolbar">
				<label class="org-search">
					<span class="org-search-icon" aria-hidden="true">⌕</span>
					<input
						type="search"
						placeholder="Buscar por nombre o correo…"
						aria-label="Buscar usuario en el organigrama"
						data-org-search
					/>
				</label>
				<div class="org-zoom" role="group" aria-label="Controles del organigrama">
					<button type="button" data-org-zoom-out aria-label="Reducir zoom">−</button>
					<span data-org-zoom-label aria-live="polite">100%</span>
					<button type="button" data-org-zoom-in aria-label="Aumentar zoom">+</button>
					<button type="button" data-org-zoom-reset>Restablecer</button>
					<button type="button" data-org-tree-toggle aria-expanded="false">Ver árbol completo</button>
					<button type="button" data-org-collapse-all>Contraer todo</button>
					<button type="button" data-org-expand-all>Expandir todo</button>
				</div>
			</div>
			<p class="org-result" data-org-result role="status" hidden></p>
			<div class="org-focus" data-org-focus aria-live="polite">
				<div class="org-focus-head">
					<div>
						<span class="org-focus-eyebrow">Viendo equipo de</span>
						<strong class="org-focus-name" data-org-focus-name>GANA PRO</strong>
						<span class="org-focus-sub" data-org-focus-sub></span>
					</div>
					<div class="org-focus-actions">
						<button type="button" data-org-back hidden>← Volver</button>
						<button type="button" data-org-home>⌂ Raíz</button>
					</div>
				</div>
				<nav class="org-crumbs" aria-label="Ruta del equipo" data-org-crumbs></nav>
				<div class="org-focus-grid" data-org-focus-grid></div>
			</div>
			<div class="org-chart-scroll" data-org-scroll hidden>
				<ul class="org-tree" data-org-tree style="--org-zoom: 1">
					<UserOrgNode node={hierarchy} root />
				</ul>
			</div>
			<script type="application/json" data-org-data set:html={JSON.stringify(hierarchy)} />
			<script is:inline data-org-chart>
				(() => {
					const dataEl = document.querySelector('[data-org-data]');
					let root = null;
					try {
						root = JSON.parse(dataEl?.textContent || 'null');
					} catch {
						root = null;
					}
					if (!root) return;
					const byId = new Map();
					const pathOf = new Map();
					(pathOf.set(root.id, [root.id]), byId.set(root.id, root));
					const stack = [root];
					while (stack.length > 0) {
						const node = stack.pop();
						(node.children || []).forEach((child) => {
							byId.set(child.id, child);
							pathOf.set(child.id, [...(pathOf.get(node.id) || []), child.id]);
							stack.push(child);
						});
					}

					const tree = document.querySelector('[data-org-tree]');
					const panel = tree?.closest('.org-panel') || document;
					const focusBox = panel.querySelector('[data-org-focus]');
					const focusName = panel.querySelector('[data-org-focus-name]');
					const focusSub = panel.querySelector('[data-org-focus-sub]');
					const focusGrid = panel.querySelector('[data-org-focus-grid]');
					const crumbs = panel.querySelector('[data-org-crumbs]');
					const backBtn = panel.querySelector('[data-org-back]');
					const homeBtn = panel.querySelector('[data-org-home]');
					const search = panel.querySelector('[data-org-search]');
					const result = panel.querySelector('[data-org-result]');
					const label = panel.querySelector('[data-org-zoom-label]');
					let currentId = root.id;
					let zoom = 1;

					const initialsOf = (name) =>
						String(name || '')
							.split(/[\s_.-]+/)
							.filter(Boolean)
							.slice(0, 2)
							.map((part) => part.charAt(0).toUpperCase())
							.join('') || '·';

					const countDescendants = (node) =>
						(node.children || []).reduce((total, child) => total + 1 + countDescendants(child), 0);

					const renderFocus = () => {
						const node = byId.get(currentId) || root;
						currentId = node.id;
						const kids = node.children || [];
						if (focusName) focusName.textContent = node.name || 'Equipo';
						if (focusSub) {
							const detail = node.id === root.id
								? `${kids.length} directos · ${countDescendants(node)} en su red`
								: [
										node.email || '',
										`${kids.length} directo${kids.length === 1 ? '' : 's'}`,
										`${countDescendants(node)} en su red`,
									]
										.filter(Boolean)
										.join(' · ');
							focusSub.textContent = detail;
						}
						if (backBtn) {
							const path = pathOf.get(node.id) || [root.id];
							backBtn.hidden = path.length <= 1;
						}
						if (crumbs) {
							crumbs.innerHTML = '';
							(pathOf.get(node.id) || [root.id]).forEach((id, index, arr) => {
								const item = byId.get(id);
								if (!item) return;
								if (index > 0) {
									const sep = document.createElement('span');
									sep.className = 'org-crumb-sep';
									sep.textContent = '›';
									sep.setAttribute('aria-hidden', 'true');
									crumbs.appendChild(sep);
								}
								const btn = document.createElement('button');
								btn.type = 'button';
								btn.className = 'org-crumb' + (index === arr.length - 1 ? ' is-current' : '');
								btn.textContent = item.name;
								btn.setAttribute('aria-current', index === arr.length - 1 ? 'page' : 'false');
								btn.addEventListener('click', () => {
									currentId = id;
									renderFocus();
								});
								crumbs.appendChild(btn);
							});
						}
						if (focusGrid) {
							focusGrid.innerHTML = '';
							if (kids.length === 0) {
								const empty = document.createElement('p');
								empty.className = 'org-empty';
								empty.textContent = `${node.name} aún no tiene usuarios directos asignados.`;
								focusGrid.appendChild(empty);
							} else {
								kids.slice(0, 5).forEach((child, index) => {
									const card = document.createElement('button');
									card.type = 'button';
									card.className = 'org-focus-card';
									card.setAttribute('data-org-focus-pick', child.id);
									const grandkids = (child.children || []).length;
									card.innerHTML =
										`<span class="org-focus-slot">Puesto ${index + 1} de 5</span>` +
										`<span class="org-avatar" aria-hidden="true">${initialsOf(child.name)}</span>` +
										`<strong>${child.name}</strong>` +
										`<span class="org-focus-meta">${[child.level, child.role].filter(Boolean).join(' · ') || `Registro #${child.position}`}</span>` +
										(child.email ? `<span class="org-email">${child.email}</span>` : '') +
										`<span class="org-pos">${grandkids} equipo${grandkids === 1 ? '' : 's'} · ver ›</span>`;
									card.addEventListener('click', () => {
										currentId = child.id;
										renderFocus();
									});
									focusGrid.appendChild(card);
								});
								for (let i = kids.length; i < 5; i++) {
									const vacant = document.createElement('div');
									vacant.className = 'org-focus-card is-vacant';
									vacant.innerHTML =
										`<span class="org-focus-slot">Puesto ${i + 1} de 5</span>` +
										`<span class="org-avatar" aria-hidden="true">○</span>` +
										`<strong>Puesto disponible</strong>` +
										`<span class="org-focus-meta">Sin asignar</span>`;
									focusGrid.appendChild(vacant);
								}
							}
						}
						syncTreeSelection();
					};

					const syncTreeSelection = () => {
						if (!tree) return;
						tree.querySelectorAll('[data-org-node]').forEach((branch) => {
							branch.classList.toggle('is-selected', branch.dataset.orgNode === currentId);
						});
					};

					backBtn?.addEventListener('click', () => {
						const path = pathOf.get(currentId) || [root.id];
						currentId = path.length > 1 ? path[path.length - 2] : root.id;
						renderFocus();
					});
					homeBtn?.addEventListener('click', () => {
						currentId = root.id;
						renderFocus();
					});
					panel?.querySelector('[data-org-tree-toggle]')?.addEventListener('click', (event) => {
						const btn = event.currentTarget as HTMLButtonElement | null;
						const scroll = panel.querySelector('[data-org-scroll]');
						if (!scroll || !btn) return;
						const open = (scroll as HTMLElement).hidden;
						(scroll as HTMLElement).hidden = !open;
						btn.setAttribute('aria-expanded', String(open));
						btn.textContent = open ? 'Ocultar árbol completo' : 'Ver árbol completo';
						if (open) scroll.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});

					const applyZoom = () => {
						if (!tree) return;
						tree.style.setProperty('--org-zoom', String(zoom));
						if (label) label.textContent = `${Math.round(zoom * 100)}%`;
					};

					const setCollapsed = (branch, collapsed) => {
						const kids = branch.querySelector(':scope > .org-children');
						const btn = branch.querySelector(':scope > .org-node [data-org-toggle]');
						if (!kids || !btn) return;
						kids.hidden = collapsed;
						btn.textContent = collapsed ? '+' : '−';
						btn.setAttribute('aria-expanded', String(!collapsed));
						const name = branch.dataset.orgName || 'equipo';
						btn.setAttribute(
							'aria-label',
							collapsed ? `Expandir equipo de ${name}` : `Contraer equipo de ${name}`
						);
					};

					tree?.addEventListener('click', (event) => {
						const target = event.target instanceof Element ? event.target : null;
						const toggle = target?.closest('[data-org-toggle]');
						if (toggle) {
							const branch = toggle.closest('.org-branch');
							if (!branch) return;
							const kids = branch.querySelector(':scope > .org-children');
							if (!kids) return;
							event.preventDefault();
							event.stopPropagation();
							setCollapsed(branch, !(kids as HTMLElement).hidden);
							return;
						}
						const selectBtn = target?.closest('[data-org-select]');
						if (selectBtn) {
							const id = selectBtn.getAttribute('data-org-select');
							if (id && byId.has(id)) {
								currentId = id;
								renderFocus();
								focusBox?.scrollIntoView({ behavior: 'smooth', block: 'start' });
							}
						}
					});

					panel?.querySelector('[data-org-zoom-in]')?.addEventListener('click', () => {
						zoom = Math.min(1.8, +(zoom + 0.15).toFixed(2));
						applyZoom();
					});
					panel?.querySelector('[data-org-zoom-out]')?.addEventListener('click', () => {
						zoom = Math.max(0.5, +(zoom - 0.15).toFixed(2));
						applyZoom();
					});
					panel?.querySelector('[data-org-zoom-reset]')?.addEventListener('click', () => {
						zoom = 1;
						applyZoom();
						if (search) {
							search.value = '';
							search.dispatchEvent(new Event('input', { bubbles: true }));
						}
					});
					panel?.querySelector('[data-org-collapse-all]')?.addEventListener('click', () => {
						tree?.querySelectorAll('.org-branch').forEach((branch) => {
							if (branch.classList.contains('org-root')) return;
							setCollapsed(branch, true);
						});
					});
					panel?.querySelector('[data-org-expand-all]')?.addEventListener('click', () => {
						tree?.querySelectorAll('.org-branch').forEach((branch) => setCollapsed(branch, false));
					});

					search?.addEventListener('input', () => {
						const q = search.value.trim().toLowerCase();
						const nodes = [...(tree?.querySelectorAll('[data-org-node]') || [])];
						if (!q) {
							nodes.forEach((node) => node.classList.remove('is-dimmed', 'is-match'));
							if (result) result.hidden = true;
							return;
						}
						let matches = 0;
						let first = null;
						nodes.forEach((node) => {
							const hit =
								(node.dataset.orgName || '').includes(q) ||
								(node.dataset.orgEmail || '').includes(q);
							node.classList.toggle('is-match', hit);
							node.classList.toggle('is-dimmed', !hit);
							if (hit) {
								matches += 1;
								if (!first) first = node;
								let parent = node.parentElement?.closest('.org-branch');
								while (parent) {
									setCollapsed(parent, false);
									parent.classList.remove('is-dimmed');
									parent = parent.parentElement?.closest('.org-branch') || null;
								}
							}
						});
						if (result) {
							result.hidden = false;
							result.textContent =
								matches === 0
									? `Sin coincidencias para “${search.value.trim()}”.`
									: `${matches} coincidencia${matches === 1 ? '' : 's'} para “${search.value.trim()}”.`;
						}
						if (first) {
							const foundId = first.dataset.orgNode;
							const foundPath = pathOf.get(foundId) || [];
							const foundNode = byId.get(foundId);
							if (foundNode && (foundNode.children || []).length > 0) {
								currentId = foundId;
							} else if (foundPath.length > 1) {
								currentId = foundPath[foundPath.length - 2];
							}
							renderFocus();
							focusBox?.scrollIntoView({ behavior: 'smooth', block: 'start' });
						}
					});

					renderFocus();
					applyZoom();
				})();
			</script>
			{organizationLoadFailed ? (
				<p class="org-empty">No se pudo consultar la información de usuarios en Google Sheets.</p>
			) : hierarchy.children.length === 0 ? (
				<p class="org-empty">Todavía no hay usuarios registrados en Google Sheets para construir el organigrama.</p>
			) : null}
		</section>
	) : section === 'usuarios-registrados' ? (
		<section class="org-panel luxury-card" aria-label="Usuarios registrados">
			<div class="org-panel-heading">
				<div>
					<h2>Usuarios registrados</h2>
					<p>
						{sheetUsers.length} usuarios en total · {withDocument.length} con NIT/RUT ·
						{pendingDocuments.length} pendientes de revisar.
					</p>
				</div>
			</div>

			{reviewResult === 'ok' && <p class="doc-alert ok">{reviewMessage}</p>}
			{reviewResult === 'error' && (
				<p class="doc-alert ko">{reviewMessage || 'No se pudo actualizar el estado.'}</p>
			)}

			{usersLoadFailed ? (
				<p class="org-empty">No se pudo consultar la información de usuarios en Google Sheets.</p>
			) : sheetUsers.length === 0 ? (
				<p class="org-empty">Todavía no hay usuarios registrados.</p>
			) : (
				<div class="org-chart-scroll">
					<table class="users-table">
						<thead>
							<tr>
								<th>Usuario</th>
								<th>Nivel</th>
								<th>NIT / RUT (DIAN)</th>
								<th>Acciones</th>
							</tr>
						</thead>
						<tbody>
							{sheetUsers.map((u) => {
									const status = documentStatusOf(u);
									const isApproved = status === DOCUMENT_STATUS.aprobado;
									const hasDocument =
										(u.documentLink || '').trim() !== '' || (u.rutLink || '').trim() !== '';
									const approvedDocumentLink = isApproved
										? (u.rutLink || u.documentLink || '').trim()
										: '';
									const documentFileName = (u.scannedRut || u.scannedDocument || '').trim();
									const documentPdf = documentFileName.toLowerCase().endsWith('.pdf');
									const nit = (u.nit || '').trim();

								return (
									<tr>
										<td>
											<strong>{u.username}</strong>
											<small>{u.email}</small>
										</td>
								<td>{u.level || '1'}</td>
								<td>
									<div class="doc-cell">
										<span class="doc-line">
											<span class="doc-kind">NIT</span>
											{nit ? <small class="nit-tag">{nit}</small> : <span class="muted">Sin registrar</span>}
										</span>
										<span class="doc-line">
											<span class="doc-kind">RUT emitido por la DIAN</span>
											{approvedDocumentLink ? (
												<a
													href={approvedDocumentLink}
													target="_blank"
													rel="noopener noreferrer"
													class="doc-link rut-link"
												>
													{documentPdf ? 'Ver documento aprobado (PDF)' : 'Ver documento aprobado'}
												</a>
											) : (
												<span class="muted">
													{hasDocument ? 'Documento pendiente de aprobación' : 'Sin subir'}
												</span>
											)}
										</span>
									</div>
								</td>
						<td class="actions">
							{isApproved ? (
								<span class="status-pill ok" aria-label={`Estado del documento de ${u.username}`}>
									Aprobado
								</span>
							) : (
								<>
									<span class="status-pill wait" aria-label={`Estado del documento de ${u.username}`}>
										No aprobado
									</span>
									{hasDocument && (
										<>
											<form method="POST" action="/api/admin/documents">
													<input type="hidden" name="username" value={u.username} />
													<input type="hidden" name="status" value={DOCUMENT_STATUS.aprobado} />
													<button type="submit" class="btn-approve">Aprobar</button>
												</form>
												<form method="POST" action="/api/admin/documents">
													<input type="hidden" name="username" value={u.username} />
													<input type="hidden" name="status" value={DOCUMENT_STATUS.rechazado} />
													<button type="submit" class="btn-reject">Rechazar</button>
												</form>
											</>
										)}
										<form
											method="POST"
											action="/api/admin/documents"
											enctype="multipart/form-data"
											class="doc-admin-form"
										>
											<input type="hidden" name="username" value={u.username} />
											<span class="doc-admin-title">NIT / RUT (DIAN)</span>
											<input
												type="text"
												name="nit"
												value={nit}
												placeholder="NIT: 900123456"
												inputmode="numeric"
												minlength="6"
												maxlength="20"
												pattern="[0-9]*"
												title="Solo números, entre 6 y 20 dígitos"
												aria-label={`NIT de ${u.username}`}
												class="nit-input"
											/>
											<input
												type="file"
												name="rut"
												accept="image/jpeg,image/png,image/webp,application/pdf"
												aria-label={`RUT emitido por la DIAN de ${u.username}`}
												class="rut-input"
											/>
											<p class="doc-hint">RUT en JPG, PNG, WEBP o PDF (máximo 5 MB).</p>
											<button type="submit" class="btn-save">Guardar NIT y RUT</button>
										</form>
								</>
							)}
						</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			)}
		</section>
	) : section === 'negocio' ? (
		<section class="org-panel luxury-card business-settings" id="rut-empresarial" aria-labelledby="business-rut-title">
			<div class="org-panel-heading">
				<div>
					<h2 id="business-rut-title">Configurar y subir RUT empresarial</h2>
					<p>Guarda el NIT y el RUT oficial de Gana Pro para la configuración del negocio.</p>
				</div>
			</div>

			{businessResult === 'ok' && <p class="doc-alert ok" role="status">{businessMessage || 'NIT y RUT empresarial guardados correctamente.'}</p>}
			{businessResult === 'error' && <p class="doc-alert ko" role="alert">{businessMessage || 'No se pudo guardar la configuración.'}</p>}
			{businessSettingsLoadFailed ? (
				<p class="org-empty" role="alert">No se pudo cargar la configuración del negocio. Verifica el acceso a Google Sheets.</p>
			) : (
				<>
					{businessSettings?.rutLink ? (
						<div class="business-current doc-cell" aria-label="RUT empresarial guardado">
							<span class="doc-line"><span class="doc-kind">NIT empresarial</span><strong>{businessSettings.nit}</strong></span>
							<span class="doc-line">
								<span class="doc-kind">RUT empresarial</span>
								<a href={businessSettings.rutLink} target="_blank" rel="noopener noreferrer" class="doc-link rut-link">
									Ver RUT empresarial · {businessSettings.rutFileName}
								</a>
							</span>
							{businessSettings.updatedAt && <small class="muted">Última actualización: {businessSettings.updatedAt}</small>}
						</div>
					) : (
						<p class="business-empty muted">Todavía no se ha configurado el RUT del negocio.</p>
					)}

					<form method="POST" action="/api/admin/business-config" enctype="multipart/form-data" class="doc-admin-form business-form">
						<label for="business-nit" class="doc-admin-title">NIT del negocio</label>
						<input
							type="text"
							id="business-nit"
							name="nit"
							value={businessSettings?.nit || ''}
							placeholder="NIT: 900123456"
							inputmode="numeric"
							minlength="6"
							maxlength="20"
							pattern="[0-9]*"
							title="Solo números, entre 6 y 20 dígitos"
							required
							class="nit-input"
						/>
						<label for="business-rut-file" class="doc-admin-title">RUT emitido por la DIAN</label>
						<input
							type="file"
							id="business-rut-file"
							name="rut"
							accept="image/jpeg,image/png,image/webp,application/pdf"
							aria-describedby="business-rut-hint"
							required={!businessSettings?.rutLink}
							class="rut-input"
						/>
						<p class="doc-hint" id="business-rut-hint">JPG, PNG, WEBP o PDF de hasta 5 MB.</p>
						<button type="submit" class="btn-save">Guardar NIT y RUT del negocio</button>
					</form>
				</>
			)}
		</section>
	) : (
		<div class="module-grid">
			{page.cards.map((card) => (
				<article class="module-card luxury-card">
					<h2>{card.title}</h2>
					<p>{card.text}</p>
				</article>
			))}
		</div>
	)}
</AdminPageLayout>

<style is:global>
	.org-panel { padding: 28px; }
	#rut-empresarial { scroll-margin-top: 96px; }
	.business-settings { display: flex; flex-direction: column; gap: 18px; }
	.business-settings .org-panel-heading { margin-bottom: 0; }
	.business-current { padding: 14px; border: 1px solid var(--gold-border); border-radius: 10px; background: rgba(212, 175, 55, 0.05); }
	.business-current strong { color: var(--text-primary); font-size: 13px; }
	.business-empty { margin: 0; }
	.business-form { max-width: 560px; }
	.org-panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
	.org-panel-heading h2 { margin: 0 0 8px; font-size: 1.25rem; }
	.org-panel-heading p { margin: 0; color: var(--text-secondary); font-size: 14px; line-height: 1.6; }
	.org-total { flex: 0 0 auto; padding: 8px 12px; border: 1px solid var(--gold-border); border-radius: 9999px; color: var(--gold-primary); background: rgba(212, 175, 55, 0.1); font-size: 12px; font-weight: 700; }
	.org-chart-scroll { overflow-x: auto; padding: 12px 4px 20px; }
	.org-tree, .org-children { list-style: none; margin: 0; padding: 0; }
	.org-tree { min-width: 980px; display: flex; justify-content: center; transform: scale(var(--org-zoom, 1)); transform-origin: top center; transition: transform 0.2s ease; }
	.org-branch { position: relative; display: flex; flex-direction: column; align-items: center; }
	.org-branch.is-dimmed > .org-node { opacity: 0.35; filter: saturate(0.4); }
	.org-branch.is-match > .org-node { border-color: var(--gold-primary); box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.45), 0 10px 24px rgba(0, 0, 0, 0.2); }
	.org-root { padding-bottom: 28px; }
	.org-node { position: relative; min-width: 168px; max-width: 220px; padding: 12px 36px 12px 14px; display: flex; align-items: center; gap: 10px; border: 1px solid var(--gold-border); border-radius: 14px; background: var(--bg-surface); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16); transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease; }
	.org-node:hover { transform: translateY(-2px); border-color: var(--gold-primary); box-shadow: 0 16px 32px rgba(0, 0, 0, 0.22); }
	.org-node-root { min-width: 210px; border-color: var(--gold-primary); background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), var(--bg-surface)); }
	.org-avatar { width: 38px; height: 38px; flex: 0 0 38px; display: grid; place-items: center; border-radius: 12px; background: rgba(212, 175, 55, 0.18); color: var(--gold-primary); font-size: 12px; font-weight: 800; letter-spacing: 0.02em; }
	.org-node-root .org-avatar { background: var(--gold-primary); color: #101827; }
	.org-copy { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
	.org-copy strong { overflow: hidden; color: var(--text-primary); font-size: 12.5px; text-overflow: ellipsis; white-space: nowrap; }
	.org-copy span { color: var(--text-secondary); font-size: 10px; }
	.org-email { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 150px; }
	.org-meta { display: flex; align-items: center; gap: 6px; margin-left: auto; }
	.org-pos { padding: 2px 8px; border-radius: 999px; background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); font-size: 10px; font-weight: 800; white-space: nowrap; }
	.org-kids { color: var(--text-secondary); font-size: 10px; font-weight: 700; white-space: nowrap; }
	.org-toggle { position: absolute; right: 8px; bottom: 8px; width: 20px; height: 20px; display: grid; place-items: center; border: 1px solid var(--gold-border); border-radius: 50%; background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); font-size: 12px; font-weight: 800; line-height: 1; cursor: pointer; }
	.org-toggle:hover { background: rgba(212, 175, 55, 0.25); }
	.org-view { position: absolute; top: 8px; right: 8px; padding: 3px 9px; border: 1px solid var(--gold-border); border-radius: 999px; background: transparent; color: var(--gold-primary); font-size: 10px; font-weight: 800; cursor: pointer; }
	.org-view:hover { background: rgba(212, 175, 55, 0.18); }
	.org-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0 0 16px; }
	.org-stat { padding: 14px 16px; border: 1px solid var(--gold-border); border-radius: 12px; background: rgba(212, 175, 55, 0.06); display: flex; flex-direction: column; gap: 4px; }
	.org-stat-value { font-size: 1.35rem; font-weight: 800; color: var(--gold-primary); line-height: 1; }
	.org-stat-value small { font-size: 0.8rem; font-weight: 700; }
	.org-stat-label { color: var(--text-secondary); font-size: 11px; font-weight: 600; }
	.org-levels { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
	.org-level { display: grid; grid-template-columns: 90px 1fr 40px; align-items: center; gap: 12px; font-size: 12px; }
	.org-level-name { color: var(--text-secondary); font-weight: 700; }
	.org-level-bar { height: 8px; border-radius: 999px; background: rgba(212, 175, 55, 0.12); overflow: hidden; }
	.org-level-bar span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--gold-primary), rgba(212, 175, 55, 0.45)); }
	.org-level-count { text-align: right; font-weight: 800; color: var(--gold-primary); }
	.org-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
	.org-search { display: flex; align-items: center; gap: 8px; min-width: 240px; flex: 1 1 260px; padding: 8px 12px; border: 1px solid var(--gold-border); border-radius: 10px; background: rgba(255, 255, 255, 0.02); }
	.org-search-icon { color: var(--gold-primary); font-size: 15px; }
	.org-search input { flex: 1; border: 0; background: transparent; color: var(--text-primary); font: inherit; font-size: 13px; outline: none; }
	.org-zoom { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
	.org-zoom button { padding: 7px 12px; border: 1px solid var(--gold-border); border-radius: 8px; background: rgba(212, 175, 55, 0.1); color: var(--gold-primary); font-size: 12px; font-weight: 700; cursor: pointer; }
	.org-zoom button:hover { background: rgba(212, 175, 55, 0.2); }
	.org-zoom span { min-width: 48px; text-align: center; color: var(--text-secondary); font-size: 12px; font-weight: 700; }
	.org-result { margin: 0 0 10px; color: var(--text-secondary); font-size: 12.5px; }
	.org-focus { margin-bottom: 16px; padding: 18px; border: 1px solid var(--gold-border); border-radius: 16px; background: linear-gradient(180deg, rgba(212, 175, 55, 0.08), rgba(212, 175, 55, 0.02)); }
	.org-focus-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
	.org-focus-eyebrow { display: block; color: var(--gold-primary); font-size: 10px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 4px; }
	.org-focus-name { display: block; font-size: 1.4rem; font-weight: 800; line-height: 1.1; }
	.org-focus-sub { display: block; margin-top: 4px; color: var(--text-secondary); font-size: 12.5px; }
	.org-focus-actions { display: flex; gap: 8px; flex: 0 0 auto; }
	.org-focus-actions button { padding: 8px 14px; border: 1px solid var(--gold-border); border-radius: 10px; background: rgba(212, 175, 55, 0.1); color: var(--gold-primary); font-size: 12px; font-weight: 700; cursor: pointer; }
	.org-focus-actions button:hover { background: rgba(212, 175, 55, 0.22); }
	.org-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
	.org-crumb { padding: 5px 12px; border: 1px solid var(--gold-border); border-radius: 999px; background: transparent; color: var(--text-secondary); font-size: 11.5px; font-weight: 700; cursor: pointer; }
	.org-crumb:hover { color: var(--gold-primary); border-color: var(--gold-primary); }
	.org-crumb.is-current { background: rgba(212, 175, 55, 0.16); color: var(--gold-primary); }
	.org-crumb-sep { color: var(--gold-primary); font-weight: 800; }
	.org-focus-grid { display: grid; grid-template-columns: repeat(5, minmax(150px, 1fr)); gap: 12px; }
	.org-focus-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 16px 12px; border: 1px solid var(--gold-border); border-radius: 14px; background: var(--bg-surface); color: var(--text-primary); font: inherit; cursor: pointer; transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease; }
	.org-focus-card:hover { transform: translateY(-3px); border-color: var(--gold-primary); box-shadow: 0 14px 30px rgba(0, 0, 0, 0.25); }
	.org-focus-card.is-vacant { border-style: dashed; opacity: 0.65; cursor: default; }
	.org-focus-card.is-vacant:hover { transform: none; box-shadow: none; }
	.org-focus-slot { padding: 3px 10px; border-radius: 999px; background: rgba(212, 175, 55, 0.14); color: var(--gold-primary); font-size: 10px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
	.org-focus-card strong { font-size: 13px; text-align: center; overflow-wrap: anywhere; }
	.org-focus-meta { color: var(--text-secondary); font-size: 11px; text-align: center; }
	.org-focus-card .org-email { max-width: 100%; font-size: 10px; }
	.org-branch.is-selected > .org-node { border-color: var(--gold-primary); box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.45); }
	.org-node[data-org-select] { cursor: pointer; }
	@media (max-width: 1100px) { .org-focus-grid { grid-template-columns: repeat(3, minmax(150px, 1fr)); } }
	.org-children { position: relative; display: flex; justify-content: center; gap: 14px; margin-top: 28px; padding-top: 24px; }
	.org-children::before { content: ''; position: absolute; top: 0; left: 50%; width: calc(100% - 30px); border-top: 1px solid var(--gold-border); transform: translateX(-50%); }
	.org-children > .org-branch::before { content: ''; position: absolute; top: -24px; left: 50%; height: 24px; border-left: 1px solid var(--gold-border); }
	.org-empty { margin: 0; padding: 24px 0 4px; color: var(--text-secondary); text-align: center; }

	/* ============ TABLA DE USUARIOS Y REVISIÓN DE DOCUMENTOS ============ */
	.users-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
		min-width: 900px;
	}

	.users-table th {
		text-align: left;
		padding: 12px 14px;
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gold-primary);
		border-bottom: 1px solid var(--gold-border);
		white-space: nowrap;
	}

	.users-table td {
		padding: 14px;
		border-bottom: 1px solid rgba(212, 175, 55, 0.1);
		vertical-align: middle;
		color: var(--text-secondary);
	}

	.users-table td strong {
		display: block;
		color: var(--text-primary);
		font-size: 14px;
	}

	.users-table td small {
		display: block;
		font-size: 12px;
		color: var(--text-muted);
		margin-top: 3px;
	}

	.users-table tbody tr:hover { background: rgba(212, 175, 55, 0.04); }

	.doc-link {
		color: var(--gold-primary);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid var(--gold-border);
	}

	.doc-link:hover { border-bottom-color: var(--gold-primary); }

	.rut-link {
		display: inline-block;
		margin-top: 4px;
		color: #6ea8fe;
		border-bottom-color: rgba(110, 168, 254, 0.4);
	}
	.rut-link:hover { border-bottom-color: #6ea8fe; }
	.nit-tag {
		display: inline-block;
		margin-bottom: 4px;
		padding: 2px 8px;
		border-radius: 999px;
		background: rgba(212, 175, 55, 0.12);
		color: var(--gold-primary);
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.muted { color: var(--text-muted); font-size: 13px; }

	.status-pill {
		display: inline-block;
		padding: 5px 12px;
		border-radius: 9999px;
		font-size: 12px;
		font-weight: 700;
		border: 1px solid var(--gold-border);
		white-space: nowrap;
	}

	.status-pill.ok { background: rgba(16, 185, 129, 0.14); border-color: rgba(16, 185, 129, 0.45); color: #10b981; }
	.status-pill.ko { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.45); color: #ef4444; }
	.status-pill.wait { background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); }

	.actions { display: flex; gap: 8px; flex-wrap: wrap; }
	.actions form { margin: 0; }

	.btn-approve,
	.btn-reject {
		padding: 7px 14px;
		border-radius: 8px;
		font-size: 12.5px;
		font-weight: 700;
		cursor: pointer;
		border: 1px solid;
		transition: filter 0.2s ease;
	}

	.btn-approve { background: rgba(16, 185, 129, 0.14); border-color: rgba(16, 185, 129, 0.5); color: #10b981; }
	.btn-reject { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.5); color: #ef4444; }
	.btn-approve:hover, .btn-reject:hover { filter: brightness(1.25); }

	.doc-alert {
		padding: 12px 16px;
		border-radius: 10px;
		font-size: 14px;
		margin: 0 0 18px;
		border: 1px solid;
	}

	.doc-alert.ok { background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.35); color: #10b981; }
	.doc-alert.ko { background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.35); color: #f87171; }

	/* ============ NIT Y RUT (DIAN) POR USUARIO ============ */
	.doc-cell { display: flex; flex-direction: column; gap: 7px; }
	.doc-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
	.doc-kind { min-width: 64px; color: var(--gold-primary); font-size: 10.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
	.users-table .doc-ref { margin-top: 0; }

	.doc-admin-form { display: flex; flex-direction: column; gap: 7px; min-width: 210px; padding: 10px; border: 1px dashed var(--gold-border); border-radius: 10px; background: rgba(212, 175, 55, 0.05); }
	.doc-admin-title { color: var(--gold-primary); font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	.nit-input { width: 100%; padding: 8px 10px; border: 1px solid var(--gold-border); border-radius: 8px; background: rgba(255, 255, 255, 0.04); color: var(--text-primary); font-family: inherit; font-size: 13px; }
	.nit-input:focus { outline: none; border-color: var(--gold-primary); }
	.rut-input { width: 100%; font-size: 11.5px; color: var(--text-secondary); }
	.rut-input::file-selector-button { margin-right: 8px; padding: 6px 10px; border: 1px solid var(--gold-border); border-radius: 8px; background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); font-size: 11.5px; font-weight: 700; cursor: pointer; }
	.btn-save { padding: 8px 12px; border: 1px solid rgba(212, 175, 55, 0.5); border-radius: 8px; background: rgba(212, 175, 55, 0.16); color: var(--gold-primary); font-size: 12.5px; font-weight: 700; cursor: pointer; }
	.btn-save:hover { filter: brightness(1.2); }
	.doc-hint { margin: 0; color: var(--text-secondary); font-size: 11px; line-height: 1.45; }


	@media (max-width: 768px) {

		.org-panel { padding: 20px 14px; }
		.org-panel-heading { flex-direction: column; }
		.org-total { align-self: flex-start; }
		.org-level { grid-template-columns: 72px 1fr 32px; gap: 8px; }
		.org-node { min-width: 150px; }
		.org-focus-head { flex-direction: column; }
		.org-focus-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>

