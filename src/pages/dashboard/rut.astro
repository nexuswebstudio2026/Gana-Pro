---
import { validateSession } from '../../lib/session';
import { isAdminRole } from '../../lib/auth';
import { getGoogleSheetUsers } from '../../lib/sheets';
import { DOCUMENT_STATUS } from '../../lib/testimonials';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import type { User } from '../../lib/types';

export const prerender = false;

const session = validateSession(Astro.cookies.get('auth_session')?.value);
if (!session) {
	return Astro.redirect('/login?error=' + encodeURIComponent('Debes iniciar sesión para acceder a esta página.'), 303);
}

let userDetail: User | null = null;
try {
	const users = await getGoogleSheetUsers();
	userDetail = users.find(
		(user) =>
			user.username?.toLowerCase() === session.username.toLowerCase() ||
			user.email?.toLowerCase() === session.email.toLowerCase()
	) || null;
} catch (error) {
	console.error('Error al cargar el RUT personal:', error);
}

const isAdmin = isAdminRole(userDetail?.role || session.role);
const docResult = Astro.url.searchParams.get('doc');
const docMessage = Astro.url.searchParams.get('msg');
const docStatus = (userDetail?.documentStatus || DOCUMENT_STATUS.pendiente).trim();
const nitValue = (userDetail?.nit || userDetail?.documentNumber || '').trim();
const rutLink = (userDetail?.rutLink || userDetail?.documentLink || '').trim();
const rutFileName = (userDetail?.scannedRut || userDetail?.scannedDocument || 'rut.pdf').trim() || 'rut.pdf';
const isPdf = rutFileName.toLowerCase().endsWith('.pdf');
const docApproved = docStatus === DOCUMENT_STATUS.aprobado;
const docRejected = docStatus === DOCUMENT_STATUS.rechazado;
const hasRut = rutLink !== '';
---

<AdminPageLayout
	session={session}
	isAdmin={isAdmin}
	title="NIT y RUT personal"
	eyebrow="Configuración · Usuario"
	description="Consulta el estado de tu registro y gestiona tu NIT y RUT emitido por la DIAN."
>
	<section class="luxury-card doc-box" aria-labelledby="personal-rut-title">
		<div class="doc-heading">
			<div>
				<h2 class="detail-title font-cinzel" id="personal-rut-title">NIT y RUT (DIAN)</h2>
				<p class="doc-lead">
					Registra tu NIT y sube el RUT emitido por la DIAN para completar la verificación de la cuenta. Puedes adjuntar una imagen o un PDF de hasta 5 MB.
				</p>
			</div>
			<span class:list={['doc-badge', { ok: docApproved, ko: docRejected, wait: !docApproved && !docRejected }]}>
				{docStatus}
			</span>
		</div>

		{docResult === 'ok' && (
			<div class="doc-alert ok" role="status">RUT recibido. Queda pendiente de revisión por un administrador.</div>
		)}
		{docResult === 'error' && (
			<div class="doc-alert ko" role="alert">{docMessage || 'No se pudo guardar tu RUT.'}</div>
		)}
		{docResult === 'config' && (
			<div class="doc-alert ko" role="alert">{docMessage || 'El almacenamiento no está disponible en el servidor.'}</div>
		)}

		{nitValue && (
			<div class="doc-current">
				<div class="doc-current-info">
					<span class="doc-label">NIT (Identificación Tributaria DIAN)</span>
					<code class="doc-file">{nitValue}</code>
				</div>
			</div>
		)}
		{hasRut && (
			<div class="doc-current">
				<div class="doc-current-info">
					<span class="doc-label">RUT emitido por la DIAN</span>
					<code class="doc-file">{rutFileName}</code>
				</div>
				<a href={rutLink} target="_blank" rel="noopener noreferrer" class="doc-view">
					{isPdf ? 'Ver PDF' : 'Ver imagen'}
				</a>
			</div>
		)}

		{/* El formulario se muestra siempre, también con el documento ya aprobado:
		    el aviso de arriba promete que se puede actualizar, y sin formulario ese
		    aviso sería falso. El endpoint vuelve a poner el estado en "pendiente". */}
		<form method="POST" action="/api/documents" enctype="multipart/form-data" class="doc-form">
				<div class="doc-field">
					<label for="nit">NIT (Identificación Tributaria DIAN)</label>
					<input
						type="text"
						id="nit"
						name="nit"
						value={nitValue}
						placeholder="Ej: 900123456"
						inputmode="numeric"
						required
						minlength="6"
						maxlength="20"
						pattern="[0-9]*"
						title="Solo números, entre 6 y 20 dígitos"
					/>
				</div>
				<div class="doc-field">
					<label for="rut">RUT emitido por la DIAN</label>
					<input
						type="file"
						id="rut"
						name="rut"
						accept="image/jpeg,image/png,image/webp,application/pdf"
						required={!hasRut}
					/>
					<p class="doc-hint">JPG, PNG, WEBP o PDF de hasta 5 MB.</p>
				</div>
				<button type="submit" class="gold-button">
				{hasRut || docApproved ? 'Actualizar NIT y RUT' : 'Subir NIT y RUT'}
			</button>
			{docApproved && (
				<p class="doc-hint">
					Tu documento está verificado. Si lo subes de nuevo, volverá a la lista de
					pendientes para que un administrador lo revise otra vez.
				</p>
			)}
			</form>
	</section>
</AdminPageLayout>

<style>
	.doc-box { padding: 28px; margin-bottom: 24px; }
	.doc-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
	.detail-title { margin: 0 0 20px; font-size: 1.2rem; border-bottom: 1px solid var(--gold-border); padding-bottom: 12px; }
	.doc-lead { color: var(--text-secondary); font-size: 14.5px; line-height: 1.6; }
	.doc-badge { flex: 0 0 auto; padding: 6px 14px; border-radius: 9999px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; border: 1px solid var(--gold-border); }
	.doc-badge.ok { background: rgba(16, 185, 129, 0.14); border-color: rgba(16, 185, 129, 0.45); color: #10b981; }
	.doc-badge.ko { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.45); color: #ef4444; }
	.doc-badge.wait { background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); }
	.doc-alert { padding: 12px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 18px; border: 1px solid; }
	.doc-alert.ok { background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.35); color: #10b981; }
	.doc-alert.ko { background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.35); color: #f87171; }
	.doc-current { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 16px; margin-bottom: 18px; background: rgba(212, 175, 55, 0.07); border: 1px solid var(--gold-border); border-radius: 12px; }
	.doc-current-info { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
	.doc-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); }
	.doc-file { font-family: monospace; font-size: 13.5px; color: var(--text-primary); word-break: break-all; overflow-wrap: anywhere; }
	.doc-view { flex: 0 0 auto; padding: 10px 18px; border-radius: 9999px; border: 1px solid var(--gold-border); background: rgba(212, 175, 55, 0.12); color: var(--gold-primary); font-weight: 700; font-size: 13.5px; text-decoration: none; transition: background 0.2s ease, border-color 0.2s ease; }
	.doc-view:hover { background: rgba(212, 175, 55, 0.22); border-color: var(--gold-primary); }
	.doc-form { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
	.doc-field { display: flex; flex-direction: column; gap: 8px; width: 100%; }
	.doc-field label { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
	.doc-field input { width: 100%; padding: 12px 14px; background: var(--bg-primary); border: 1px solid var(--gold-border); border-radius: 10px; color: var(--text-primary); font-family: inherit; font-size: 14px; }
	.doc-field input[type='file'] { padding: 10px 12px; font-size: 13px; cursor: pointer; }
	.doc-field input:focus { outline: none; border-color: var(--gold-primary); box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15); }
	.doc-note { font-size: 14px; color: var(--text-secondary); padding: 14px; border-radius: 10px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); }
	@media (max-width: 768px) {
		.doc-box { padding: 22px 18px; }
		.doc-heading { flex-direction: column; gap: 12px; }
	}
</style>
