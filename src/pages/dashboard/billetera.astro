---
/**
 * Billetera y retiros del miembro.
 *
 * El desglose se calcula con `buildWalletSummary`, la misma función que usa el
 * endpoint para autorizar un retiro: la cifra que se muestra y la que se acepta
 * no pueden separarse.
 */
import { isAdminRole } from '../../lib/auth';
import { getSheetUserLevel, getUserBalance, getUserWallet, canWithdraw } from '../../lib/users';
import { parseSheetBalance } from '../../lib/sheets';
import { listWithdrawals } from '../../lib/withdrawals';
import { listP2PPayments } from '../../lib/p2p-payments';
import { P2P_CONCEPTS, P2P_CONCEPT_INFO, canSubmitConcept, conceptAmount } from '../../lib/p2p';
import { buildWalletSummary, sumApproved, sumPending } from '../../lib/wallet-summary';
import { listMemberMoneyRequests } from '../../lib/member-money-requests';
import AdminPageLayout from '../../components/AdminPageLayout.astro';
import WalletOverview from '../../components/dashboard/WalletOverview.astro';
import UploadReceiptModal from '../../components/dashboard/UploadReceiptModal.astro';
import type { Session } from '../../lib/session';

export const prerender = false;

const session: Session = Astro.locals.user!;

const balance = await getUserBalance(session.username, session.email);
const level = await getSheetUserLevel(session.username, session.email);
const wallet = await getUserWallet(session.username, session.email);

// Si la hoja no responde, se muestran ceros en vez de inventar cifras.
let withdrawals: Awaited<ReturnType<typeof listWithdrawals>> = [];
let p2p: Awaited<ReturnType<typeof listP2PPayments>> = [];
try {
	withdrawals = await listWithdrawals(session.username);
} catch (error) {
	console.error('No se pudieron leer las solicitudes de retiro:', error);
}
try {
	p2p = await listP2PPayments(session.username);
} catch (error) {
	console.error('No se pudieron leer los pagos P2P:', error);
}

// `listWithdrawals` no filtra por usuario: trae las de toda la plataforma.
// Se filtran aquí antes de sumar, porque el saldo comprometido y el histórico
// de cada uno son datos suyos y no se muestran los de los demás.
const ownWithdrawals = withdrawals.filter(
	(request) => request.username.trim().toLowerCase() === session.username.trim().toLowerCase()
);

const summary = buildWalletSummary({
	balance: parseSheetBalance(balance),
	pendingWithdrawals: sumPending(ownWithdrawals),
	pendingPayments: sumPending(p2p),
	paidOut: sumApproved(ownWithdrawals),
});

const receiptConcepts = P2P_CONCEPTS.map((id) => {
	const info = P2P_CONCEPT_INFO[id];
	return { id, label: info.label, detail: info.detail, amount: conceptAmount(id, parseSheetBalance(balance)), enabled: canSubmitConcept(id, level) };
});

const isAdmin = isAdminRole(session.role);
const transferTo = Astro.url.searchParams.get('destino')?.trim() || '';
let moneyRequests: Awaited<ReturnType<typeof listMemberMoneyRequests>> = [];
try { moneyRequests = await listMemberMoneyRequests(session.username); }
catch (error) { console.error('No se pudieron cargar solicitudes de dinero:', error); }

const movements = [
	...p2p.map((payment) => ({
		date: payment.createdAt,
		concept: payment.concept,
		direction: 'Envío',
		amount: payment.amount,
		status: payment.status,
	})),
	...ownWithdrawals.map((request) => ({
		date: request.createdAt,
		concept: 'Solicitud de retiro',
		direction: 'Retiro',
		amount: request.amount,
		status: request.status,
	})),
	...moneyRequests.filter((request) => request.status === 'Pagado').map((request) => ({
		date: request.createdAt,
		concept: `Transferencia con ${request.requester.toLowerCase() === session.username.toLowerCase() ? request.recipient : request.requester}`,
		direction: request.requester.toLowerCase() === session.username.toLowerCase() ? 'Recibido' : 'Envío',
		amount: request.amount,
		status: 'Aprobado',
	})),
].sort((a, b) => String(b.date).localeCompare(String(a.date)));

---

<AdminPageLayout
	session={session}
	isAdmin={isAdmin}
	title="Mi billetera y movimientos"
	eyebrow="Mi cuenta"
	description="Consulta tu saldo, envíos, retiros y dinero recibido en un solo historial."
>
	<WalletOverview
		summary={summary}
		walletType={wallet?.walletType ?? ''}
		walletNumber={wallet?.walletNumber ?? ''}
		canWithdrawLevel={canWithdraw(level)}
		movements={movements}
		transferTo={transferTo}
		moneyRequests={moneyRequests}
		currentUsername={session.username}
	/>
	<section id="comprobantes" class="wallet-receipts" aria-label="Comprobantes de pago">
		<header><span>Pagos y soporte</span><h2>Comprobantes de pago</h2><p>Adjunta y consulta los comprobantes asociados a tus pagos.</p></header>
		<UploadReceiptModal concepts={receiptConcepts} payments={p2p} />
	</section>
</AdminPageLayout>

<style>
	.wallet-receipts{margin-top:24px;padding:24px;border:1px solid var(--gold-border);border-radius:16px;background:var(--bg-surface)}
	.wallet-receipts header{margin-bottom:18px}.wallet-receipts header>span{color:var(--gold-primary);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.wallet-receipts h2{margin:6px 0;font-size:1.2rem}.wallet-receipts header p{margin:0;color:var(--text-secondary);font-size:13px}
</style>
