---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// SSR: la página usa el Navbar, que lee la cookie de sesión
export const prerender = false;
---

<Layout title="Gana Dinero">
	<Navbar />

	<main class="main-content">
		<section class="section page-hero">
			<div class="section-container">
				<div class="section-header">
					<span class="section-badge font-cinzel">INGRESOS & RENTABILIDAD</span>
					<h1 class="section-title font-cinzel">
						Las <span class="gold-gradient-text">Vías para Gana Dinero</span>
					</h1>
					<p class="section-subtitle">
						Cuatro estrategias de ingreso diseñadas para convertir tu tiempo, tu equipo y tu capital en
						resultados medibles y sostenidos.
					</p>
				</div>
			</div>
		</section>

		<!-- ============ METODOLOGÍA: SISTEMA CONSTELACIÓN ============ -->
		<section class="section method-section" aria-labelledby="method-title">
			<div class="section-container">
				<div class="section-header">
					<span class="section-badge font-cinzel">METODOLOGÍA PROPIA</span>
					<h2 class="section-title font-cinzel" id="method-title">
						Sistema <span class="gold-gradient-text">Constelación</span>
					</h2>
					<p class="section-subtitle">
						Una estructura jerárquica de cinco niveles donde cada posición se sostiene sobre cinco posiciones
						inferiores. El avance no depende del azar: depende de la confirmación de los aportes de tu
						estructura.
					</p>
				</div>

				<!-- Niveles -->
				<div class="levels-grid">
					<div class="luxury-card level-card">
						<span class="level-num font-cinzel">01</span>
						<h3 class="level-name font-cinzel">Nivel 1</h3>
						<p class="level-desc">Posición de entrada. Todos los usuarios nuevos inician aquí.</p>
					</div>
					<div class="luxury-card level-card">
						<span class="level-num font-cinzel">02</span>
						<h3 class="level-name font-cinzel">Nivel 2</h3>
						<p class="level-desc">Recibe los aportes de sus 5 posiciones de Nivel 1 y confirma la estructura.</p>
					</div>
					<div class="luxury-card level-card">
						<span class="level-num font-cinzel">03</span>
						<h3 class="level-name font-cinzel">Nivel 3</h3>
						<p class="level-desc">Ascendente una vez validada la Base 2. Aloja 5 posiciones de Nivel 2.</p>
					</div>
					<div class="luxury-card level-card">
						<span class="level-num font-cinzel">04</span>
						<h3 class="level-name font-cinzel">Nivel 4</h3>
						<p class="level-desc">Ascendente por validación de la Base 3. Aloja 5 posiciones de Nivel 3.</p>
					</div>
					<div class="luxury-card level-card level-final">
						<span class="level-num font-cinzel">05</span>
						<h3 class="level-name font-cinzel">Nivel 5</h3>
						<p class="level-desc">
							Último nivel del ciclo. Aloja 5 posiciones de Nivel 4, envía el 35 % de lo que recibe a
							GANA PRO y retiene el 65 % menos el impuesto de plataforma.
						</p>
					</div>
				</div>

				<!-- Estructura jerárquica y distribución real -->
				<div class="luxury-card tree-box">
					<h3 class="cycle-title font-cinzel">La Estructura Jerárquica</h3>
					<p class="cycle-intro">
						La regla es única y se repite sin excepción: <strong class="accent">cada posición superior sostiene
						exactamente 5 posiciones inferiores</strong>, y cada una de ellas sostiene 5 más, hasta cerrar
						las cinco posiciones de la constelación.
					</p>

					<div class="tree-list" role="list">
						<div class="tree-row" role="listitem">
							<span class="tree-label font-cinzel">Nivel 1</span>
							<span class="tree-bar" style="--w: 100%"></span>
							<span class="tree-count">3.125</span>
						</div>
						<div class="tree-row" role="listitem">
							<span class="tree-label font-cinzel">Nivel 2</span>
							<span class="tree-bar" style="--w: 62%"></span>
							<span class="tree-count">625</span>
						</div>
						<div class="tree-row" role="listitem">
							<span class="tree-label font-cinzel">Nivel 3</span>
							<span class="tree-bar" style="--w: 32%"></span>
							<span class="tree-count">125</span>
						</div>
						<div class="tree-row" role="listitem">
							<span class="tree-label font-cinzel">Nivel 4</span>
							<span class="tree-bar" style="--w: 16%"></span>
							<span class="tree-count">25</span>
						</div>
						<div class="tree-row tree-row-top" role="listitem">
							<span class="tree-label font-cinzel">Nivel 5</span>
							<span class="tree-bar" style="--w: 8%"></span>
							<span class="tree-count">5</span>
						</div>
					</div>
						<div class="tree-stats">
						<div class="tree-stat">
							<span class="tree-stat-value font-cinzel">3.906</span>
							<span class="tree-stat-label">Posiciones totales</span>
						</div>
						<div class="tree-stat">
							<span class="tree-stat-value font-cinzel">80 %</span>
							<span class="tree-stat-label">Ocupan el Nivel 1</span>
						</div>
						<div class="tree-stat">
							<span class="tree-stat-value font-cinzel">5</span>
							<span class="tree-stat-label">Niveles en la constelación</span>
						</div>
					</div>

					<div class="risk-note">
						<h4 class="risk-title font-cinzel">Lectura Honesta de las Cifras</h4>
						<p>
							Una constelación completa requiere <strong class="accent">3.906 personas</strong>. De ellas,
							<strong class="accent">3.125 están en la base</strong> y aportan los $15.000 que sostienen a
							los niveles superiores: la base representa el
							<strong class="accent">80 % de toda la estructura</strong> y aporta los
							<strong class="accent">$46.875.000</strong>. Para alcanzar el Nivel 5 existen 3.901
							posiciones por debajo.
						</p>
						<p>
							La estructura solo se completa mediante la captación continuada de nuevos participantes. El
							rendimiento de cada posición depende por completo del número de personas que consiga
							incorporar por debajo, sin garantía de completarla.
						</p>
					</div>
				</div>

				<!-- Flujo de fondos -->
				<div class="luxury-card flow-box">
					<h3 class="cycle-title font-cinzel">El Flujo de Fondos</h3>
					<p class="cycle-intro">
						Los niveles 2, 3 y 4 reenvían a su superior el 50 % de lo que reciben. El Nivel 5 rompe la regla:
						entrega el 35 % a GANA PRO y retiene el 65 % antes del impuesto de plataforma.
					</p>

					<div class="flow-table" role="table" aria-label="Flujo de fondos por nivel">
						<div class="flow-row flow-head" role="row">
							<span role="columnheader">Nivel</span>
							<span role="columnheader">Envía</span>
							<span role="columnheader">Recibe</span>
							<span role="columnheader">Retiene</span>
						</div>
						<div class="flow-row" role="row">
							<span class="flow-level font-cinzel" role="cell">N1 → N2</span>
							<span role="cell" data-label="Envía">$15.000</span>
							<span class="flow-in" role="cell" data-label="Recibe">$75.000</span>
							<span role="cell" data-label="Retiene">—</span>
						</div>
						<div class="flow-row" role="row">
							<span class="flow-level font-cinzel" role="cell">N2 → N3</span>
							<span role="cell" data-label="Envía">$37.500</span>
							<span class="flow-in" role="cell" data-label="Recibe">$187.500</span>
							<span class="flow-keep" role="cell" data-label="Retiene">$37.500</span>
						</div>
						<div class="flow-row" role="row">
							<span class="flow-level font-cinzel" role="cell">N3 → N4</span>
							<span role="cell" data-label="Envía">$93.750</span>
							<span class="flow-in" role="cell" data-label="Recibe">$468.750</span>
							<span class="flow-keep" role="cell" data-label="Retiene">$93.750</span>
						</div>
						<div class="flow-row" role="row">
							<span class="flow-level font-cinzel" role="cell">N4 → N5</span>
							<span role="cell" data-label="Envía">$234.375</span>
							<span class="flow-in" role="cell" data-label="Recibe">$1.171.875</span>
							<span class="flow-keep" role="cell" data-label="Retiene">$234.375</span>
						</div>
						<div class="flow-row" role="row">
							<span class="flow-level font-cinzel" role="cell">N5 → GANA PRO</span>
							<span role="cell" data-label="Envía">$410.000</span>
							<span class="flow-in" role="cell" data-label="Recibe">$2.050.000</span>
							<span class="flow-keep" role="cell" data-label="Retiene">$761.875</span>
						</div>
					</div>

					<div class="tax-box">
						<h4 class="tax-title font-cinzel">Cierre del Ciclo e Impuesto de Plataforma</h4>
						<p>
							El Nivel 5 es el último escalón. Cada posición recibe
							<strong class="accent">$1.171.875</strong> de sus 5 posiciones de Nivel 4 y destina
							<strong class="accent">$410.000</strong> a GANA PRO, el <strong class="accent">35 %</strong> de
							lo recibido. A diferencia de los niveles 2, 3 y 4, que reenvían el 50 %, el Nivel 5 retiene el
							<strong class="accent">65 %</strong>: <strong class="accent">$761.875</strong>.
						</p>
						<p>
							Sobre ese 65 % retenido se aplica el <strong class="accent">5 %</strong> de impuesto por uso de
							la plataforma, equivalente a <strong class="accent">$38.093,75</strong>. La utilidad neta
							del Nivel 5 es de <strong class="accent">$723.781,25</strong> por posición.
						</p>
						<p class="tax-note">
							Los cinco Nivel 5 destinan $410.000 cada uno, de modo que GANA PRO percibe
							<strong class="accent">$2.050.000</strong> por constelación completa.
						</p>
					</div>

					<div class="risk-note">
						<h4 class="risk-title font-cinzel">Reparto Real del Dinero de la Base</h4>
						<p>
							De los <strong class="accent">$46.875.000</strong> que aporta la base, la distribución es:
							Nivel 2 se queda <strong class="accent">$23.437.500</strong> (50 %), Nivel 3
							<strong class="accent">$11.718.750</strong> (25 %), Nivel 4
							<strong class="accent">$5.859.375</strong> (12,5 %), Nivel 5
							<strong class="accent">$3.809.375</strong> (8,1 %) y GANA PRO
							<strong class="accent">$2.050.000</strong> (4,4 %).
						</p>
						<p>
							El <strong class="accent">95,6 % del dinero</strong> captado por la estructura se queda en los
							niveles de participantes; GANA PRO percibe el 4,4 % restante. El Nivel 5 es la única posición
							que retiene más de la mitad: gana <strong class="accent">$723.781,25</strong> netos frente a
							los $37.500 de un Nivel 2, pero para alcanzarlo necesita
							<strong class="accent">3.901 personas</strong> por debajo. Un participante en el Nivel 1 que
							logra llegar al Nivel 2 obtiene <strong class="accent">$37.500</strong> frente a los $15.000
							que aportó: una rentabilidad del <strong class="accent">150 %</strong> que solo se alcanza
							captando a 5 personas. Quien no completa su grupo de 5 no recibe nada y pierde los $15.000.
						</p>
					</div>
				</div>

				<!-- Ciclo de confirmación -->
				<div class="luxury-card cycle-box">
					<h3 class="cycle-title font-cinzel">El Ciclo de Confirmación</h3>
					<p class="cycle-intro">
						Cada ascenso se produce en cuatro movimientos consecutivos. Ningún nivel se alcanza
						automáticamente: requiere la verificación de los aportes de la base.
					</p>
					<ol class="cycle-list">
						<li>
							<span class="cycle-step font-cinzel">I</span>
							<div>
								<h4 class="cycle-name font-cinzel">Registro</h4>
								<p>Cada usuario nuevo ocupa una posición de Nivel 1 dentro de la estructura.</p>
							</div>
						</li>
						<li>
							<span class="cycle-step font-cinzel">II</span>
							<div>
								<h4 class="cycle-name font-cinzel">Aporte</h4>
								<p>
									Cada una de las 5 posiciones de Nivel 1 envía un aporte de
									<strong class="accent">$15.000</strong> a su posición de Nivel 2 correspondiente, que
									recibe un total de <strong class="accent">$75.000</strong>.
								</p>
							</div>
						</li>
						<li>
							<span class="cycle-step font-cinzel">III</span>
							<div>
								<h4 class="cycle-name font-cinzel">Confirmación</h4>
								<p>
									La posición de Nivel 2 verifica y confirma que las 5 posiciones de su base han completado
									el aporte.
								</p>
							</div>
						</li>
						<li>
							<span class="cycle-step font-cinzel">IV</span>
							<div>
								<h4 class="cycle-name font-cinzel">Ascenso</h4>
								<p>
									Confirmado el aporte, las 5 posiciones de Nivel 1 pasan a Nivel 2, la posición validada
									pasa a Nivel 3, y el Nivel 1 queda libre para nuevos registros.
								</p>
							</div>
						</li>
					</ol>
					<p class="cycle-note">
						La confirmación de la Base 2 habilita el ascenso a Nivel 3. El mismo principio se repite de forma
						idéntica entre los niveles 2, 3 y 4. Al llegar al <strong class="accent">Nivel 5</strong> el ciclo
						se cierra: el Nivel 5 envía el 35 % a GANA PRO y retiene el 65 % restante, sobre el que se aplica
						el impuesto de plataforma.
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="paths-grid">
					<div class="luxury-card path-card">
						<div class="card-icon-box">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="12" y1="1" x2="12" y2="23"></line>
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Rendimiento de Cartera</h2>
						<p class="card-desc">
							Portafolios diversificados en divisas premium, metales preciosos e instrumentos de alta
							liquidez, gestionados con precisión institucional y ejecución milimétrica.
						</p>
					</div>

					<div class="luxury-card path-card featured">
						<div class="featured-badge">MÁS RENTABLE</div>
						<div class="card-icon-box">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
								<polyline points="17 6 23 6 23 12"></polyline>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Analítica Cuántica</h2>
						<p class="card-desc">
							Modelos predictivos que procesan señales de mercado en tiempo real para maximizar retornos y
							minimizar la volatilidad.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="paths-grid">
					<div class="luxury-card path-card">
						<div class="card-icon-box">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="9" cy="7" r="4"></circle>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Red de Referidos</h2>
						<p class="card-desc">
							Construye tu estructura de equipo y activa comisiones recurrentes por cada usuario que
							registres dentro de tu red.
						</p>
					</div>

					<div class="luxury-card path-card">
						<div class="card-icon-box">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
							</svg>
						</div>
						<h2 class="card-title font-cinzel">Bóveda Privada</h2>
						<p class="card-desc">
							Protección institucional de grado con cifrado PBKDF2 y monitoreo continuo para que tu capital
							trabaje sin reposo.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="luxury-card steps-box">
					<h2 class="cta-title font-cinzel">¿Cómo se Genera tu Ingreso?</h2>
					<ol class="steps-list">
						<li>
							<span class="step-num font-cinzel">01</span>
							<div>
								<h3 class="step-title font-cinzel">Crea tu cuenta</h3>
								<p>Registro en minutos con verificación de identidad y acceso inmediato al portal seguro.</p>
							</div>
						</li>
						<li>
							<span class="step-num font-cinzel">02</span>
							<div>
								<h3 class="step-title font-cinzel">Elige tu nivel</h3>
								<p>Gold Reserve o Black Diamond según tu perfil de capital y ambición de crecimiento.</p>
							</div>
						</li>
						<li>
							<span class="step-num font-cinzel">03</span>
							<div>
								<h3 class="step-title font-cinzel">Activa tu estructura</h3>
								<p>Configura tu estrategia, invita a tu red y accede a las oportunidades priorizadas.</p>
							</div>
						</li>
						<li>
							<span class="step-num font-cinzel">04</span>
							<div>
								<h3 class="step-title font-cinzel">Recibe tus retornos</h3>
								<p>Consulta el seguimiento de ingresos directamente en tu panel de miembro.</p>
							</div>
						</li>
					</ol>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="luxury-card cta-box">
					<div class="cta-content">
						<h2 class="cta-title font-cinzel">Empieza a Ganar Dinero Hoy</h2>
						<p class="cta-desc">Únete a miles de líderes e inversores que disfrutan del poder de GANA PRO.</p>
						<div class="cta-btns">
							<a href="/register" class="gold-button">Crear Cuenta Exclusiva</a>
							<a href="/login" class="ghost-gold-button">Ya Soy Miembro</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.main-content {
		position: relative;
		overflow: hidden;
	}

	.section {
		padding: 85px 24px;
	}

	.section-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 55px;
	}

	.section-badge {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		font-weight: 700;
		color: var(--gold-primary);
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 800;
		margin-bottom: 16px;
		line-height: 1.2;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 620px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.page-hero {
		padding-top: 70px;
		padding-bottom: 20px;
	}

	/* ============ METODOLOGÍA: SISTEMA CONSTELACIÓN ============ */
	.method-section {
		background: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.06) 0%, transparent 55%);
	}

	.levels-grid {
		display: grid;
		/* 5 tarjetas: 3 columnas dejaría una fila huérfana de 2 */
		grid-template-columns: repeat(5, 1fr);
		gap: 20px;
		margin-bottom: 46px;
	}

	.level-card {
		padding: 30px 26px;
		display: flex;
		flex-direction: column;
		position: relative;
		/* Línea conectora superior entre niveles, puramente decorativa */
		border-top: 2px solid var(--gold-border);
	}

	/* El Nivel 5 se destaca como cúspide de la constelación */
	.level-final {
		border-color: var(--gold-primary);
		background: linear-gradient(180deg, rgba(212, 175, 55, 0.1) 0%, var(--bg-card) 55%);
		box-shadow: 0 0 34px rgba(212, 175, 55, 0.2);
	}

	.level-num {
		font-size: 2.1rem;
		font-weight: 900;
		line-height: 1;
		color: var(--gold-primary);
		margin-bottom: 14px;
	}

	.level-name {
		font-size: 1.2rem;
		font-weight: 800;
		margin-bottom: 10px;
	}

	.level-desc {
		font-size: 0.92rem;
		color: var(--text-secondary);
		line-height: 1.65;
	}

	/* ---- Ciclo de confirmación ---- */
	.cycle-box {
		padding: 48px 42px;
	}

	.cycle-title {
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		font-weight: 800;
		margin-bottom: 14px;
		text-align: center;
	}

	.cycle-intro {
		font-size: 1.02rem;
		color: var(--text-muted);
		line-height: 1.7;
		max-width: 720px;
		margin: 0 auto 38px;
		text-align: center;
	}

	.cycle-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
