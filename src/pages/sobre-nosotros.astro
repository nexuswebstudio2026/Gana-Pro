---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// SSR: la página usa el Navbar, que lee la cookie de sesión
export const prerender = false;
---

<Layout title="Sobre Nosotros">
	<Navbar />

	<main class="main-content">
		<section class="section page-hero">
			<div class="section-container">
				<div class="section-header">
					<span class="section-badge font-cinzel">QUIÉNES SOMOS</span>
					<h1 class="section-title font-cinzel">
						Por Qué Existe <span class="gold-gradient-text">GANA PRO</span>
					</h1>
					<p class="section-subtitle">
						Una plataforma creada para que cualquier persona pueda acceder a estrategias de ingreso
						estructuradas, con reglas claras y sin depender de quién te las recomendaron.
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="about-grid">
					<div class="about-content">
						<h2 class="block-title font-cinzel">El <span class="gold-gradient-text">Problema</span></h2>
						<p class="block-text">
							Las vías para generar ingresos rara vez son transparentes. Quien empieza no sabe cuánto va a
							ganar, en cuánto tiempo ni bajo qué condiciones. La información suele estar en manos de
							quien la vende, no de quien la necesita.
						</p>
						<p class="block-text">
							Además, las oportunidades de inversión de calidad han quedado reservadas para patrimonios
							grandes o para unos pocos que saben moverse. Quien no tiene contactos ni capital
							históricamente alto tiene, en la práctica, las mismas opciones que el resto.
						</p>
					</div>
					<div class="about-content">
						<h2 class="block-title font-cinzel">La <span class="gold-gradient-text">Propuesta</span></h2>
						<p class="block-text">
							GANA PRO nace para cerrar esa brecha. Centralizamos en un solo lugar la metodología de
							ingreso, las reglas de cada nivel y el detalle de cuánto se aporta y cuánto se recibe en
							cada paso.
						</p>
						<p class="block-text">
							Cualquier miembro registrado puede publicar su experiencia y valorar la metodología de 1 a 5
							estrellas, incluidas las valoraciones negativas. La media se muestra sin filtrar.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="pillars-grid">
					<div class="luxury-card pillar">
						<h3 class="pillar-title font-cinzel">Transparencia</h3>
						<p class="pillar-text">
							Todas las cifras de la metodología están publicadas, incluidos los porcentajes que se
							retienen en cada nivel y el importe que no sale de la estructura.
						</p>
					</div>
					<div class="luxury-card pillar">
						<h3 class="pillar-title font-cinzel">Accesibilidad</h3>
						<p class="pillar-text">
							No se requiere experiencia previa en inversiones. El proceso está documentado paso a paso
							para que cualquiera pueda entenderlo antes de decidirse.
						</p>
					</div>
					<div class="luxury-card pillar">
						<h3 class="pillar-title font-cinzel">Voz de los miembros</h3>
						<p class="pillar-text">
							Los testimonios y las valoraciones los escriben usuarios registrados, sin edición de su
							contenido. Nadie cobra por dejar una opinión.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-container">
				<div class="luxury-card cta-box">
					<div class="cta-content">
						<h2 class="cta-title font-cinzel">Conoce la Metodología por Ti Mismo</h2>
						<p class="cta-desc">
							Consulta todas las cifras, los niveles y el flujo de dinero antes de decidir. También puedes
							leer lo que dicen los miembros registrados.
						</p>
						<div class="cta-btns">
							<a href="/gana-dinero" class="gold-button">Ver la Metodología</a>
							<a href="/#testimonios" class="ghost-gold-button">Leer Testimonios</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.main-content {
		position: relative;
		overflow: hidden;
	}

	.section {
		padding: 85px 24px;
	}

	.section-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 55px;
	}

	.section-badge {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		font-weight: 700;
		color: var(--gold-primary);
		text-transform: uppercase;
		display: inline-block;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 800;
		margin-bottom: 16px;
		line-height: 1.2;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: var(--text-muted);
		max-width: 620px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.page-hero {
		padding-top: 70px;
		padding-bottom: 20px;
	}

	.about-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 50px;
	}

	.block-title {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		font-weight: 800;
		margin-bottom: 20px;
	}

	.block-text {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.8;
		margin-bottom: 18px;
	}

	.block-text strong {
		color: var(--text-primary);
	}

	/* ---- Pilares ---- */
	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 26px;
	}

	.pillar {
		padding: 32px 28px;
	}

	.pillar-title {
		font-size: 1.2rem;
		font-weight: 800;
		color: var(--gold-primary);
		margin-bottom: 14px;
	}

	.pillar-text {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.cta-box {
		padding: 60px 30px;
		text-align: center;
		background: radial-gradient(circle at center, rgba(30, 58, 138, 0.25) 0%, var(--bg-card) 75%);
		border: 1px solid var(--gold-border);
	}

	.cta-content {
		max-width: 680px;
		margin: 0 auto;
	}

	.cta-title {
		font-size: clamp(2rem, 3.5vw, 2.7rem);
		font-weight: 800;
		margin-bottom: 16px;
	}

	.cta-desc {
		font-size: 1.05rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 34px;
	}

	.cta-btns {
		display: flex;
		justify-content: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.pillars-grid {
			grid-template-columns: 1fr;
			gap: 18px;
		}
	}

	/* ============ MÓVIL ============ */
	@media (max-width: 640px) {
		.section {
			padding: 52px 18px;
		}

		.section-header {
			margin-bottom: 34px;
		}

		.page-hero {
			padding-top: 44px;
			padding-bottom: 10px;
		}

		.about-grid {
			gap: 30px;
		}

		.block-text {
			font-size: 0.97rem;
			line-height: 1.75;
		}

		.cta-box {
			padding: 38px 20px;
		}

		.cta-desc {
			margin-bottom: 26px;
		}

		.cta-btns {
			flex-direction: column;
		}

		.cta-btns a {
			width: 100%;
		}
	}

	@media (max-width: 360px) {
		.section {
			padding: 42px 14px;
		}
	}
</style>
