---
/**
 * Portada de GANA PRO.
 *
 * Este archivo es un índice de secciones, no un documento: cada bloque vive en su
 * propio componente y aquí solo se decide el orden en que se leen. Antes eran
 * casi 1.600 líneas de marcado y estilos entremezclados, y dos consecuencias
 * prácticas:
 *
 *   1. El orden no contaba. "¿Cómo se genera tu ingreso?" —el paso que más
 *      interesa a quien acaba de llegar— estaba después de varias páginas de
 *      metodología, y la portada abría con un encabezado de sección sin nada
 *      debajo.
 *   2. Los estilos tenían ámbito de página, así que los componentes que la
 *      portada inserta (`FaqSection`, `TestimonialsSection`) usaban clases como
 *      `.section` que ninguna regla alcanzaba: salían sin relleno ni centrado.
 *
 * El orden nuevo es: qué es → cuánto se gana → por dónde empezar → detalle de
 * cada vía → servicios → prueba social → dudas → cierre. La calculadora 5x1 vive
 * dentro del hero, porque simula el ciclo completo y es lo primero que un
 * visitante escapa: cuánto pone, cuánto le devuelven y qué se queda cada uno.
 *
 * El sistema visual vive en `styles/landing.css`, que sí es global y sí alcanza a
 * todos los componentes de la página.
 */
import '../styles/landing.css';

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ActivityFeed from '../components/ActivityFeed.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';

import FigureBand from '../components/home/FigureBand.astro';
import WaysSection from '../components/home/WaysSection.astro';
import HowItWorksSection from '../components/home/HowItWorksSection.astro';
import ConstellationSection from '../components/home/ConstellationSection.astro';
import ReferralsSection from '../components/home/ReferralsSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import CtaSection from '../components/home/CtaSection.astro';

import { validateSession } from '../lib/session';

// SSR: la página usa el Navbar, que lee la cookie de sesión
export const prerender = false;

// La barra inferior solo sirve a quien todavía no tiene cuenta: si ya está
// conectado, un "crear cuenta" lo mandaría a un formulario que no necesita.
const session = validateSession(Astro.cookies.get('auth_session')?.value);
const showBottomBar = !session;
---

<Layout
	title="Gana Dinero"
	description="Las vías para generar ingresos en GANA PRO: Sistema Constelación y Referidos, con una estructura de cinco niveles, una calculadora que simula tu ciclo completo y reglas claras."
>
	<Navbar />

	<main class="main-content">
		<HeroSection />

		{/*
			Las cifras clave van nada más pasar el hero: son la respuesta corta a
			"¿cuánto cuesta y cuánto produce?" y dan la medida de lo que se explica
			después.
		*/}
		<div class="figure-slot">
			<FigureBand />
		</div>

		{/* Aviso de actividad: da sensación de vida al entrar. */}
		<div class="activity-slot">
			<ActivityFeed />
		</div>

		{/* Qué es y por dónde empezar, antes del detalle. */}
		<WaysSection />
		<HowItWorksSection />

		{/* Detalle de cada vía. */}
		<ConstellationSection />
		<ReferralsSection />

		<ServicesSection />

		{/* Prueba social: los testimonios salen de Google Sheets, con su media real. */}
		<TestimonialsSection session={session} />

		{/* FAQ antes del cierre: es la última duda que frena el registro. */}
		<FaqSection />

		<CtaSection />
	</main>

	{showBottomBar && <MobileBottomBar />}
</Layout>
<style>
	.main-content {
		position: relative;
		overflow: hidden;
	}

	/*
		Los bloques que envuelven `FigureBand` y `ActivityFeed` no son secciones con
		encabezado: solo sirven para limitar el ancho y poner el aire justo, sin
		duplicar el ritmo vertical que ya da `landing.css`.
	*/
	.figure-slot {
		max-width: var(--landing-max);
		margin: 0 auto;
		padding: 0 var(--landing-gutter) 28px;
	}

	.activity-slot {
		max-width: var(--landing-max);
		margin: 0 auto;
		padding: 0 var(--landing-gutter);
	}
</style>