---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AdvantagesSection from '../components/AdvantagesSection.astro';
import MembershipSection from '../components/MembershipSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import Footer from '../components/Footer.astro';
import { validateSession } from '../lib/session';

export const prerender = false;

const token = Astro.cookies.get('auth_session')?.value;
const session = validateSession(token);
---

<Layout title="Plataforma de Lujo, Inversión & Prestigio">
	<Navbar />

	<main class="main-content">
		<HeroSection />
		<ServicesSection />
		<AdvantagesSection />
		<MembershipSection />
		<TestimonialsSection session={session} />
	</main>

	<Footer />
</Layout>

<style>
	.main-content {
		position: relative;
		overflow: hidden;
	}
</style>

