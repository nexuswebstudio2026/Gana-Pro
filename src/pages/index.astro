---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AdvantagesSection from '../components/AdvantagesSection.astro';
import MembershipSection from '../components/MembershipSection.astro';
import Footer from '../components/Footer.astro';

export const prerender = false;
---

<Layout title="Plataforma de Lujo, Inversión & Prestigio">
	<Navbar />

	<main class="main-content">
		<HeroSection />
		<ServicesSection />
		<AdvantagesSection />
		<MembershipSection />
	</main>

	<Footer />
</Layout>

<style>
	.main-content {
		position: relative;
		overflow: hidden;
	}
</style>

