      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Montserrat:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.font-cinzel{font-family:'Cinzel',serif}\n.font-mont{font-family:'Montserrat',sans-serif}\n</style>\n<div class=\"font-mont bg-[#0a0e17] text-[#f8fafc] min-h-[1040px] grid grid-cols-[260px_minmax(0,1fr)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Sidebar -->\n    <aside class=\"bg-[#0d1322] border-r border-[#d4af37]/30 flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex items-center gap-3 px-5 h-16 border-b border-[#d4af37]/20\" data-kid=\"1-1-1\" data-name=\"brand logo header bar\">\n            <span class=\"w-9 h-9 rounded-lg bg-[#d4af37] text-[#0a0e17] font-cinzel font-bold grid place-items-center text-[13px]\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">\n                GP\n            </span>\n            <span class=\"font-cinzel font-bold text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                GANA\n                <span class=\"text-[#d4af37]\" data-kid=\"1-1-1-2-1\" data-name=\"brand product name highlight\">\n                    PRO\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Secciones del panel\" class=\"flex flex-col gap-1 p-3 pt-4\" data-kid=\"1-1-2\" data-name=\"sidebar main navigation\">\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-1\" data-name=\"nav link to home section\" href=\"#\">\n                <i class=\"ti ti-home text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"home house icon\">\n                </i>\n                Inicio\n            </a>\n            <a aria-current=\"page\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-semibold text-[#d4af37] bg-[#d4af37]/12\" data-kid=\"1-1-2-2\" data-name=\"active nav link to org chart\" href=\"#\">\n                <i class=\"ti ti-sitemap text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"sitemap tree icon\">\n                </i>\n                Mi organigrama 5x1\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-3\" data-name=\"nav link to wallet\" href=\"#\">\n                <i class=\"ti ti-wallet text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"wallet money icon\">\n                </i>\n                Mi billetera\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-4\" data-name=\"nav link to user profile\" href=\"#\">\n                <i class=\"ti ti-user-circle text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"profile user circle icon\">\n                </i>\n                Mi perfil\n            </a>\n        </nav>\n        <div class=\"mt-auto p-3 border-t border-[#d4af37]/20\" data-kid=\"1-1-3\" data-name=\"sidebar footer user area\">\n            <div class=\"flex items-center gap-3 px-2 py-2\" data-kid=\"1-1-3-1\" data-name=\"current user summary row\">\n                <span class=\"w-9 h-9 rounded-full bg-[#d4af37]/18 text-[#d4af37] grid place-items-center font-bold text-[13px]\" data-kid=\"1-1-3-1-1\" data-name=\"user initial avatar badge\">\n                    A\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-1-3-1-2\" data-name=\"user name and level text container\">\n                    <p class=\"text-[13.5px] font-semibold truncate\" data-kid=\"1-1-3-1-2-1\" data-name=\"logged-in username text\">\n                        andres_mora\n                    </p>\n                    <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-1-3-1-2-2\" data-name=\"user level and tier text\">\n                        Nivel 2 · Plata\n                    </p>\n                </div>\n            </div>\n            <a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-[13.5px] text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-3-2\" data-name=\"log out link\" href=\"#\">\n                <i class=\"ti ti-logout text-[17px]\" data-kid=\"1-1-3-2-1\" data-name=\"log out arrow icon\">\n                </i>\n                Cerrar sesión\n            </a>\n        </div>\n    </aside>\n    <div class=\"min-w-0\" data-kid=\"1-2\" data-name=\"main content area\">\n        <header class=\"h-16 flex items-center justify-between px-9 border-b border-[#d4af37]/20\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n            <p class=\"text-[13.5px] text-[#94a3b8]\" data-kid=\"1-2-1-1\" data-name=\"panel title text\">\n                Panel de miembro\n            </p>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-2-1-2\" data-name=\"header right controls container\">\n                <div class=\"text-right\" data-kid=\"1-2-1-2-1\" data-name=\"available balance display\">\n                    <p class=\"text-[12px] text-[#94a3b8]\" data-kid=\"1-2-1-2-1-1\" data-name=\"available balance label\">\n                        Saldo disponible\n                    </p>\n                    <p class=\"text-[15px] font-bold text-[#d4af37] leading-tight\" data-kid=\"1-2-1-2-1-2\" data-name=\"available balance amount\">\n                        $185.000\n                    </p>\n                </div>\n                <span class=\"h-8 w-px bg-[#d4af37]/25\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider between header items\">\n                </span>\n                <button aria-label=\"Cambiar tema\" class=\"w-9 h-9 rounded-lg border border-[#d4af37]/30 text-[#94a3b8] grid place-items-center hover:text-[#d4af37]\" data-kid=\"1-2-1-2-3\" data-name=\"theme toggle button\" type=\"button\">\n                    <i class=\"ti ti-sun text-[17px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"sun theme icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <main class=\"px-9 py-8 max-w-[1080px] mx-auto flex flex-col gap-8\" data-kid=\"1-2-2\" data-name=\"main dashboard content\">\n            <!-- Encabezado + progreso -->\n            <div class=\"flex items-end justify-between gap-6 flex-wrap\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <h1 class=\"font-cinzel text-[28px] font-bold leading-tight\" data-kid=\"1-2-2-1-1-1\">\n                        Mi organigrama 5x1\n                    </h1>\n                    <p class=\"mt-1.5 text-[14.5px] text-[#94a3b8]\" data-kid=\"1-2-2-1-1-2\">\n                        Tu líder, tu puesto y tus cinco usuarios directos. Un puesto cuenta cuando su recarga inicial queda verificada.\n                    </p>\n                </div>\n                <span class=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#d4af37]/40 text-[13.5px] font-semibold text-[#d4af37]\" data-kid=\"1-2-2-1-2\">\n                    <i class=\"ti ti-diamond text-[16px]\" data-kid=\"1-2-2-1-2-1\">\n                    </i>\n                    Nivel 2 · Plata\n                </span>\n            </div>\n            <section aria-label=\"Progreso de ascenso\" class=\"border-y border-[#d4af37]/20 py-5\" data-kid=\"1-2-2-2\">\n                <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"1-2-2-2-1\">\n                    <p class=\"text-[15px]\" data-kid=\"1-2-2-2-1-1\">\n                        <strong class=\"text-[22px] font-bold text-white\" data-kid=\"1-2-2-2-1-1-1\">\n                            2 de 5\n                        </strong>\n                        <span class=\"text-[#cbd5e1]\" data-kid=\"1-2-2-2-1-1-2\">\n                            puestos activos\n                        </span>\n                    </p>\n                    <p class=\"text-[13.5px] text-[#94a3b8]\" data-kid=\"1-2-2-2-1-2\">\n                        Te faltan\n                        <strong class=\"text-white\" data-kid=\"1-2-2-2-1-2-1\">\n                            3\n                        </strong>\n                        para el Nivel 3 · Rubí\n                    </p>\n                </div>\n                <div aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"40\" class=\"mt-3 h-2 rounded-full bg-white/8 overflow-hidden\" data-kid=\"1-2-2-2-2\" role=\"progressbar\">\n                    <div class=\"h-full w-[40%] bg-[#d4af37]\" data-kid=\"1-2-2-2-2-1\">\n                    </div>\n                </div>\n                <div class=\"mt-3 flex items-center gap-5 text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-2-3\">\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-1\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-2-3-1-1\">\n                        </span>\n                        Activo · recarga verificada\n                    </span>\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-2\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#eab308]\" data-kid=\"1-2-2-2-3-2-1\">\n                        </span>\n                        Pendiente · comprobante en revisión\n                    </span>\n                    <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-3\">\n                        <span class=\"w-2 h-2 rounded-full border border-[#64748b]\" data-kid=\"1-2-2-2-3-3-1\">\n                        </span>\n                        Libre · puesto sin usuario\n                    </span>\n                </div>\n            </section>\n            <!-- Árbol -->\n            <section aria-label=\"Mi red 5x1\" class=\"flex flex-col items-center\" data-kid=\"1-2-2-3\">\n                <!-- Líder -->\n                <div class=\"w-[520px] rounded-xl border border-[#d4af37]/30 bg-[#12192b]/75 px-5 py-4 flex items-center gap-4\" data-kid=\"1-2-2-3-1\">\n                    <span aria-hidden=\"true\" class=\"w-11 h-11 rounded-full bg-[#d4af37]/18 text-[#d4af37] grid place-items-center font-bold text-[15px]\" data-kid=\"1-2-2-3-1-1\">\n                        C\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-3-1-2\">\n                        <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-3-1-2-1\">\n                            Tu líder · te trajo a la plataforma\n                        </p>\n                        <p class=\"text-[15.5px] font-semibold leading-tight\" data-kid=\"1-2-2-3-1-2-2\">\n                            carolina_ruiz\n                        </p>\n                        <p class=\"text-[13px] text-[#cbd5e1]\" data-kid=\"1-2-2-3-1-2-3\">\n                            Nivel 3 · Rubí\n                        </p>\n                    </div>\n                    <button class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#d4af37] text-[#0a0e17] text-[13.5px] font-bold hover:bg-[#e0bd4e]\" data-kid=\"1-2-2-3-1-3\" type=\"button\">\n                        <i class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-2-2-3-1-3-1\">\n                        </i>\n                        Enviar dinero\n                    </button>\n                </div>\n                <span aria-hidden=\"true\" class=\"w-px h-8 bg-[#d4af37]/40\" data-kid=\"1-2-2-3-2\">\n                </span>\n                <!-- Usuario conectado -->\n                <div class=\"w-[520px] rounded-xl border border-[#d4af37] bg-gradient-to-r from-[#d4af37]/18 to-[#12192b] px-5 py-4 flex items-center gap-4\" data-kid=\"1-2-2-3-3\">\n                    <span aria-hidden=\"true\" class=\"w-11 h-11 rounded-full bg-[#d4af37] text-[#0a0e17] grid place-items-center font-bold text-[15px]\" data-kid=\"1-2-2-3-3-1\">\n                        A\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-3-3-2\">\n                        <p class=\"text-[12.5px] text-[#d4af37] font-semibold\" data-kid=\"1-2-2-3-3-2-1\">\n                            Tú · raíz de tu rama\n                        </p>\n                        <p class=\"text-[15.5px] font-semibold leading-tight\" data-kid=\"1-2-2-3-3-2-2\">\n                            andres_mora\n                        </p>\n                        <p class=\"text-[13px] text-[#cbd5e1]\" data-kid=\"1-2-2-3-3-2-3\">\n                            Nivel 2 · Plata · código\n                            <span class=\"font-mono text-[#d4af37]\" data-kid=\"1-2-2-3-3-2-3-1\">\n                                ANDRES-2026\n                            </span>\n                        </p>\n                    </div>\n                    <p class=\"text-right text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-3-3-3\">\n                        Rama total\n                        <br data-kid=\"1-2-2-3-3-3-1\"/>\n                        <strong class=\"text-white text-[16px]\" data-kid=\"1-2-2-3-3-3-2\">\n                            7 personas\n                        </strong>\n                    </p>\n                </div>\n                <span aria-hidden=\"true\" class=\"w-px h-8 bg-[#d4af37]/40\" data-kid=\"1-2-2-3-4\">\n                </span>\n                <!-- 5 puestos -->\n                <ol class=\"relative w-full grid grid-cols-5 gap-4 pt-8 before:content-[''] before:absolute before:top-0 before:left-[10%] before:right-[10%] before:h-px before:bg-[#d4af37]/40\" data-kid=\"1-2-2-3-5\">\n                    <!-- Puesto 1 Activo -->\n                    <li class=\"relative flex flex-col rounded-xl border border-[#10b981]/40 bg-[#12192b]/75 p-4 before:content-[''] before:absolute before:-top-8 before:left-1/2 before:w-px before:h-8 before:bg-[#d4af37]/40\" data-kid=\"1-2-2-3-5-1\">\n                        <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-1-1\">\n                            Puesto 1 de 5\n                        </p>\n                        <p class=\"mt-2 text-[15px] font-semibold leading-tight break-all\" data-kid=\"1-2-2-3-5-1-2\">\n                            jhon_pardo\n                        </p>\n                        <p class=\"mt-1 inline-flex items-center gap-1.5 text-[13px] text-[#10b981]\" data-kid=\"1-2-2-3-5-1-3\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-3-5-1-3-1\">\n                            </span>\n                            Activo\n                        </p>\n                        <p class=\"text-[12.5px] text-[#94a3b8] mt-0.5\" data-kid=\"1-2-2-3-5-1-4\">\n                            Recarga verificada · 10 sep\n                        </p>\n                        <button class=\"mt-4 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-[#d4af37]/50 text-[#d4af37] text-[13px] font-semibold hover:bg-[#d4af37]/10\" data-kid=\"1-2-2-3-5-1-5\" type=\"button\">\n                            <i class=\"ti ti-arrow-down-left text-[15px]\" data-kid=\"1-2-2-3-5-1-5-1\">\n                            </i>\n                            Solicitar dinero\n                        </button>\n                    </li>\n                    <!-- Puesto 2 Activo -->\n                    <li class=\"relative flex flex-col rounded-xl border border-[#10b981]/40 bg-[#12192b]/75 p-4 before:content-[''] before:absolute before:-top-8 before:left-1/2 before:w-px before:h-8 before:bg-[#d4af37]/40\" data-kid=\"1-2-2-3-5-2\">\n                        <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-2-1\">\n                            Puesto 2 de 5\n                        </p>\n                        <p class=\"mt-2 text-[15px] font-semibold leading-tight break-all\" data-kid=\"1-2-2-3-5-2-2\">\n                            luisa_gomez\n                        </p>\n                        <p class=\"mt-1 inline-flex items-center gap-1.5 text-[13px] text-[#10b981]\" data-kid=\"1-2-2-3-5-2-3\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-3-5-2-3-1\">\n                            </span>\n                            Activo\n                        </p>\n                        <p class=\"text-[12.5px] text-[#94a3b8] mt-0.5\" data-kid=\"1-2-2-3-5-2-4\">\n                            Recarga verificada · 22 sep\n                        </p>\n                        <button class=\"mt-4 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-[#d4af37]/50 text-[#d4af37] text-[13px] font-semibold hover:bg-[#d4af37]/10\" data-kid=\"1-2-2-3-5-2-5\" type=\"button\">\n                            <i class=\"ti ti-arrow-down-left text-[15px]\" data-kid=\"1-2-2-3-5-2-5-1\">\n                            </i>\n                            Solicitar dinero\n                        </button>\n                    </li>\n                    <!-- Puesto 3 Pendiente -->\n                    <li class=\"relative flex flex-col rounded-xl border border-[#eab308]/40 bg-[#12192b]/75 p-4 before:content-[''] before:absolute before:-top-8 before:left-1/2 before:w-px before:h-8 before:bg-[#d4af37]/40\" data-kid=\"1-2-2-3-5-3\">\n                        <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-3-1\">\n                            Puesto 3 de 5\n                        </p>\n                        <p class=\"mt-2 text-[15px] font-semibold leading-tight break-all\" data-kid=\"1-2-2-3-5-3-2\">\n                            miguel_salas\n                        </p>\n                        <p class=\"mt-1 inline-flex items-center gap-1.5 text-[13px] text-[#eab308]\" data-kid=\"1-2-2-3-5-3-3\">\n                            <span class=\"w-2 h-2 rounded-full bg-[#eab308]\" data-kid=\"1-2-2-3-5-3-3-1\">\n                            </span>\n                            Pendiente\n                        </p>\n                        <p class=\"text-[12.5px] text-[#94a3b8] mt-0.5\" data-kid=\"1-2-2-3-5-3-4\">\n                            Comprobante en revisión · 1 oct\n                        </p>\n                        <button class=\"mt-4 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-[#d4af37]/50 text-[#d4af37] text-[13px] font-semibold hover:bg-[#d4af37]/10\" data-kid=\"1-2-2-3-5-3-5\" type=\"button\">\n                            <i class=\"ti ti-arrow-down-left text-[15px]\" data-kid=\"1-2-2-3-5-3-5-1\">\n                            </i>\n                            Solicitar dinero\n                        </button>\n                    </li>\n                    <!-- Puesto 4 Libre -->\n                    <li class=\"relative flex flex-col rounded-xl border border-dashed border-[#64748b]/60 p-4 before:content-[''] before:absolute before:-top-8 before:left-1/2 before:w-px before:h-8 before:bg-[#d4af37]/40\" data-kid=\"1-2-2-3-5-4\">\n                        <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-4-1\">\n                            Puesto 4 de 5\n                        </p>\n                        <p class=\"mt-2 text-[15px] font-semibold leading-tight text-[#94a3b8]\" data-kid=\"1-2-2-3-5-4-2\">\n                            Libre\n                        </p>\n                        <p class=\"mt-1 inline-flex items-center gap-1.5 text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-4-3\">\n                            <span class=\"w-2 h-2 rounded-full border border-[#64748b]\" data-kid=\"1-2-2-3-5-4-3-1\">\n                            </span>\n                            Sin usuario\n                        </p>\n                        <p class=\"text-[12.5px] text-[#94a3b8] mt-0.5\" data-kid=\"1-2-2-3-5-4-4\">\n                            Comparte tu código para ocuparlo\n                        </p>\n                        <button aria-describedby=\"libre-4\" class=\"mt-4 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-[#64748b]/40 text-[#64748b] text-[13px] font-semibold cursor-not-allowed\" data-kid=\"1-2-2-3-5-4-5\" disabled=\"\" type=\"button\">\n                            <i class=\"ti ti-arrow-down-left text-[15px]\" data-kid=\"1-2-2-3-5-4-5-1\">\n                            </i>\n                            Solicitar dinero\n                        </button>\n                        <span class=\"sr-only\" data-kid=\"1-2-2-3-5-4-6\" id=\"libre-4\">\n                            No hay usuario en este puesto a quien solicitar dinero.\n                        </span>\n                    </li>\n                    <!-- Puesto 5 Libre -->\n                    <li class=\"relative flex flex-col rounded-xl border border-dashed border-[#64748b]/60 p-4 before:content-[''] before:absolute before:-top-8 before:left-1/2 before:w-px before:h-8 before:bg-[#d4af37]/40\" data-kid=\"1-2-2-3-5-5\">\n                        <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-5-1\">\n                            Puesto 5 de 5\n                        </p>\n                        <p class=\"mt-2 text-[15px] font-semibold leading-tight text-[#94a3b8]\" data-kid=\"1-2-2-3-5-5-2\">\n                            Libre\n                        </p>\n                        <p class=\"mt-1 inline-flex items-center gap-1.5 text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-3-5-5-3\">\n                            <span class=\"w-2 h-2 rounded-full border border-[#64748b]\" data-kid=\"1-2-2-3-5-5-3-1\">\n                            </span>\n                            Sin usuario\n                        </p>\n                        <p class=\"text-[12.5px] text-[#94a3b8] mt-0.5\" data-kid=\"1-2-2-3-5-5-4\">\n                            Comparte tu código para ocuparlo\n                        </p>\n                        <button class=\"mt-4 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-[#64748b]/40 text-[#64748b] text-[13px] font-semibold cursor-not-allowed\" data-kid=\"1-2-2-3-5-5-5\" disabled=\"\" type=\"button\">\n                            <i class=\"ti ti-arrow-down-left text-[15px]\" data-kid=\"1-2-2-3-5-5-5-1\">\n                            </i>\n                            Solicitar dinero\n                        </button>\n                    </li>\n                </ol>\n            </section>\n            <!-- Resto de la rama -->\n            <section aria-labelledby=\"rama-title\" class=\"pt-2\" data-kid=\"1-2-2-4\">\n                <div class=\"flex items-baseline justify-between gap-4 mb-3\" data-kid=\"1-2-2-4-1\">\n                    <h2 class=\"font-cinzel text-[18px] font-bold\" data-kid=\"1-2-2-4-1-1\" id=\"rama-title\">\n                        Resto de tu rama\n                    </h2>\n                    <p class=\"text-[13.5px] text-[#94a3b8]\" data-kid=\"1-2-2-4-1-2\">\n                        4 personas traídas por tus directos · no cuentan para tu matriz, sí para tu rama\n                    </p>\n                </div>\n                <table class=\"w-full text-[13.5px]\" data-kid=\"1-2-2-4-2\">\n                    <thead data-kid=\"1-2-2-4-2-1\">\n                        <tr class=\"text-left text-[12.5px] text-[#94a3b8] border-b border-[#d4af37]/20\" data-kid=\"1-2-2-4-2-1-1\">\n                            <th class=\"py-2 font-semibold\" data-kid=\"1-2-2-4-2-1-1-1\">\n                                Usuario\n                            </th>\n                            <th class=\"py-2 font-semibold\" data-kid=\"1-2-2-4-2-1-1-2\">\n                                Lo trajo\n                            </th>\n                            <th class=\"py-2 font-semibold\" data-kid=\"1-2-2-4-2-1-1-3\">\n                                Nivel\n                            </th>\n                            <th class=\"py-2 font-semibold\" data-kid=\"1-2-2-4-2-1-1-4\">\n                                Estado\n                            </th>\n                            <th class=\"py-2 font-semibold text-right\" data-kid=\"1-2-2-4-2-1-1-5\">\n                                Registro\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-white/6\" data-kid=\"1-2-2-4-2-2\">\n                        <tr data-kid=\"1-2-2-4-2-2-1\">\n                            <td class=\"py-2.5 font-medium\" data-kid=\"1-2-2-4-2-2-1-1\">\n                                sandra_leon\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-1-2\">\n                                jhon_pardo\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-1-3\">\n                                1 · Bronce\n                            </td>\n                            <td class=\"py-2.5\" data-kid=\"1-2-2-4-2-2-1-4\">\n                                <span class=\"inline-flex items-center gap-1.5 text-[#10b981]\" data-kid=\"1-2-2-4-2-2-1-4-1\">\n                                    <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-4-2-2-1-4-1-1\">\n                                    </span>\n                                    Activo\n                                </span>\n                            </td>\n                            <td class=\"py-2.5 text-right text-[#94a3b8]\" data-kid=\"1-2-2-4-2-2-1-5\">\n                                18 sep 2026\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-2-2-4-2-2-2\">\n                            <td class=\"py-2.5 font-medium\" data-kid=\"1-2-2-4-2-2-2-1\">\n                                camilo_vega\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-2-2\">\n                                jhon_pardo\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-2-3\">\n                                1 · Bronce\n                            </td>\n                            <td class=\"py-2.5\" data-kid=\"1-2-2-4-2-2-2-4\">\n                                <span class=\"inline-flex items-center gap-1.5 text-[#eab308]\" data-kid=\"1-2-2-4-2-2-2-4-1\">\n                                    <span class=\"w-2 h-2 rounded-full bg-[#eab308]\" data-kid=\"1-2-2-4-2-2-2-4-1-1\">\n                                    </span>\n                                    Pendiente\n                                </span>\n                            </td>\n                            <td class=\"py-2.5 text-right text-[#94a3b8]\" data-kid=\"1-2-2-4-2-2-2-5\">\n                                29 sep 2026\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-2-2-4-2-2-3\">\n                            <td class=\"py-2.5 font-medium\" data-kid=\"1-2-2-4-2-2-3-1\">\n                                paola_rico\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-3-2\">\n                                luisa_gomez\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-3-3\">\n                                1 · Bronce\n                            </td>\n                            <td class=\"py-2.5\" data-kid=\"1-2-2-4-2-2-3-4\">\n                                <span class=\"inline-flex items-center gap-1.5 text-[#10b981]\" data-kid=\"1-2-2-4-2-2-3-4-1\">\n                                    <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-4-2-2-3-4-1-1\">\n                                    </span>\n                                    Activo\n                                </span>\n                            </td>\n                            <td class=\"py-2.5 text-right text-[#94a3b8]\" data-kid=\"1-2-2-4-2-2-3-5\">\n                                30 sep 2026\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-2-2-4-2-2-4\">\n                            <td class=\"py-2.5 font-medium\" data-kid=\"1-2-2-4-2-2-4-1\">\n                                diego_arias\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-4-2\">\n                                luisa_gomez\n                            </td>\n                            <td class=\"py-2.5 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-2-4-3\">\n                                1 · Bronce\n                            </td>\n                            <td class=\"py-2.5\" data-kid=\"1-2-2-4-2-2-4-4\">\n                                <span class=\"inline-flex items-center gap-1.5 text-[#10b981]\" data-kid=\"1-2-2-4-2-2-4-4-1\">\n                                    <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-4-2-2-4-4-1-1\">\n                                    </span>\n                                    Activo\n                                </span>\n                            </td>\n                            <td class=\"py-2.5 text-right text-[#94a3b8]\" data-kid=\"1-2-2-4-2-2-4-5\">\n                                5 oct 2026\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </section>\n        </main>\n    </div>\n</div>\n",
