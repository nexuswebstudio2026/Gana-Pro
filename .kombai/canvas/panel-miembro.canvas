 value\">\n                                4.676512\n                            </dd>\n                        </div>\n                        <div data-kid=\"1-2-2-4-1-3-2\" data-name=\"longitude field container\">\n                            <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-4-1-3-2-1\" data-name=\"longitude label\">\n                                Longitud\n                            </dt>\n                            <dd class=\"font-mono text-white mt-0.5\" data-kid=\"1-2-2-4-1-3-2-2\" data-name=\"longitude mono value\">\n                                -74.048301\n                            </dd>\n                        </div>\n                        <div data-kid=\"1-2-2-4-1-3-3\" data-name=\"accuracy field container\">\n                            <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-4-1-3-3-1\" data-name=\"accuracy label\">\n                                Exactitud\n                            </dt>\n                            <dd class=\"font-mono text-white mt-0.5\" data-kid=\"1-2-2-4-1-3-3-2\" data-name=\"accuracy mono value\">\n                                ± 18 m\n                            </dd>\n                        </div>\n                        <div data-kid=\"1-2-2-4-1-3-4\" data-name=\"updated field container\">\n                            <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-4-1-3-4-1\" data-name=\"updated label\">\n                                Actualizado\n                            </dt>\n                            <dd class=\"text-white mt-0.5\" data-kid=\"1-2-2-4-1-3-4-2\" data-name=\"updated value text\">\n                                Hoy, 08:14\n                            </dd>\n                        </div>\n                    </dl>\n                    <div class=\"mt-5 flex items-center gap-3\" data-kid=\"1-2-2-4-1-4\" data-name=\"location action row\">\n                        <button class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#d4af37]/50 text-[#d4af37] text-[13.5px] font-semibold hover:bg-[#d4af37]/10\" data-kid=\"1-2-2-4-1-4-1\" data-name=\"update location button\" type=\"button\">\n                            <i class=\"ti ti-current-location text-[16px]\" data-kid=\"1-2-2-4-1-4-1-1\" data-name=\"current location icon\">\n                            </i>\n                            Actualizar mi ubicación\n                        </button>\n                        <a class=\"inline-flex items-center gap-1.5 text-[13.5px] underline text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-2-2-4-1-4-2\" data-name=\"google maps link\" href=\"#\">\n                            <i class=\"ti ti-map-pin text-[15px]\" data-kid=\"1-2-2-4-1-4-2-1\" data-name=\"map pin icon\">\n                            </i>\n                            Ver en Google Maps\n                        </a>\n                    </div>\n                </div>\n                <div class=\"rounded-xl overflow-hidden border border-[#d4af37]/25 relative min-h-[170px]\" data-kid=\"1-2-2-4-2\" data-name=\"map image card\">\n                    <img alt=\"Mapa de la zona registrada (foto de Unsplash, Timo Wielink)\" class=\"absolute inset-0 w-full h-full object-cover opacity-50 grayscale\" data-kid=\"1-2-2-4-2-1\" data-name=\"background map photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&w=600&q=70&fit=crop\"/>\n                    <span class=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#d4af37] ring-4 ring-[#d4af37]/30\" data-kid=\"1-2-2-4-2-2\" data-name=\"gold location marker dot\">\n                    </span>\n                    <p class=\"absolute bottom-2 left-3 text-[12.5px] text-white/90\" data-kid=\"1-2-2-4-2-3\" data-name=\"map location caption\">\n                        Chicó, Bogotá\n                    </p>\n                </div>\n            </section>\n            <!-- Documento -->\n            <section aria-labelledby=\"doc-title\" class=\"border-t border-[#d4af37]/20 pt-8 pb-4\" data-kid=\"1-2-2-5\" data-name=\"identity document section\" id=\"documento\">\n                <div class=\"flex items-center gap-3 mb-2\" data-kid=\"1-2-2-5-1\" data-name=\"document heading row\">\n                    <h2 class=\"font-cinzel text-[18px] font-bold\" data-kid=\"1-2-2-5-1-1\" data-name=\"document heading title\" id=\"doc-title\">\n                        Documento de identidad\n                    </h2>\n                    <span class=\"inline-flex items-center gap-1.5 text-[13px] text-[#eab308]\" data-kid=\"1-2-2-5-1-2\" data-name=\"pending review status badge\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#eab308]\" data-kid=\"1-2-2-5-1-2-1\" data-name=\"amber status dot\">\n                        </span>\n                        Pendiente de revisión\n                    </span>\n                </div>\n                <p class=\"text-[13.5px] text-[#94a3b8] mb-5\" data-kid=\"1-2-2-5-2\" data-name=\"document review description\">\n                    Un administrador revisa el archivo. Si reemplazas un documento ya aprobado, vuelve a quedar pendiente de revisión.\n                </p>\n                <div class=\"grid grid-cols-[1fr_1fr] gap-8\" data-kid=\"1-2-2-5-3\" data-name=\"document grid container\">\n                    <div data-kid=\"1-2-2-5-3-1\" data-name=\"document declared info column\">\n                        <dl class=\"divide-y divide-white/6 text-[14px]\" data-kid=\"1-2-2-5-3-1-1\" data-name=\"document details list\">\n                            <div class=\"flex justify-between py-2.5\" data-kid=\"1-2-2-5-3-1-1-1\" data-name=\"document type row\">\n                                <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-5-3-1-1-1-1\" data-name=\"document type label\">\n                                    Documento declarado\n                                </dt>\n                                <dd class=\"font-semibold\" data-kid=\"1-2-2-5-3-1-1-1-2\" data-name=\"document type value\">\n                                    CC · Cédula de Ciudadanía\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between py-2.5\" data-kid=\"1-2-2-5-3-1-1-2\" data-name=\"document number row\">\n                                <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-5-3-1-1-2-1\" data-name=\"document number label\">\n                                    Número\n                                </dt>\n                                <dd class=\"font-mono font-semibold\" data-kid=\"1-2-2-5-3-1-1-2-2\" data-name=\"document number mono value\">\n                                    1020304050\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between py-2.5 items-center\" data-kid=\"1-2-2-5-3-1-1-3\" data-name=\"current file row\">\n                                <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-5-3-1-1-3-1\" data-name=\"current file label\">\n                                    Archivo actual\n                                </dt>\n                                <dd class=\"flex items-center gap-3\" data-kid=\"1-2-2-5-3-1-1-3-2\" data-name=\"current file value container\">\n                                    <span class=\"font-mono text-[13px]\" data-kid=\"1-2-2-5-3-1-1-3-2-1\" data-name=\"file name mono text\">\n                                        cedula_andres_mora.pdf\n                                    </span>\n                                    <a class=\"underline text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-2-2-5-3-1-1-3-2-2\" data-name=\"view PDF link\" href=\"#\">\n                                        Ver PDF\n                                    </a>\n                                </dd>\n                            </div>\n                            <div class=\"flex justify-between py-2.5\" data-kid=\"1-2-2-5-3-1-1-4\" data-name=\"submitted date row\">\n                                <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-5-3-1-1-4-1\" data-name=\"submitted date label\">\n                                    Enviado\n                                </dt>\n                                <dd class=\"font-semibold\" data-kid=\"1-2-2-5-3-1-1-4-2\" data-name=\"submitted date value\">\n                                    2 oct 2026\n                                </dd>\n                            </div>\n                        </dl>\n                    </div>\n                    <form class=\"flex flex-col gap-4\" data-kid=\"1-2-2-5-3-2\" data-name=\"document upload form\">\n                        <div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-2-2-5-3-2-1\" data-name=\"document type fields row\">\n                            <label class=\"flex flex-col gap-1.5 text-[13.5px]\" data-kid=\"1-2-2-5-3-2-1-1\" data-name=\"document type select group\">\n                                <span class=\"font-semibold text-[#cbd5e1]\" data-kid=\"1-2-2-5-3-2-1-1-1\" data-name=\"document type select label\">\n                                    Tipo de documento\n                                </span>\n                                <select class=\"px-3.5 py-2.5 rounded-lg border border-[#d4af37]/30 bg-[#0a0e17]/60 text-white text-[14px] focus:border-[#d4af37] focus:outline-none\" data-kid=\"1-2-2-5-3-2-1-1-2\" data-name=\"document type select\">\n                                    <option data-kid=\"1-2-2-5-3-2-1-1-2-1\" data-name=\"citizenship option\" selected=\"\">\n                                        CC — Cédula de Ciudadanía\n                                    </option>\n                                    <option data-kid=\"1-2-2-5-3-2-1-1-2-2\" data-name=\"identity card option\">\n                                        TI — Tarjeta de Identidad\n                                    </option>\n                                    <option data-kid=\"1-2-2-5-3-2-1-1-2-3\" data-name=\"foreigner card option\">\n                                        CE — Cédula de Extranjería\n                                    </option>\n                                    <option data-kid=\"1-2-2-5-3-2-1-1-2-4\" data-name=\"protection permit option\">\n                                        PEP — Permiso por Protección\n                                    </option>\n                                </select>\n                            </label>\n                            <label class=\"flex flex-col gap-1.5 text-[13.5px]\" data-kid=\"1-2-2-5-3-2-1-2\" data-name=\"document number input group\">\n                                <span class=\"font-semibold text-[#cbd5e1]\" data-kid=\"1-2-2-5-3-2-1-2-1\" data-name=\"document number input label\">\n                                    Número de documento\n                                </span>\n                                <input class=\"px-3.5 py-2.5 rounded-lg border border-[#d4af37]/30 bg-[#0a0e17]/60 text-white text-[14px] font-mono focus:border-[#d4af37] focus:outline-none\" data-kid=\"1-2-2-5-3-2-1-2-2\" data-name=\"document number text input\" type=\"text\" value=\"1020304050\"/>\n                            </label>\n                        </div>\n                        <label class=\"flex flex-col gap-1.5 text-[13.5px]\" data-kid=\"1-2-2-5-3-2-2\" data-name=\"document file upload group\">\n                            <span class=\"font-semibold text-[#cbd5e1]\" data-kid=\"1-2-2-5-3-2-2-1\" data-name=\"upload file field label\">\n                                Archivo del documento\n                            </span>\n                            <span class=\"flex items-center gap-3 px-4 py-3.5 rounded-lg border border-dashed border-[#d4af37]/40 text-[#94a3b8] cursor-pointer hover:border-[#d4af37]\" data-kid=\"1-2-2-5-3-2-2-2\" data-name=\"file drop zone trigger\">\n                                <i class=\"ti ti-file-upload text-[22px] text-[#d4af37]\" data-kid=\"1-2-2-5-3-2-2-2-1\" data-name=\"file upload icon\">\n                                </i>\n                                <span data-kid=\"1-2-2-5-3-2-2-2-2\" data-name=\"drop zone instruction text\">\n                                    Arrastra o\n                                    <span class=\"underline text-[#cbd5e1]\" data-kid=\"1-2-2-5-3-2-2-2-2-1\" data-name=\"choose file link text\">\n                                        elige un archivo\n                                    </span>\n                                    <br data-kid=\"1-2-2-5-3-2-2-2-2-2\" data-name=\"drop zone line break\"/>\n                                    <span class=\"text-[12.5px]\" data-kid=\"1-2-2-5-3-2-2-2-2-3\" data-name=\"drop zone file format hint\">\n                                        Imagen o PDF · máximo 5 MB\n                                    </span>\n                                </span>\n                            </span>\n                        </label>\n                        <div class=\"flex justify-end\" data-kid=\"1-2-2-5-3-2-3\" data-name=\"upload action row\">\n                            <button class=\"px-5 py-2.5 rounded-lg bg-[#d4af37] text-[#0a0e17] text-[13.5px] font-bold hover:bg-[#e0bd4e]\" data-kid=\"1-2-2-5-3-2-3-1\" data-name=\"upload document button\" type=\"submit\">\n                                Subir documento\n                            </button>\n                        </div>\n                    </form>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n",
