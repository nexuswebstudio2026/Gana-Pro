      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Montserrat:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.font-cinzel{font-family:'Cinzel',serif}\n.font-mont{font-family:'Montserrat',sans-serif}\n</style>\n<div class=\"font-mont bg-[#0a0e17] text-[#f8fafc] min-h-[1040px] grid grid-cols-[260px_minmax(0,1fr)]\" data-kid=\"1\" data-name=\"member dashboard layout container\">\n    <aside class=\"bg-[#0d1322] border-r border-[#d4af37]/30 flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex items-center gap-3 px-5 h-16 border-b border-[#d4af37]/20\" data-kid=\"1-1-1\" data-name=\"sidebar brand header\">\n            <span class=\"w-9 h-9 rounded-lg bg-[#d4af37] text-[#0a0e17] font-cinzel font-bold grid place-items-center text-[13px]\" data-kid=\"1-1-1-1\" data-name=\"brand monogram logo\">\n                GP\n            </span>\n            <span class=\"font-cinzel font-bold text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                GANA\n                <span class=\"text-[#d4af37]\" data-kid=\"1-1-1-2-1\" data-name=\"product edition label PRO\">\n                    PRO\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Secciones del panel\" class=\"flex flex-col gap-1 p-3 pt-4\" data-kid=\"1-1-2\" data-name=\"main sidebar navigation\">\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-1\" data-name=\"home navigation link\" href=\"#\">\n                <i class=\"ti ti-home text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"home house icon\">\n                </i>\n                Inicio\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-2\" data-name=\"org chart navigation link\" href=\"#\">\n                <i class=\"ti ti-sitemap text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"sitemap icon\">\n                </i>\n                Mi organigrama 5x1\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-3\" data-name=\"wallet navigation link\" href=\"#\">\n                <i class=\"ti ti-wallet text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"wallet icon\">\n                </i>\n                Mi billetera\n            </a>\n            <a aria-current=\"page\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-semibold text-[#d4af37] bg-[#d4af37]/12\" data-kid=\"1-1-2-4\" data-name=\"active profile navigation link\" href=\"#\">\n                <i class=\"ti ti-user-circle text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"user profile icon\">\n                </i>\n                Mi perfil\n            </a>\n            <div class=\"ml-9 mt-1 flex flex-col gap-0.5 border-l border-[#d4af37]/25 pl-3 text-[13px]\" data-kid=\"1-1-2-5\" data-name=\"profile sub-navigation list\">\n                <a class=\"py-1.5 text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-1-2-5-1\" data-name=\"account data sub-link\" href=\"#cuenta\">\n                    Datos y referido\n                </a>\n                <a class=\"py-1.5 text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-1-2-5-2\" data-name=\"contact payment sub-link\" href=\"#contacto\">\n                    Contacto y pago\n                </a>\n                <a class=\"py-1.5 text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-1-2-5-3\" data-name=\"location sub-link\" href=\"#ubicacion\">\n                    Mi ubicación\n                </a>\n                <a class=\"py-1.5 text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-1-2-5-4\" data-name=\"identity document sub-link\" href=\"#documento\">\n                    Documento de identidad\n                </a>\n            </div>\n        </nav>\n        <div class=\"mt-auto p-3 border-t border-[#d4af37]/20\" data-kid=\"1-1-3\" data-name=\"sidebar user footer\">\n            <div class=\"flex items-center gap-3 px-2 py-2\" data-kid=\"1-1-3-1\" data-name=\"user info row\">\n                <span class=\"w-9 h-9 rounded-full bg-[#d4af37]/18 text-[#d4af37] grid place-items-center font-bold text-[13px]\" data-kid=\"1-1-3-1-1\" data-name=\"user avatar initial\">\n                    A\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-1-3-1-2\" data-name=\"user text container\">\n                    <p class=\"text-[13.5px] font-semibold truncate\" data-kid=\"1-1-3-1-2-1\" data-name=\"user display name\">\n                        andres_mora\n                    </p>\n                    <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-1-3-1-2-2\" data-name=\"user level tier text\">\n                        Nivel 2 · Plata\n                    </p>\n                </div>\n            </div>\n            <a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-[13.5px] text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-3-2\" data-name=\"log out button\" href=\"#\">\n                <i class=\"ti ti-logout text-[17px]\" data-kid=\"1-1-3-2-1\" data-name=\"logout arrow icon\">\n                </i>\n                Cerrar sesión\n            </a>\n        </div>\n    </aside>\n    <div class=\"min-w-0\" data-kid=\"1-2\" data-name=\"main content wrapper\">\n        <header class=\"h-16 flex items-center justify-between px-9 border-b border-[#d4af37]/20\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n            <p class=\"text-[13.5px] text-[#94a3b8]\" data-kid=\"1-2-1-1\" data-name=\"page context label\">\n                Panel de miembro\n            </p>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-2-1-2\" data-name=\"header right actions group\">\n                <div class=\"text-right\" data-kid=\"1-2-1-2-1\" data-name=\"available balance block\">\n                    <p class=\"text-[12px] text-[#94a3b8]\" data-kid=\"1-2-1-2-1-1\" data-name=\"balance caption label\">\n                        Saldo disponible\n                    </p>\n                    <p class=\"text-[15px] font-bold text-[#d4af37] leading-tight\" data-kid=\"1-2-1-2-1-2\" data-name=\"balance amount text\">\n                        $185.000\n                    </p>\n                </div>\n                <span class=\"h-8 w-px bg-[#d4af37]/25\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider\">\n                </span>\n                <button aria-label=\"Cambiar tema\" class=\"w-9 h-9 rounded-lg border border-[#d4af37]/30 text-[#94a3b8] grid place-items-center hover:text-[#d4af37]\" data-kid=\"1-2-1-2-3\" data-name=\"theme toggle button\" type=\"button\">\n                    <i class=\"ti ti-sun text-[17px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"sun theme icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <main class=\"px-9 py-8 max-w-[1080px] mx-auto flex flex-col gap-10\" data-kid=\"1-2-2\" data-name=\"main profile content area\">\n            <div data-kid=\"1-2-2-1\" data-name=\"page heading block\">\n                <h1 class=\"font-cinzel text-[28px] font-bold leading-tight\" data-kid=\"1-2-2-1-1\" data-name=\"page main title\">\n                    Mi perfil\n                </h1>\n                <p class=\"mt-1.5 text-[14.5px] text-[#94a3b8]\" data-kid=\"1-2-2-1-2\" data-name=\"page description text\">\n                    Datos de la cuenta, contacto y pago, ubicación registrada y documento de identidad en un solo lugar.\n                </p>\n            </div>\n            <!-- Cuenta + referido -->\n            <section aria-label=\"Datos de la cuenta y código de referido\" class=\"grid grid-cols-[1fr_380px] gap-8\" data-kid=\"1-2-2-2\" data-name=\"account and referral section\" id=\"cuenta\">\n                <div data-kid=\"1-2-2-2-1\" data-name=\"account details column\">\n                    <h2 class=\"font-cinzel text-[18px] font-bold mb-3\" data-kid=\"1-2-2-2-1-1\" data-name=\"account details heading\">\n                        Datos de la cuenta\n                    </h2>\n                    <dl class=\"divide-y divide-white/6 text-[14px]\" data-kid=\"1-2-2-2-1-2\" data-name=\"account details list\">\n                        <div class=\"flex justify-between py-2.5\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"username row\">\n                            <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"username label\">\n                                Usuario\n                            </dt>\n                            <dd class=\"font-semibold\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"username value\">\n                                andres_mora\n                            </dd>\n                        </div>\n                        <div class=\"flex justify-between py-2.5\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"email row\">\n                            <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"email label\">\n                                Correo electrónico\n                            </dt>\n                            <dd class=\"font-semibold\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"email value\">\n                                andres.mora@gmail.com\n                            </dd>\n                        </div>\n                        <div class=\"flex justify-between py-2.5\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"role row\">\n                            <dt class=\"text-[#94a3b8]\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"role label\">\n                                Rol del sistema\n                            </dt>\n                            <dd data-ki