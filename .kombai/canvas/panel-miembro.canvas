] whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-2-7-1\" data-name=\"cell date 10 sep 2026\">\n                                    10 sep 2026\n                                </td>\n                                <td class=\"px-4 py-3 font-medium\" data-kid=\"1-2-2-4-2-1-2-7-2\" data-name=\"cell concept Recarga Inicial\">\n                                    Recarga Inicial\n                                </td>\n                                <td class=\"px-4 py-3 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-1-2-7-3\" data-name=\"cell from source jhon_pardo\">\n                                    De\n                                    <span class=\"text-white\" data-kid=\"1-2-2-4-2-1-2-7-3-1\" data-name=\"from source name\">\n                                        jhon_pardo\n                                    </span>\n                                    · puesto 1\n                                </td>\n                                <td class=\"px-4 py-3\" data-kid=\"1-2-2-4-2-1-2-7-4\" data-name=\"cell type received\">\n                                    <span class=\"inline-flex items-center gap-1 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-1-2-7-4-1\" data-name=\"type badge Recibido\">\n                                        <i class=\"ti ti-arrow-down-left text-[15px] text-[#10b981]\" data-kid=\"1-2-2-4-2-1-2-7-4-1-1\" data-name=\"incoming arrow icon\">\n                                        </i>\n                                        Recibido\n                                    </span>\n                                </td>\n                                <td class=\"px-4 py-3 text-right font-semibold text-[#10b981] whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-2-7-5\" data-name=\"cell amount +50.000\">\n                                    + $50.000\n                                </td>\n                                <td class=\"px-4 py-3\" data-kid=\"1-2-2-4-2-1-2-7-6\" data-name=\"cell status approved\">\n                                    <span class=\"inline-flex items-center gap-1.5 text-[#10b981]\" data-kid=\"1-2-2-4-2-1-2-7-6-1\" data-name=\"status badge Aprobado\">\n                                        <span class=\"w-2 h-2 rounded-full bg-[#10b981]\" data-kid=\"1-2-2-4-2-1-2-7-6-1-1\" data-name=\"status dot green\">\n                                        </span>\n                                        Aprobado\n                                    </span>\n                                </td>\n                                <td class=\"px-4 py-3 text-right\" data-kid=\"1-2-2-4-2-1-2-7-7\" data-name=\"cell evidence link Ver imagen\">\n                                    <a class=\"underline text-[#cbd5e1] hover:text-[#d4af37]\" data-kid=\"1-2-2-4-2-1-2-7-7-1\" data-name=\"link Ver imagen\" href=\"#\">\n                                        Ver imagen\n                                    </a>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-4-2-1-2-8\" data-name=\"table data row 8\">\n                                <td class=\"px-4 py-3 text-[#cbd5e1] whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-2-8-1\" data-name=\"cell date 02 sep 2026\">\n                                    02 sep 2026\n                                </td>\n                                <td class=\"px-4 py-3 font-medium\" data-kid=\"1-2-2-4-2-1-2-8-2\" data-name=\"cell concept Ascenso a Patrocinador\">\n                                    Ascenso a Patrocinador\n                                </td>\n                                <td class=\"px-4 py-3 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-1-2-8-3\" data-name=\"cell to destination carolina_ruiz\">\n                                    Para\n                                    <span class=\"text-white\" data-kid=\"1-2-2-4-2-1-2-8-3-1\" data-name=\"to destination name\">\n                                        carolina_ruiz\n                                    </span>\n                                    · tu líder\n                                </td>\n                                <td class=\"px-4 py-3\" data-kid=\"1-2-2-4-2-1-2-8-4\" data-name=\"cell type sent\">\n                                    <span class=\"inline-flex items-center gap-1 text-[#cbd5e1]\" data-kid=\"1-2-2-4-2-1-2-8-4-1\" data-name=\"type badge Enviado\">\n                                        <i class=\"ti ti-arrow-up-right text-[15px] text-[#d4af37]\" data-kid=\"1-2-2-4-2-1-2-8-4-1-1\" data-name=\"outgoing arrow icon\">\n                                        </i>\n                                        Enviado\n                                    </span>\n                                </td>\n                                <td class=\"px-4 py-3 text-right font-semibold whitespace-nowrap\" data-kid=\"1-2-2-4-2-1-2-8-5\" data-name=\"cell amount -30.000\">\n                                    − $30.000\n                                </td>\n                                <td class=\"px-4 py-3\" data-kid=\"1-2-2-4-2-1-2-8-6\" data-name=\"cell status rejected (red)\">\n                                    <span class=\"inline-flex items-center gap-1.5 text-[#f87171]\" data-kid=\"1-2-2-4-2-1-2-8-6-1\" data-name=\"status badge Rechazado\">\n                                        <span class=\"w-2 h-2 rounded-full bg-[#f87171]\" data-kid=\"1-2-2-4-2-1-2-8-6-1-1\" data-name=\"status dot red\">\n                                        </span>\n                                        Rechazado\n                                    </span>\n                                    <span class=\"block text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-4-2-1-2-8-6-2\" data-name=\"status reason block\">\n                                        Comprobante ilegible · vuelve a subirlo\n                                    </span>\n                                </td>\n                                <td class=\"px-4 py-3 text-right\" data-kid=\"1-2-2-4-2-1-2-8-7\" data-name=\"cell evidence link Subir de nuevo\">\n                                    <a class=\"underline text-[#d4af37]\" data-kid=\"1-2-2-4-2-1-2-8-7-1\" data-name=\"link Subir de nuevo\" href=\"#\">\n                                        Subir de nuevo\n                                    </a>\n                                </td>\n                            </tr>\n                        </tbody>\n                        <tfoot class=\"bg-[#12192b] border-t border-[#d4af37]/30\" data-kid=\"1-2-2-4-2-1-3\" data-name=\"table footer tfoot\">\n                            <tr class=\"text-[13.5px]\" data-kid=\"1-2-2-4-2-1-3-1\" data-name=\"footer row summary\">\n                                <td class=\"px-4 py-3 text-[#94a3b8]\" colspan=\"4\" data-kid=\"1-2-2-4-2-1-3-1-1\" data-name=\"footer description cell\">\n                                    Totales de movimientos\n                                    <strong class=\"text-white\" data-kid=\"1-2-2-4-2-1-3-1-1-1\" data-name=\"footer description strong word false\">\n                                        aprobados\n                                    </strong>\n                                    · los pendientes y rechazados no suman\n                                </td>\n                                <td class=\"px-4 py-3\" colspan=\"3\" data-kid=\"1-2-2-4-2-1-3-1-2\" data-name=\"footer totals cell\">\n                                    <div class=\"flex items-center justify-end gap-8\" data-kid=\"1-2-2-4-2-1-3-1-2-1\" data-name=\"footer totals group (enviado/recibido/neto)\">\n                                        <span class=\"text-[#94a3b8]\" data-kid=\"1-2-2-4-2-1-3-1-2-1-1\" data-name='total amount label \"Enviado\"'>\n                                            Enviado\n                                            <strong class=\"ml-1 text-white\" data-kid=\"1-2-2-4-2-1-3-1-2-1-1-1\" data-name='subtotal value \"enviado\"'>\n                                                $100.000\n                                            </strong>\n                                        </span>\n                                        <span class=\"text-[#94a3b8]\" data-kid=\"1-2-2-4-2-1-3-1-2-1-2\" data-name='total amount label \"Recibido\"'>\n                                            Recibido\n                                            <strong class=\"ml-1 text-[#10b981]\" data-kid=\"1-2-2-4-2-1-3-1-2-1-2-1\" data-name='subtotal value \"recibido\"'>\n                                                $120.000\n                                            </strong>\n                                        </span>\n                                        <span class=\"text-[#94a3b8]\" data-kid=\"1-2-2-4-2-1-3-1-2-1-3\" data-name='total amount label \"Neto\"'>\n                                            Neto\n                                            <strong class=\"ml-1 text-[#d4af37] text-[16px]\" data-kid=\"1-2-2-4-2-1-3-1-2-1-3-1\" data-name='net value \"+ $20.000\"'>\n                                                + $20.000\n                                            </strong>\n                                        </span>\n                                    </div>\n                                </td>\n                            </tr>\n                        </tfoot>\n                    </table>\n                </div>\n                <p class=\"mt-3 text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-4-3\" data-name=\"review progress note text\">\n                    En revisión:\n                    <strong class=\"text-white\" data-kid=\"1-2-2-4-3-1\" data-name=\"strong pending review text\">\n                        2 movimientos por $70.000\n                    </strong>\n                    . Un movimiento aprobado por el administrador pasa al saldo disponible; uno rechazado no mueve saldo.\n                </p>\n            </section>\n        </main>\n    </div>\n</div>\n",
