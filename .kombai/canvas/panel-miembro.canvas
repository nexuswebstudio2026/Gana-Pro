    "var_7b9553f392ba": {
      "type": "variant",
      "label": "Mi billetera — saldo, movimientos y totales",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Montserrat:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.font-cinzel{font-family:'Cinzel',serif}\n.font-mont{font-family:'Montserrat',sans-serif}\n</style>\n<div class=\"font-mont bg-[#0a0e17] text-[#f8fafc] min-h-[1040px] grid grid-cols-[260px_minmax(0,1fr)]\" data-kid=\"1\" data-name=\"member dashboard page layout\">\n    <aside class=\"bg-[#0d1322] border-r border-[#d4af37]/30 flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex items-center gap-3 px-5 h-16 border-b border-[#d4af37]/20\" data-kid=\"1-1-1\" data-name=\"sidebar brand header\">\n            <span class=\"w-9 h-9 rounded-lg bg-[#d4af37] text-[#0a0e17] font-cinzel font-bold grid place-items-center text-[13px]\" data-kid=\"1-1-1-1\" data-name=\"brand logo monogram GP\">\n                GP\n            </span>\n            <span class=\"font-cinzel font-bold text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"brand name GANA PRO\">\n                GANA\n                <span class=\"text-[#d4af37]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name PRO accent\">\n                    PRO\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Secciones del panel\" class=\"flex flex-col gap-1 p-3 pt-4\" data-kid=\"1-1-2\" data-name=\"primary sidebar nav menu\">\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-1\" data-name=\"nav link Inicio with home icon\" href=\"#\">\n                <i class=\"ti ti-home text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"home icon\">\n                </i>\n                Inicio\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-2\" data-name=\"nav link Mi organigrama 5x1 with sitemap icon\" href=\"#\">\n                <i class=\"ti ti-sitemap text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"sitemap icon\">\n                </i>\n                Mi organigrama 5x1\n            </a>\n            <a aria-current=\"page\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-semibold text-[#d4af37] bg-[#d4af37]/12\" data-kid=\"1-1-2-3\" data-name=\"nav link Mi billetera (active) with wallet icon\" href=\"#\">\n                <i class=\"ti ti-wallet text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"wallet icon\">\n                </i>\n                Mi billetera\n            </a>\n            <a class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-[14px] font-medium text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-2-4\" data-name=\"nav link Mi perfil with user icon\" href=\"#\">\n                <i class=\"ti ti-user-circle text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"user circle icon\">\n                </i>\n                Mi perfil\n            </a>\n        </nav>\n        <div class=\"mt-auto p-3 border-t border-[#d4af37]/20\" data-kid=\"1-1-3\" data-name=\"sidebar footer user area\">\n            <div class=\"flex items-center gap-3 px-2 py-2\" data-kid=\"1-1-3-1\" data-name=\"user profile summary with avatar\">\n                <span class=\"w-9 h-9 rounded-full bg-[#d4af37]/18 text-[#d4af37] grid place-items-center font-bold text-[13px]\" data-kid=\"1-1-3-1-1\" data-name=\"user avatar initial A\">\n                    A\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-1-3-1-2\" data-name=\"user profile text block\">\n                    <p class=\"text-[13.5px] font-semibold truncate\" data-kid=\"1-1-3-1-2-1\" data-name=\"user display name\">\n                        andres_mora\n                    </p>\n                    <p class=\"text-[12.5px] text-[#94a3b8]\" data-kid=\"1-1-3-1-2-2\" data-name=\"user level badge text\">\n                        Nivel 2 · Plata\n                    </p>\n                </div>\n            </div>\n            <a class=\"flex items-center gap-3 px-3 py-2 rounded-lg text-[13.5px] text-[#94a3b8] hover:text-white hover:bg-white/5\" data-kid=\"1-1-3-2\" data-name=\"nav link Cerrar sesión with logout icon\" href=\"#\">\n                <i class=\"ti ti-logout text-[17px]\" data-kid=\"1-1-3-2-1\" data-name=\"logout icon\">\n                </i>\n                Cerrar sesión\n            </a>\n        </div>\n    </aside>\n    <div class=\"min-w-0\" data-kid=\"1-2\" data-name=\"main content column\">\n        <header class=\"h-16 flex items-center justify-between px-9 border-b border-[#d4af37]/20\" data-kid=\"1-2-1\" data-name=\"page top header bar\">\n            <p class=\"text-[13.5px] text-[#94a3b8]\" data-kid=\"1-2-1-1\" data-name=\"header page context label\">\n                Panel de miembro\n            </p>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-2-1-2\" data-name=\"header right controls group\">\n                <div class=\"text-right\" data-kid=\"1-2-1-2-1\" data-name=\"available balance display\">\n                    <p class=\"text-[12px] text-[#94a3b8]\" data-kid=\"1-2-1-2-1-1\" data-name=\"balance label text\">\n                        Saldo disponible\n                    </p>\n                    <p class=\"text-[15px] font-bold text-[#d4af37] leading-tight\" data-kid=\"1-2-1-2-1-2\" data-name=\"balance amount value\">\n                        $185.000\n                    </p>\n                </div>\n                <span class=\"h-8 w-px bg-[#d4af37]/25\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider separator\">\n                </span>\n                <button aria-label=\"Cambiar tema\" class=\"w-9 h-9 rounded-lg border border-[#d4af37]/30 text-[#94a3b8] grid place-items-center hover:text-[#d4af37]\" data-kid=\"1-2-1-2-3\" data-name=\"theme toggle button\" type=\"button\">\n                    <i class=\"ti ti-sun text-[17px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"sun theme icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <main class=\"px-9 py-8 max-w-[1080px] mx-auto flex flex-col gap-8\" data-kid=\"1-2-2\" data-name=\"main wallet section\">\n            <div class=\"flex items-end justify-between gap-6 flex-wrap\" data-kid=\"1-2-2-1\" data-name=\"section heading and actions row\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"section title block\">\n                    <h1 class=\"font-cinzel text-[28px] font-bold leading-tight\" data-kid=\"1-2-2-1-1-1\" data-name=\"section headline Mi billetera\">\n                        Mi billetera\n                    </h1>\n                    <p class=\"mt-1.5 text-[14.5px] text-[#94a3b8]\" data-kid=\"1-2-2-1-1-2\" data-name=\"section description text\">\n                        Tu saldo y todos los movimientos enviados y recibidos, con el estado de cada comprobante.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2\" data-name=\"section action buttons group\">\n                    <button class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#d4af37]/50 text-[#d4af37] text-[13.5px] font-semibold hover:bg-[#d4af37]/10\" data-kid=\"1-2-2-1-2-1\" data-name=\"secondary upload receipt button\" type=\"button\">\n                        <i class=\"ti ti-upload text-[16px]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"upload icon\">\n                        </i>\n                        Subir comprobante\n                    </button>\n                    <button class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#d4af37] text-[#0a0e17] text-[13.5px] font-bold hover:bg-[#e0bd4e]\" data-kid=\"1-2-2-1-2-2\" data-name=\"primary request withdrawal button\" type=\"button\">\n                        <i class=\"ti ti-cash-banknote text-[16px]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"cash banknote icon\">\n                        </i>\n                        Solicitar retiro\n                    </button>\n                </div>\n            </div>\n            <!-- Franja de saldos -->\n            <section aria-label=\"Saldos\" class=\"rounded-xl border border-[#d4af37]/30 bg-[#12192b]/75 grid grid-cols-3 divide-x divide-[#d4af37]/20\" data-kid=\"1-2-2-2\" data-name=\"balances summary strip\">\n                <div class=\"px-6 py-5\" data-kid=\"1-2-2-2-1\" data-name=\"available to withdraw balance card\">\n                    <p class=\"text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-2-1-1\" data-name=\"available balance label\">\n                        Saldo disponible para retiro\n                    </p>\n                    <p class=\"mt-1 text-[28px] font-bold text-[#10b981] leading-none\" data-kid=\"1-2-2-2-1-2\" data-name=\"available balance amount\">\n                        $185.000\n                    </p>\n                    <p class=\"mt-2 text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-2-1-3\" data-name=\"available balance hint text\">\n                        Lo que puedes retirar hoy.\n                    </p>\n                </div>\n                <div class=\"px-6 py-5\" data-kid=\"1-2-2-2-2\" data-name=\"pending/committed balance card\">\n                    <p class=\"text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-2-2-1\" data-name=\"pending balance label\">\n                        Comprometido / retenido\n                    </p>\n                    <p class=\"mt-1 text-[28px] font-bold text-[#eab308] leading-none\" data-kid=\"1-2-2-2-2-2\" data-name=\"pending balance amount\">\n                        $70.000\n                    </p>\n                    <p class=\"mt-2 text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-2-2-3\" data-name=\"pending balance hint text\">\n                        2 movimientos pendientes de verificar.\n                    </p>\n                </div>\n                <div class=\"px-6 py-5\" data-kid=\"1-2-2-2-3\" data-name=\"total accumulated earnings card\">\n                    <p class=\"text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-2-3-1\" data-name=\"total earnings label\">\n                        Total ganado acumulado\n                    </p>\n                    <p class=\"mt-1 text-[28px] font-bold text-[#d4af37] leading-none\" data-kid=\"1-2-2-2-3-2\" data-name=\"total earnings amount\">\n                        $420.000\n                    </p>\n                    <p class=\"mt-2 text-[12.5px] text-[#94a3b8]\" data-kid=\"1-2-2-2-3-3\" data-name=\"total earnings hint text\">\n                        Incluye $100.000 ya pagados.\n                    </p>\n                </div>\n            </section>\n            <p class=\"-mt-4 text-[13px] text-[#94a3b8]\" data-kid=\"1-2-2-3\" data-name=\"withdrawal destination info line\">\n                Destino de retiros:\n                <strong class=\"text-white\" data-kid=\"1-2-2-3-1\" data-name=\"withdrawal destination channel name\">\n                    Nequi\n                </strong>\n                <span class=\"font-mono px-1.5 py-0.5 rounded bg-[#d4af37]/15 text-[#d4af37]\" data-kid=\"1-2-2-3-2\" data-name=\"withdrawal account number badge\">\n                    300 123 4567\n                </span>\n                · Retiros disponibles desde el Nivel 5 · Oro.\n                <a class=\"underline text-[#cbd5e1]\" data-kid=\"1-2-2-3-3\" data-name=\"change profile link\" href=\"#\">\n                    Cambiar en Mi perfil\n                </a>\n            </p>\n            <!-- Libro de movimientos -->\n            <section aria-labelledby=\"mov-title\" data-kid=\"1-2-2-4\" data-name=\"movements table section\">\n                <div class=\"flex items-end justify-between gap-4 mb-3\" data-kid=\"1-2-2-4-1\" data-name=\"movements heading and filter tabs row\