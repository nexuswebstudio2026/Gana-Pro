      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Montserrat:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.font-cinzel{font-family:'Cinzel',serif}\n.font-mont{font-family:'Montserrat',sans-serif}\n</style>\n<div class=\"font-mont bg-[#020712]/90 text-[#f8fafc] min-h-[860px] p-8 flex items-start justify-center\" data-kid=\"1\" data-name=\"modal overlay backdrop\">\n    <div aria-labelledby=\"send-title\" class=\"w-[520px] rounded-2xl border border-[#d4af37]/35 bg-[#0f172a] shadow-2xl\" data-kid=\"1-1\" data-name=\"send money dialog card\" role=\"dialog\">\n        <div class=\"flex items-start justify-between px-7 pt-6 pb-4\" data-kid=\"1-1-1\" data-name=\"dialog header row\">\n            <div data-kid=\"1-1-1-1\" data-name=\"dialog header content container\">\n                <h2 class=\"font-cinzel text-[20px] font-bold\" data-kid=\"1-1-1-1-1\" data-name=\"dialog recipient title\" id=\"send-title\">\n                    Enviar dinero a carolina_ruiz\n                </h2>\n                <p class=\"mt-1 text-[13.5px] text-[#94a3b8]\" data-kid=\"1-1-1-1-2\" data-name=\"dialog payment instructions text\">\n                    El pago se hace por fuera (Nequi, Daviplata, Bre-B). Aquí registras el concepto y subes el comprobante.\n                </p>\n            </div>\n            <button aria-label=\"Cerrar\" class=\"w-9 h-9 -mr-2 rounded-lg grid place-items-center text-[#94a3b8] hover:text-[#d4af37]\" data-kid=\"1-1-1-2\" data-name=\"close dialog button\" type=\"button\">\n                <i class=\"ti ti-x text-[20px]\" data-kid=\"1-1-1-2-1\" data-name=\"cross close icon\">\n                </i>\n            </button>\n        </div>\n    </div>\n</div>\n",
