# Correo SMTP de Gmail para códigos de recuperación de contraseña.
SMTP_USER=cuenta@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=cuenta@gmail.com

# Se requiere también SESSION_SECRET y las variables de Google Sheets del proyecto.

# ─── GitHub API ───────────────────────────────────────────────────────────────
# Token para leer la API de GitHub sin el límite de 60 req/hora (repositorio público).
# Genera uno en: https://github.com/settings/tokens/new  (sin permisos adicionales).
GITHUB_TOKEN=
